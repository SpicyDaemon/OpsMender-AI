                  <div class="urlbar urlbar-top"><span class="urlpill"><span class="url-text">ops.example.com</span></span></div>
                  <img class="sc-page" src={shot('phone-a-incident.png')} alt="" width="1179" height="1977" loading="eager" decoding="async" />
