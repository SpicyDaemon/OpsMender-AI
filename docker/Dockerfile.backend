# AI Incident Manager — Backend
# Multi-stage build: builder installs deps with uv, final image is slim.

# ── Stage 1: builder ────────────────────────────────────────────────────────
FROM python:3.12-slim AS builder

WORKDIR /app

# Install uv
COPY --from=ghcr.io/astral-sh/uv:0.6 /uv /uvx /usr/local/bin/

# Copy dependency manifests first for layer caching
COPY pyproject.toml uv.lock ./

# Install production deps into /app/.venv
RUN uv sync --frozen --no-dev --no-install-project

# ── Stage 2: runtime ────────────────────────────────────────────────────────
FROM python:3.12-slim AS runtime

WORKDIR /app

# Copy venv and source from builder
COPY --from=builder /app/.venv /app/.venv
COPY backend/ ./backend/
COPY cli/ ./cli/
COPY config.yaml ./config.yaml
COPY alembic.ini ./alembic.ini

# Activate venv
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8000

# Run Alembic migrations then start Uvicorn
CMD ["sh", "-c", \
  "python -m alembic upgrade head && \
   uvicorn backend.api.app:create_app --factory --host 0.0.0.0 --port 8000"]
