    <!-- UNDER THE HOOD -->
    <section id="map" class="mx-auto max-w-7xl scroll-mt-28 px-5 pt-32 sm:px-8 sm:pt-44">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="rise">
          <p class="label">Under the hood</p>
          <h2 class="headline mt-5 max-w-2xl text-4xl text-slate-50 sm:text-5xl">The whole system on one map.</h2>
          <p class="mt-5 max-w-2xl text-ops-subtle"><span class="hidden sm:inline">Alerts come in on the top row. The agent and its tools sit in the middle. Everything it does is recorded at the bottom. Click any component to open its dossier.</span><span class="sm:hidden">Alerts come in at the top, the agent and its tools sit in the middle, and everything is recorded at the end. Tap any component to open its dossier.</span></p>
        </div>
        <p class="hidden font-mono text-[11px] text-ops-muted lg:block">click · explore &nbsp; ← → · move &nbsp; esc · close</p>
