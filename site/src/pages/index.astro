            <h4 class="mt-7 text-[11px] font-semibold uppercase tracking-[0.16em] text-ops-muted">In the code</h4>
            <p id="d-code" class="mt-2 font-mono text-xs leading-relaxed text-ops-subtle"></p>
            <h4 class="mt-7 text-[11px] font-semibold uppercase tracking-[0.16em] text-ops-muted">Connected to</h4>
            <div id="d-links" class="mt-3 flex flex-wrap gap-2"></div>
