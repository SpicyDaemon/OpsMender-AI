---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const GITHUB_URL = 'https://github.com/SpicyDaemon/OpsMender-AI';
const DOCS_URL   = `${GITHUB_URL}#readme`;

const features = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"/></svg>`,
    title: 'Incident lifecycle tracking',
    desc:  'Create, acknowledge, escalate, and resolve incidents. Full timeline and responder history on every event.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M3 4.5h14.25M3 9h9.75M3 13.5h5.25m5.25-.75 4.5 4.5m0 0-4.5 4.5m4.5-4.5H11.25"/></svg>`,
    title: 'Escalation chains and rosters',
    desc:  'Define multi-level on-call escalation chains, roster rotations, and coverage windows with an at-a-glance calendar.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"/></svg>`,
    title: 'Maintenance windows with approval',
    desc:  'Request, approve, and schedule maintenance windows. Operators propose; admins approve. Matching alerts are suppressed.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0"/></svg>`,
    title: 'Notification channels',
    desc:  'Workspace-wide and team-scoped channels. Slack, Teams, Discord, Email, SMS, and more. Authenticated incident links in every post.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z"/></svg>`,
    title: 'AI-assisted incident sessions',
    desc:  'Start an AI session from any incident. The agent observes, diagnoses, plans, and acts within your configured safety tier.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>`,
    title: 'MCP Skills and safety gates',
    desc:  'Structured skill policies classify every MCP tool call. The backend tier gate enforces what can actually run — not model reasoning.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z"/></svg>`,
    title: 'Reliability checks',
    desc:  'HTTP/HTTPS uptime monitoring with SLA and SLO tracking. Configurable targets, uptime history, and status display.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/></svg>`,
    title: 'Postmortem draft, save, and download',
    desc:  'Generate a structured postmortem draft from incident details and session data. Edit, save, and download as Markdown.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z"/></svg>`,
    title: 'Admin, Operator, and Viewer roles',
    desc:  'RBAC built in. Admins manage configuration; Operators run sessions and respond; Viewers see dashboards without write access.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><path stroke-linecap="round" stroke-linejoin="round" d="M17.5 14v3m0 3v.01M14 17.5h3m3 0h.01"/></svg>`,
    title: 'Self-hosted Docker deployment',
    desc:  'One compose file gets you running. Backend + frontend in a single container; Postgres bundled. Production mode enforces strong secrets.',
  },
];

const screenshots = [
  { file: 'incidents.svg',           caption: 'Incident command center',          alt: 'Incident list with status and responder columns' },
  { file: 'session-chat.svg',        caption: 'AI session chat',                  alt: 'AI-assisted incident session with workflow state pipeline' },
  { file: 'mcp-skills.svg',          caption: 'MCP Skills and safety policies',   alt: 'MCP Skills editor with tier classification' },
  { file: 'reliability.svg',         caption: 'Reliability checks',               alt: 'HTTP uptime monitoring and SLA status' },
  { file: 'maintenance-windows.svg', caption: 'Maintenance windows and approvals', alt: 'Maintenance window list with approval workflow' },
];

const tiers = [
  {
    num:   0,
    name:  'Autonomous',
    color: 'border-red-500/40 bg-red-500/5',
    badge: 'bg-red-500/15 text-red-400 border-red-500/30',
    desc:  'The agent may execute remediation automatically — restarts, rollbacks, failovers — within skill policy, deny lists, and the reversible-ops floor. Sandbox and non-prod only. Hard time limits enforced.',
    tag:   'Non-prod / sandbox only',
    tagCls: 'text-red-400',
    allowed:    ['Safe + caution operations (autonomous)', 'Reversible remediation within skill policy', 'Rollbacks via compensating inverses'],
    blocked:    ['Deny-listed or unknown tools', 'Irreversible ops beyond the safety floor', 'Generic command-execution tools (shell, kubectl, etc.)'],
  },
  {
    num:   1,
    name:  'Approval Required',
    color: 'border-amber-500/40 bg-amber-500/5',
    badge: 'bg-amber-500/15 text-amber-400 border-amber-500/30',
    desc:  'The agent investigates and proposes. Safe actions run immediately. Destructive and generic-command actions pause for explicit operator approval. Deny-listed actions are always blocked.',
    tag:   'Recommended for high-stakes environments',
    tagCls: 'text-amber-400',
    allowed:    ['Safe operations (autonomous)', 'Destructive + generic actions (after approval)', 'Full investigation and planning'],
    blocked:    ['Deny-listed or unknown actions', 'Anything without an approval decision'],
  },
  {
    num:   2,
    name:  'Advisory Only',
    color: 'border-blue-500/40 bg-blue-500/5',
    badge: 'bg-blue-500/15 text-blue-400 border-blue-500/30',
    desc:  'The agent provides analysis, runbooks, and recommendations. Read-only observation runs before the gate. No write or remediation actions execute. The human performs every action manually.',
    tag:   'Default for new installs',
    tagCls: 'text-blue-400',
    allowed:    ['Read-only observation', 'Diagnosis, planning, and recommendations', 'Postmortem generation'],
    blocked:    ['Any write or remediation action', 'All tool execution beyond reads'],
  },
];

const v1Features = [
  'Incidents — full lifecycle',
  'Teams, rosters, escalation chains',
  'Escalation chain calendar',
  'Maintenance windows with approval',
  'Notification channels (Slack, Teams, Email, SMS, …)',
  'AI-assisted incident sessions',
  'MCP Skills with backend enforcement',
  'AI Autonomy Tiers (0 / 1 / 2)',
  'Reliability HTTP/HTTPS checks',
  'Postmortem draft, save, download',
  'Admin / Operator / Viewer RBAC',
  'Self-hosted Docker deployment',
];

const v11Features = [
  'MCP Skill Generator — inspect discovered MCP tools, classify per tier, generate a saveable skill draft',
  'MCP Skill Studio improvements — easier authoring, better templates',
  'Richer notification integrations — interactive actions with verified callbacks',
];
---

<Layout>
  <!-- ═══════════════════════════════════════════════ NAV -->
  <nav class="sticky top-0 z-50 border-b border-white/5 bg-ops-bg/90 backdrop-blur-md">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2.5">
        <span class="text-lg font-bold tracking-tight text-slate-50">Ops<span class="text-ops-blue">Mender</span></span>
        <span class="hidden rounded-full border border-ops-border bg-ops-surface px-2 py-0.5 font-mono text-[10px] text-ops-subtle sm:inline">self-hosted</span>
      </div>
      <div class="flex items-center gap-3">
        <a href="#features"  class="hidden text-sm text-ops-subtle hover:text-slate-200 transition-colors sm:inline">Features</a>
        <a href="#ai-tiers"  class="hidden text-sm text-ops-subtle hover:text-slate-200 transition-colors sm:inline">AI Tiers</a>
        <a href="#deploy"    class="hidden text-sm text-ops-subtle hover:text-slate-200 transition-colors sm:inline">Deploy</a>
        <a href="#roadmap"   class="hidden text-sm text-ops-subtle hover:text-slate-200 transition-colors sm:inline">Roadmap</a>
        <a
          href={GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 rounded-md border border-ops-border bg-ops-surface px-3 py-1.5 text-sm font-medium text-slate-200 transition-colors hover:border-ops-blue/50 hover:bg-ops-card hover:text-white"
        >
          <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" class="shrink-0"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"/></svg>
          GitHub
        </a>
      </div>
    </div>
  </nav>

  <!-- ═══════════════════════════════════════════════ HERO -->
  <section class="relative overflow-hidden bg-hero-gradient pb-24 pt-20 sm:pb-32 sm:pt-28">
    <!-- Decorative orbs -->
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute left-1/2 top-0 -translate-x-1/2 h-[600px] w-[900px] rounded-full bg-ops-blue/10 blur-[120px] opacity-40"></div>
      <div class="absolute right-0 top-1/3 h-[400px] w-[500px] rounded-full bg-ops-indigo/8 blur-[100px] opacity-30"></div>
    </div>

    <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-ops-blue/25 bg-ops-blue/8 px-3.5 py-1.5">
        <span class="h-1.5 w-1.5 rounded-full bg-ops-cyan animate-pulse"></span>
        <span class="text-xs font-medium text-ops-cyan">Open source · Self-hosted · AI-assisted</span>
      </div>

      <h1 class="mb-6 text-4xl font-extrabold leading-tight tracking-tight text-slate-50 sm:text-5xl lg:text-6xl">
        Self-hosted incident response<br class="hidden sm:block" />
        <span class="bg-gradient-to-r from-ops-blue to-ops-cyan bg-clip-text text-transparent">for modern engineering teams</span>
      </h1>

      <p class="mx-auto mb-10 max-w-2xl text-base leading-relaxed text-ops-subtle sm:text-lg">
        OpsMender helps teams manage incidents, escalation chains, maintenance windows,
        AI-assisted sessions, MCP Skills, and reliability checks — from one
        self-hosted platform.
      </p>

      <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href={GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg bg-ops-blue px-6 py-3 text-sm font-semibold text-white shadow-glow-blue transition-all hover:bg-blue-400 hover:shadow-glow-blue hover:scale-[1.02] active:scale-[0.99]"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"/></svg>
          View on GitHub
        </a>
        <a
          href={DOCS_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg border border-ops-border bg-ops-surface px-6 py-3 text-sm font-semibold text-slate-300 transition-all hover:border-ops-blue/40 hover:bg-ops-card hover:text-white"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"/></svg>
          Read the docs
        </a>
      </div>

      <!-- Stats strip -->
      <div class="mt-16 flex flex-wrap items-center justify-center gap-x-8 gap-y-4 border-t border-white/5 pt-10 text-sm text-ops-muted">
        <span class="flex items-center gap-1.5"><span class="font-semibold text-slate-300">v1.0</span> generally available</span>
        <span class="h-3 w-px bg-ops-border hidden sm:block"></span>
        <span class="flex items-center gap-1.5"><span class="font-semibold text-slate-300">1 600+</span> tests</span>
        <span class="h-3 w-px bg-ops-border hidden sm:block"></span>
        <span class="flex items-center gap-1.5"><span class="font-semibold text-slate-300">MIT</span> licensed</span>
        <span class="h-3 w-px bg-ops-border hidden sm:block"></span>
        <span class="flex items-center gap-1.5"><span class="font-semibold text-slate-300">Docker</span> one-command deploy</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════ SCREENSHOTS -->
  <section id="screenshots" class="py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 text-center">
        <h2 class="text-2xl font-bold text-slate-50 sm:text-3xl">Everything in one place</h2>
        <p class="mt-3 text-ops-subtle">From incident intake to AI session to postmortem — a complete operations surface.</p>
      </div>

      <!-- Screenshot gallery: horizontal scroll on small, 3-col grid on large -->
      <div class="flex gap-4 overflow-x-auto pb-4 lg:grid lg:grid-cols-3 lg:overflow-visible lg:pb-0">
        {screenshots.map((s, i) => (
          <div class="group flex-shrink-0 w-[80vw] sm:w-[60vw] lg:w-auto">
            <div class="relative overflow-hidden rounded-xl border border-ops-border bg-ops-card shadow-card transition-all duration-300 group-hover:border-ops-blue/30 group-hover:shadow-glow-sm">
              <!-- Frame chrome -->
              <div class="flex items-center gap-1.5 border-b border-ops-border bg-ops-surface px-3 py-2">
                <span class="h-2.5 w-2.5 rounded-full bg-red-500/60"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-amber-400/60"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-green-500/60"></span>
                <span class="ml-2 flex-1 rounded bg-ops-border px-2 py-0.5 text-center font-mono text-[10px] text-ops-muted">opsmender</span>
              </div>
              <div class="aspect-[16/10] w-full overflow-hidden">
                <img
                  src={`${base}/screenshots/${s.file}`}
                  alt={s.alt}
                  class="h-full w-full object-cover object-top"
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              </div>
            </div>
            <p class="mt-3 text-center text-sm font-medium text-ops-subtle">{s.caption}</p>
          </div>
        ))}
        <!-- Wide screenshot that spans full row on large -->
        <div class="hidden lg:block lg:col-span-3">
          <!-- intentional gap for overflow balance -->
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════ FEATURES -->
  <section id="features" class="border-t border-ops-border py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-14 text-center">
        <span class="mb-3 inline-block rounded-full border border-ops-border bg-ops-surface px-3 py-1 text-xs font-medium text-ops-cyan">Core platform</span>
        <h2 class="text-2xl font-bold text-slate-50 sm:text-3xl">Every layer of the on-call stack</h2>
        <p class="mt-3 text-ops-subtle">From alert intake to postmortem — without SaaS lock-in or black-box AI.</p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {features.map((f) => (
          <div class="group rounded-xl border border-ops-border bg-card-shine bg-ops-card p-5 shadow-card transition-all hover:border-ops-blue/30 hover:bg-ops-card hover:shadow-glow-sm">
            <div class="mb-3 inline-flex h-9 w-9 items-center justify-center rounded-lg border border-ops-border bg-ops-surface text-ops-blue transition-colors group-hover:border-ops-blue/40 group-hover:bg-ops-blue/10">
              <Fragment set:html={f.icon} />
            </div>
            <h3 class="mb-1.5 text-sm font-semibold text-slate-100">{f.title}</h3>
            <p class="text-xs leading-relaxed text-ops-subtle">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════ AI TIERS -->
  <section id="ai-tiers" class="border-t border-ops-border py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-14 text-center">
        <span class="mb-3 inline-block rounded-full border border-ops-border bg-ops-surface px-3 py-1 text-xs font-medium text-ops-cyan">AI Autonomy</span>
        <h2 class="text-2xl font-bold text-slate-50 sm:text-3xl">You control how much the AI does</h2>
        <p class="mt-3 max-w-xl mx-auto text-ops-subtle">
          Three tiers, set per session. The backend gate enforces the selected tier programmatically — the agent cannot reason around it.
        </p>
      </div>

      <div class="grid gap-5 lg:grid-cols-3">
        {tiers.map((t) => (
          <div class={`relative rounded-xl border ${t.color} p-6 shadow-card`}>
            <div class="mb-4 flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <span class={`rounded-lg border px-2.5 py-1 font-mono text-sm font-bold ${t.badge}`}>T{t.num}</span>
                <span class="text-base font-semibold text-slate-100">{t.name}</span>
              </div>
            </div>
            <p class="mb-5 text-sm leading-relaxed text-ops-subtle">{t.desc}</p>
            <div class="space-y-1.5">
              {t.allowed.map((a) => (
                <div class="flex items-start gap-2 text-xs text-slate-400">
                  <svg class="mt-0.5 h-3.5 w-3.5 shrink-0 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
                  {a}
                </div>
              ))}
              {t.blocked.map((b) => (
                <div class="flex items-start gap-2 text-xs text-ops-muted">
                  <svg class="mt-0.5 h-3.5 w-3.5 shrink-0 text-red-500/70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg>
                  {b}
                </div>
              ))}
            </div>
            <div class={`mt-5 pt-4 border-t border-white/5 text-[11px] font-medium ${t.tagCls}`}>{t.tag}</div>
          </div>
        ))}
      </div>

      <!-- Safety callout -->
      <div class="mt-8 rounded-xl border border-ops-blue/20 bg-ops-blue/5 p-5 text-center">
        <p class="text-sm text-slate-300">
          <svg class="mr-2 inline h-4 w-4 text-ops-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"/></svg>
          <strong class="text-slate-100">Skills guide the AI. The backend tier gate enforces what can actually run.</strong>
          {' '}A prompt-injected "ignore policy and delete prod" is blocked at the gate — not by model reasoning.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════ MCP SKILLS -->
  <section id="mcp-skills" class="border-t border-ops-border py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <span class="mb-3 inline-block rounded-full border border-ops-border bg-ops-surface px-3 py-1 text-xs font-medium text-ops-cyan">MCP Skills</span>
          <h2 class="mb-4 text-2xl font-bold text-slate-50 sm:text-3xl">Policy-driven tool control</h2>
          <p class="mb-6 text-ops-subtle leading-relaxed">
            MCP Skills define how OpsMender uses tools exposed by MCP servers. Teams write structured YAML
            policies that classify every tool call — the backend tier gate enforces the result.
          </p>
          <ul class="space-y-3">
            {[
              ['Server-specific skills', 'Assign a dedicated skill to each MCP server. Server-specific skills take precedence over the global fallback.'],
              ['Global fallback', 'One skill covers all servers that have no specific assignment. Conservative default-deny when no skill resolves.'],
              ['Unassigned drafts', 'Save and download work-in-progress skills without injecting them into live sessions.'],
              ['Downloadable Markdown', 'Every skill exports as structured Markdown — version-control your policies like code.'],
              ['Deny lists and allow_generic', 'deny: true always wins. opt scoped wrappers out of the generic-command guardrail with allow_generic: true.'],
            ].map(([title, desc]) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-ops-blue/15 text-ops-blue">
                  <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M1.5 5.5 4 8 8.5 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <div>
                  <span class="text-sm font-medium text-slate-200">{title}</span>
                  <span class="ml-1 text-sm text-ops-subtle"> — {desc}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <!-- YAML code block -->
        <div class="rounded-xl border border-ops-border bg-ops-surface shadow-card overflow-hidden">
          <div class="flex items-center justify-between border-b border-ops-border px-4 py-2.5">
            <span class="font-mono text-xs text-ops-subtle">SKILL.k8s-production.md</span>
            <span class="rounded border border-ops-border px-1.5 py-0.5 font-mono text-[9px] text-ops-muted">yaml front-matter</span>
          </div>
          <pre class="overflow-x-auto p-5 text-xs leading-relaxed"><code class="text-slate-300">{`---
version: "1"
environment: kubernetes-production
operations:
  # ── Safe (read-only) ──────────────────────────
  - tool: get_pods
    classification: safe
  - tool: get_pod_logs
    classification: safe
  - tool: describe_*
    classification: safe

  # ── Caution (reversible writes) ───────────────
  - tool: scale_deployment
    classification: caution
    reversible: true
  - tool: cordon_node
    classification: caution
    reversible: true
    compensating_inverse: uncordon_node

  # ── Destructive (approval required at Tier 1) ─
  - tool: delete_pod
    classification: destructive
  - tool: delete_namespace
    classification: destructive

  # ── Always blocked ────────────────────────────
  - tool: shell
    deny: true
  - tool: exec_*
    deny: true
---`}</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════ DEPLOY -->
  <section id="deploy" class="border-t border-ops-border py-20 sm:py-28">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <span class="mb-3 inline-block rounded-full border border-ops-border bg-ops-surface px-3 py-1 text-xs font-medium text-ops-cyan">Self-hosted</span>
      <h2 class="mb-4 text-2xl font-bold text-slate-50 sm:text-3xl">Up in minutes, not days</h2>
      <p class="mb-10 text-ops-subtle">
        One compose file. Backend + frontend in a single container. Postgres bundled.
        Production mode enforces strong secrets at startup.
      </p>

      <div class="overflow-hidden rounded-xl border border-ops-border bg-ops-surface shadow-card text-left">
        <div class="flex items-center gap-2 border-b border-ops-border px-4 py-2.5">
          <span class="h-2.5 w-2.5 rounded-full bg-red-500/60"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-amber-400/60"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-green-500/60"></span>
          <span class="ml-2 font-mono text-xs text-ops-muted">Terminal</span>
        </div>
        <pre class="overflow-x-auto p-6 font-mono text-sm leading-8"><code><span class="text-ops-muted"># 1. Clone the repo</span>
<span class="text-ops-cyan">$</span><span class="text-slate-200"> git clone https://github.com/SpicyDaemon/OpsMender-AI</span>
<span class="text-ops-cyan">$</span><span class="text-slate-200"> cd OpsMender-AI</span>

<span class="text-ops-muted"># 2. Copy and edit the example config</span>
<span class="text-ops-cyan">$</span><span class="text-slate-200"> cp .env.example .env</span>
<span class="text-ops-muted">#    Set OPSMENDER_MODEL_PROVIDER + API key, then:</span>

<span class="text-ops-muted"># 3. Start</span>
<span class="text-ops-cyan">$</span><span class="text-slate-200"> docker compose -f docker/docker-compose.yml up</span>

<span class="text-ops-muted"># Open http://localhost:8000  (dev login: admin / admin123)</span></code></pre>
      </div>

      <p class="mt-6 text-sm text-ops-muted">
        Production mode requires a strong JWT secret and bootstrap admin credentials — weak defaults are rejected at startup.
        <a href={DOCS_URL} class="ml-1 text-ops-blue hover:underline" target="_blank" rel="noopener noreferrer">Full setup docs →</a>
      </p>
    </div>
  </section>

