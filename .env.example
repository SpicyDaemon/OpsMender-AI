# ============================================================
# OpsMender AI — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Never commit .env to git
# ============================================================


# ------------------------------------------------------------
# ACTIVE MODEL CONFIG
# ------------------------------------------------------------
# Which provider to use: anthropic | openai | azure_openai | ollama
OPSMENDER_MODEL_PROVIDER=ollama

# Model ID to use (must match the provider)
#   anthropic     → claude-sonnet-4-20250514, claude-haiku-4-5-20251001
#   openai        → gpt-4o, gpt-4o-mini
#   azure_openai  → your deployment name
#   ollama        → llama3.2, mistral, codellama, phi3, gemma3
OPSMENDER_MODEL_ID=llama3.2


# ------------------------------------------------------------
# OLLAMA (LOCAL MODELS)
# ------------------------------------------------------------
# Use host.docker.internal when running inside Docker Desktop on Windows
# Use localhost when running outside Docker
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Model must be pulled first on your Windows host:
#   ollama pull llama3.2
#   ollama pull mistral
#   ollama pull codellama
OLLAMA_MODEL=llama3.2


# ------------------------------------------------------------
# ANTHROPIC
# ------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_key_here


# ------------------------------------------------------------
# OPENAI
# ------------------------------------------------------------
OPENAI_API_KEY=your_openai_key_here


# ------------------------------------------------------------
# AZURE OPENAI
# ------------------------------------------------------------
AZURE_OPENAI_API_KEY=your_azure_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT=your_deployment_name


# ------------------------------------------------------------
# OpsMender GENERAL CONFIG
# ------------------------------------------------------------
# Active tier: 0 | 1 | 2 | 3
# Use 2 during development (safe ops only, nothing destructive)
OPSMENDER_TIER=2

# Log level: DEBUG | INFO | WARNING | ERROR
OPSMENDER_LOG_LEVEL=INFO

# Approval timeout in seconds for Tier 1 requests
OPSMENDER_APPROVAL_TIMEOUT_SECONDS=900

# Tier 0 sandbox hard time limits (Sprint 17). Only apply when tier==0.
# Session-level wall clock (asyncio.wait_for around graph.ainvoke).
OPSMENDER_TIER0_MAX_SESSION_SECONDS=600
# Per-node wall clock. On timeout the node returns status='timed_out'.
OPSMENDER_TIER0_MAX_NODE_SECONDS=120

# Path to skill definition file
OPSMENDER_SKILL_DEFINITION=./examples/SKILL.md

# Path to audit log output
OPSMENDER_AUDIT_LOG=./logs/audit.jsonl

# Path to the Next.js static export (served by the backend). Leave as the
# default when using the Docker image or `opsmender` binary; unset or point to a
# non-existent dir during local `next dev` usage.
OPSMENDER_FRONTEND_STATIC_DIR=./frontend/out

# Optional temporary CLI-only MCP server config until Sprint 12 UI/DB manager lands
# Example:
# OPSMENDER_MCP_SERVERS_JSON=[{"name":"k8s","transport":"stdio","command":"npx","args":["-y","@anthropic/mcp-server-k8s"]}]
OPSMENDER_MCP_SERVERS_JSON=[]

# Optional: override the directory containing the node/npx/npm binaries.
# Docker image bundles Node automatically — this is only needed for local or
# binary installs where Node is in a non-standard location.
# OPSMENDER_NODE_PATH=/usr/local/bin


# ------------------------------------------------------------
# DATABASE (Phase 2 — API server)
# ------------------------------------------------------------
# PostgreSQL connection string (async driver)
OPSMENDER_DATABASE_URL=postgresql+asyncpg://opsmender:opsmender@localhost:5432/opsmender

# Optional overrides for local fallback order when OPSMENDER_DATABASE_URL is unset
OPSMENDER_LOCAL_POSTGRES_URL=postgresql+asyncpg://opsmender:opsmender@localhost:5432/opsmender
OPSMENDER_SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./opsmender-local.db


# ------------------------------------------------------------
# SAML SSO (Sprint 30 — per-tenant SAML 2.0 SP)
# ------------------------------------------------------------
# Global SP signing keypair used to sign AuthnRequests and (eventually) decrypt
# encrypted assertions. Generate with:
#   opsmender saml gen-sp-keys
# This writes a self-signed cert + key to stdout in PEM. Copy them into your
# secret store and supply them here as PEM strings (newlines escaped as \n is
# OK; raw newlines also work in .env files when wrapped in quotes).
#
# OpsMender does NOT enable SAML for any tenant unless both vars are set.
OPSMENDER_SAML_SP_CERT=
OPSMENDER_SAML_SP_KEY=

# Optional override for the SP entityId. Defaults to "<scheme>://<host>/auth/saml/metadata"
# at request time, which is what most IdP setup wizards expect. Override only
# if you need a stable cross-host entityId (e.g. multi-host deployments where
# the IdP's SP metadata is pre-registered).
# OPSMENDER_SAML_SP_ENTITY_ID=https://opsmender.example.com/saml


# ------------------------------------------------------------
# BOT CONNECTOR OAUTH (Sprint 31 — Slack / Discord install flow)
# ------------------------------------------------------------
# Optional. When set, the Bot Connectors modal shows a "Connect to <Platform>"
# button that walks the operator through the provider's OAuth consent screen
# and writes the bot token into the connector automatically.
#
# Register this redirect URI in your Slack / Discord app config:
#   <public_url>/bot-connectors/oauth/<platform>/callback
#
# OAuth populates the bot token only. Signing secrets (Slack signing_secret,
# Discord public_key, etc.) are per-app constants the provider does not
# return through OAuth — operators must still paste those manually in the
# typed form before webhook signature verification will succeed.
#
# Leaving these unset disables the button per platform; operators fall back
# to pasting the bot token directly.
OPSMENDER_SLACK_OAUTH_CLIENT_ID=
OPSMENDER_SLACK_OAUTH_CLIENT_SECRET=
OPSMENDER_DISCORD_OAUTH_CLIENT_ID=
OPSMENDER_DISCORD_OAUTH_CLIENT_SECRET=


# ------------------------------------------------------------
# JWT AUTH (Phase 2 — API server)
# ------------------------------------------------------------
# Secret key for signing JWTs (change this in production!)
OPSMENDER_JWT_SECRET=change-me-in-production
OPSMENDER_JWT_ALGORITHM=HS256
OPSMENDER_JWT_EXPIRE_MINUTES=60


# ------------------------------------------------------------
# CORS (Phase 2 — API server)
# ------------------------------------------------------------
# Comma-separated allowed origins (* for dev)
OPSMENDER_CORS_ORIGINS=*


# ------------------------------------------------------------
# FRONTEND (Phase 2 — Next.js static export)
# ------------------------------------------------------------
# Empty string = frontend calls the backend same-origin (default for the
# single-container image and the PyInstaller binary). Only set this when the
# frontend is hosted on a different origin than the backend.
NEXT_PUBLIC_API_URL=


# ------------------------------------------------------------
# INGEST RATE LIMITING (Sprint 14)
# ------------------------------------------------------------
# Max webhook requests per window per ingest token (0 = disabled)
OPSMENDER_INGEST_RATE_LIMIT=60
# Window size in seconds
OPSMENDER_INGEST_RATE_WINDOW=60
# Optional: auto-start a session for newly created ingested incidents
OPSMENDER_INGEST_AUTO_START_ENABLED=false
# Match incidents at or above this severity: critical | high | medium | low
OPSMENDER_INGEST_AUTO_START_MIN_SEVERITY=critical
# Optional exact source filter: cloudwatch | azure_monitor | legacy_alert_vendor | legacy_alert_relay | generic
# Leave blank to match any source
OPSMENDER_INGEST_AUTO_START_SOURCE=


# ------------------------------------------------------------
# DETECTOR (Sprint 14 — MCP-driven incident detector)
# ------------------------------------------------------------
# Enable the background detector scheduler
OPSMENDER_DETECTOR_ENABLED=false
# Max runs per hour for a single detector rule (0 = disabled)
OPSMENDER_DETECTOR_MAX_RUNS_PER_HOUR=12
# Global detector run budget per rolling hour across all rules (0 = disabled)
OPSMENDER_DETECTOR_BUDGET=500

# ------------------------------------------------------------
# PAGING NOTIFICATION CHANNELS (Sprint 35)
# ------------------------------------------------------------
# Credentials below are read by build_channel_factory() and used by the
# escalation engine to deliver pages. Channels with unset credentials are
# silently skipped (an incident_pages row with delivery_status='skipped' and
# reason='channel_unconfigured' is recorded for the audit log).

# Slack DM (chat.postMessage)
# OPSMENDER_SLACK_BOT_TOKEN=xoxb-...

# Teams DM (MessageCard webhook; Microsoft Graph is Sprint 37)
# OPSMENDER_TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# Email (SMTP)
# OPSMENDER_SMTP_HOST=smtp.example.com
# OPSMENDER_SMTP_PORT=587
# OPSMENDER_SMTP_USER=opsmender
# OPSMENDER_SMTP_PASSWORD=...
# OPSMENDER_SMTP_FROM=opsmender@example.com
# OPSMENDER_SMTP_USE_TLS=true

# SMS (Twilio Messages API)
# OPSMENDER_TWILIO_ACCOUNT_SID=AC...
# OPSMENDER_TWILIO_AUTH_TOKEN=...
# OPSMENDER_TWILIO_FROM_NUMBER=+15550000000
