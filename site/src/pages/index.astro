  <script>
    // ---------- Intro: wordmark, then hand over to the page ----------
    (() => {
      const el = document.getElementById('intro');
      const html = document.documentElement;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let seen = false; try { seen = sessionStorage.getItem('om-intro') === '1'; } catch {}
      if (!el || reduce || seen) { el?.remove(); html.classList.add('ready'); return; }
      document.body.style.overflow = 'hidden';
      let done = false;
      const finish = () => {
        if (done) return; done = true;
        html.classList.add('ready');
        el.classList.remove('in'); el.classList.add('out');
        setTimeout(() => { el.classList.add('gone'); document.body.style.overflow = ''; }, 300);
        setTimeout(() => el.remove(), 1400);
        try { sessionStorage.setItem('om-intro', '1'); } catch {}
      };
      requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('in')));
      const timer = setTimeout(finish, 3300);
      const skip = () => { clearTimeout(timer); finish(); };
      for (const ev of ['pointerdown', 'keydown', 'wheel', 'touchstart']) addEventListener(ev, skip, { once: true, passive: true });
    })();

    // ---------- Nav: floating pill once you scroll; rise-ins; count-ups; copy ----------
    (() => {
      const nav = document.getElementById('nav')!;
      const update = () => nav.classList.toggle('floating', scrollY > 40);
      update(); addEventListener('scroll', update, { passive: true });

      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
      document.querySelectorAll('.rise').forEach((el) => io.observe(el));

      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const counts = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          counts.unobserve(e.target);
          const el = e.target as HTMLElement, to = Number(el.dataset.to || 0), start = performance.now(), ms = 1400;
          if (reduce) { el.textContent = to.toLocaleString('en-US'); continue; }
          const tick = (now: number) => {
            const t = Math.min(1, (now - start) / ms), eased = 1 - Math.pow(1 - t, 3);
            el.textContent = Math.round(to * eased).toLocaleString('en-US');
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }
      }, { threshold: 0.6 });
      document.querySelectorAll('.count').forEach((el) => counts.observe(el));

      // Zoom cards: push in on their own once they are in view; a click toggles.
      const zooms = Array.from(document.querySelectorAll<HTMLElement>('.zoom'));
      for (const z of zooms) z.querySelector('.zoom-toggle')?.addEventListener('click', () => z.classList.toggle('focus'));
      if (!reduce) {
        const zi = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { zi.unobserve(e.target); setTimeout(() => e.target.classList.add('focus'), 1100); }
        }, { threshold: 0.55 });
        zooms.forEach((z) => zi.observe(z));
      }

      // Tier switcher: click a tier to see its screen; it cycles on its own until someone picks.
      (() => {
        const root = document.getElementById('tier-switch'); if (!root) return;
        const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.tier-tab'));
        const shots = Array.from(root.querySelectorAll<HTMLImageElement>('.tier-shot'));
        const dots = Array.from(root.querySelectorAll<HTMLElement>('.tier-dot'));
        const caption = document.getElementById('tier-caption')!;
        const captions = tabs.map((_, i) => (['A Tier 0 session restarted the deployment, confirmed recovery, and recorded how to undo it.', 'A Tier 1 session stopped at the gate. Its request is waiting in the approval inbox.', 'A Tier 2 session read, explained, and recommended a plan. Nothing was changed.'][i]));
        let current = 0, timer = 0;
        const show = (i: number) => {
          current = i;
          tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === i)); t.classList.toggle('border-ops-blue', k === i); t.classList.toggle('bg-ops-surface', k === i); t.classList.toggle('border-ops-border', k !== i); t.classList.toggle('bg-ops-surface/50', k !== i); });
          shots.forEach((s, k) => { s.classList.toggle('opacity-100', k === i); s.classList.toggle('opacity-0', k !== i); });
          dots.forEach((d, k) => { d.classList.toggle('bg-ops-blue', k === i); d.classList.toggle('bg-ops-border', k !== i); });
          caption.textContent = captions[i];
        };
        tabs.forEach((t, i) => t.addEventListener('click', () => { clearInterval(timer); show(i); }));
        if (!reduce) {
          const io = new IntersectionObserver((entries) => {
            for (const e of entries) if (e.isIntersecting) { io.unobserve(e.target); timer = window.setInterval(() => show((current + 1) % tabs.length), 5500); }
          }, { threshold: 0.4 });
          io.observe(root);
        }
      })();

      // Phone story: a timeline of classes on the screen; the step list follows along.
      (() => {
        const stage = document.getElementById('story'); if (!stage) return;
        const steps = Array.from(document.querySelectorAll<HTMLButtonElement>('.story-step'));
        // [time ms, class, step number]
        const timeline: [number, string, number][] = [
          [200, 's0', 1], [1700, 's0-tap', 1], [2200, 's1', 1],
          [3600, 's1-tap', 2], [4100, 's1-acked', 2], [5200, 's1-open', 3],
          [5800, 's2', 3], [6900, 's2-page', 3],
          [9100, 's3', 4], [9900, 's3-ask', 4], [10700, 's3-typing', 4], [12200, 's3-reply', 4],
          [14200, 's3-tap', 4], [14700, 's3-approved', 4],
        ];
        const sceneStart = [0, 200, 3600, 5200, 9100];
        const LOOP = 17400;
        let timers: number[] = [];
        const mark = (n: number) => steps.forEach((s) => s.classList.toggle('active', Number(s.dataset.step) === n));
        const clear = () => { timers.forEach(clearTimeout); timers = []; stage.className = 'phone-screen story'; };
        const play = (from: number) => {
          clear();
          for (const [t, cls, n] of timeline) {
            if (t < from) { stage.classList.add(cls); mark(n); continue; }
            timers.push(window.setTimeout(() => { stage.classList.add(cls); mark(n); }, t - from));
          }
          timers.push(window.setTimeout(() => play(0), LOOP - from));
        };
        steps.forEach((s) => s.addEventListener('click', () => play(sceneStart[Number(s.dataset.step)])));
        if (reduce) { for (const [, cls] of timeline.slice(0, 8)) stage.classList.add(cls); mark(3); return; }
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { io.unobserve(e.target); play(0); }
        }, { threshold: 0.5 });
        io.observe(stage);
      })();

      document.getElementById('copy-cmd')?.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText('docker compose -f docker/docker-compose.yml up'); } catch {}
      });
    })();

    // ---------- Star field: fixed behind the whole page ----------
    (() => {
      const c = document.getElementById('field') as HTMLCanvasElement | null;
      if (!c) return;
      const ctx = c.getContext('2d')!;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let w = 0, h = 0, dpr = 1, raf = 0, visible = true;
      type P = { x: number; y: number; vx: number; vy: number; r: number; a: number };
      let pts: P[] = [];
      const mouse = { x: -1e4, y: -1e4 };

      function size() {
        dpr = Math.min(devicePixelRatio || 1, 2);
        w = c.clientWidth; h = c.clientHeight;
        c.width = w * dpr; c.height = h * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        const n = Math.round(Math.min(220, (w * h) / 9000));
        pts = Array.from({ length: n }, () => ({
          x: Math.random() * w, y: Math.random() * h,
          vx: (Math.random() - .5) * .12, vy: (Math.random() - .5) * .12,
          r: Math.random() * 1.3 + .3, a: Math.random() * .5 + .25,
        }));
      }
      function frame() {
        ctx.clearRect(0, 0, w, h);
        for (const p of pts) {
          if (!reduce) {
            p.x += p.vx; p.y += p.vy;
            if (p.x < -5) p.x = w + 5; else if (p.x > w + 5) p.x = -5;
            if (p.y < -5) p.y = h + 5; else if (p.y > h + 5) p.y = -5;
          }
          ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(148,163,184,${p.a})`; ctx.fill();
        }
        for (let i = 0; i < pts.length; i++) {
          const p = pts[i];
          const dm = Math.hypot(p.x - mouse.x, p.y - mouse.y);
          if (dm > 160) continue;
          for (let j = i + 1; j < pts.length; j++) {
            const q = pts[j];
            const d = Math.hypot(p.x - q.x, p.y - q.y);
            if (d < 110) {
              ctx.strokeStyle = `rgba(59,130,246,${(1 - d / 110) * .35 * (1 - dm / 160)})`;
              ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(q.x, q.y); ctx.stroke();
            }
          }
        }
        if (!reduce && visible) raf = requestAnimationFrame(frame);
      }
      size(); frame();
      addEventListener('resize', () => { size(); if (reduce) frame(); });
      document.addEventListener('mousemove', (e) => { mouse.x = e.clientX; mouse.y = e.clientY; });
      document.addEventListener('mouseleave', () => { mouse.x = mouse.y = -1e4; });
      document.addEventListener('visibilitychange', () => { visible = !document.hidden; if (visible && !reduce && !raf) raf = requestAnimationFrame(frame); if (!visible) { cancelAnimationFrame(raf); raf = 0; } });
    })();

    // ---------- Architecture map ----------
    (() => {
      const svg = document.getElementById('arch');
      if (!svg) return;
      type Node = { id: string; x: number; y: number; label: string; sub: string; kind: string; summary: string; points: string[]; code: string };
      const W = 172, H = 58;
      const KIND: Record<string, string> = {
        Intake: '#22d3ee', Core: '#60a5fa', Response: '#fbbf24', AI: '#a78bfa', Safety: '#fb7185',
        Tools: '#34d399', Access: '#94a3b8', Knowledge: '#f472b6', Record: '#818cf8',
      };
      const nodes: Node[] = [
        { id: 'alerts', x: 110, y: 90, label: 'Alert sources', sub: 'monitoring, webhooks, API', kind: 'Intake',
          summary: 'Anything that can send an HTTP request can open an incident.',
          points: ['Per service intake URLs, so an alert lands on the right team without encoding the service in the payload.', 'Provider adapters normalise payloads from cloud and monitoring tools into one shape.', 'Named, revocable API tokens for scripts and CI, scoped by role.'],
          code: 'backend/ingest/ · backend/api/routes/ingest.py' },
        { id: 'ingest', x: 330, y: 90, label: 'Ingest', sub: 'dedup, grouping, quiet hours', kind: 'Intake',
          summary: 'Decides whether an alert becomes a new incident, joins an open one, or stays quiet.',
          points: ['Fingerprint deduplication, so a re firing alert updates the incident it already opened.', 'Similar alert grouping per service folds related alerts into the open incident instead of paging again.', 'Flapping detection suppresses repeat pages during fire and clear storms. P0 always pages.', 'Maintenance windows silence matching alerts for their duration.', 'An alert whose text addresses the assistant is flagged on the incident and in the audit log.'],
          code: 'backend/ingest/service.py · backend/ingest/noise.py' },
        { id: 'incident', x: 560, y: 90, label: 'Incident', sub: 'P0 to P3, timeline, merge', kind: 'Core',
          summary: 'The record everything else hangs off.',
          points: ['Priority P0 to P3, status, owner, and a timeline of every action by people and by the agent.', 'Combine duplicates into one primary. The merged row is kept so its audit trail and fingerprint survive.', 'Comments, assignment, and a link to every session that ran on it.'],
          code: 'backend/db/models.py · backend/db/repos.py' },
        { id: 'paging', x: 790, y: 90, label: 'Paging engine', sub: 'rosters, chains, calendar', kind: 'Response',
          summary: 'Works out who is on call right now and keeps escalating until someone acknowledges.',
          points: ['Rosters with rotations, overnight windows, and one click coverage overrides.', 'Escalation chains define who is next when nobody acknowledges.', 'An acknowledgement locks the incident to that responder. If they go quiet for fifteen minutes, the chain resumes.', 'An on call calendar with time zone aware shifts.'],
          code: 'backend/paging/on_call.py' },
        { id: 'notify', x: 1030, y: 90, label: 'Notifications', sub: '20 platforms, SMS, voice', kind: 'Response',
          summary: 'Reaches people where they already are.',
          points: ['Twenty platforms including Slack, Teams, Discord, Telegram, Matrix, Google Chat, and email.', 'Slack, Teams, and Discord get buttons: acknowledge, resolve, escalate, start a session. Every press is verified and audited.', 'SMS and voice calls through Twilio. The voice menu is 1 acknowledge, 2 escalate, 3 resolve.', 'Every message carries an authenticated link back to the incident.'],
          code: 'backend/bots/ · backend/bots/capabilities.py' },
        { id: 'models', x: 110, y: 300, label: 'Models', sub: 'bring your own', kind: 'AI',
          summary: 'Eleven providers. Each key stays in your server\'s environment and goes only to its provider\'s API.',
          points: ['Anthropic, OpenAI, Azure OpenAI, Bedrock, Vertex AI, Qwen, DeepSeek, Kimi, Ollama, LM Studio, or any OpenAI compatible endpoint such as vLLM.', 'A model may only read its own provider\'s key variable, or one the operator lists, never the app\'s own secrets.', 'A per service model list narrows what an operator can pick for a session. The workspace default is always available.'],
          code: 'backend/llm/factory.py · backend/llm/registry.py' },
        { id: 'session', x: 330, y: 300, label: 'AI session', sub: 'observe, diagnose, plan, act', kind: 'AI',
          summary: 'A structured workflow, not a free running chat.',
          points: ['Observe, diagnose, plan, gate, act, report. The same graph for every session in the workspace.', 'Alert text, incident descriptions and tool output reach the model as marked data, never as instructions.', 'Operators watch it live, chat with it, approve or reject proposals, and stop it at any time.', 'Sessions are capacity aware. A priority queue decides which incident gets a slot first.'],
          code: 'backend/agent/graph.py · backend/agent/nodes.py · backend/agent/hygiene.py' },
        { id: 'gate', x: 560, y: 300, label: 'Tier gate', sub: 'enforced in code', kind: 'Safety',
          summary: 'The part the model cannot argue with.',
          points: ['Checks every tool call, in this order: the deny list, the general purpose command guard, the explicit per tier policy, then the Tier 0 reversibility floor.', 'No policy for an operation means it is denied. Malformed policy fails closed.', 'Tier 0 adds a sandbox floor, hard time limits, and a recorded way to undo each change.', 'The gate is a node in the workflow graph, not a prompt. Model output cannot skip it.'],
          code: 'backend/tiers/enforcement.py · backend/tiers/sandbox.py' },
        { id: 'mcp', x: 790, y: 240, label: 'MCP servers', sub: 'yours, local or remote', kind: 'Tools',
          summary: 'The general purpose way to give the agent hands.',
          points: ['Run any MCP server: local over stdio, or remote over HTTP with OAuth 2.1.', 'A local server receives only the environment you give it, never the app\'s secrets, unless its entry in mcp.json or OPSMENDER_MCP_SERVERS_JSON sets inherit_env. One saved before v1.2 keeps the full environment until an admin saves it again. A remote server is followed through a redirect only within its own origin.', 'Each service has a strict allowlist of servers. Empty means none.', 'Import server definitions from the config files of tools you already use.'],
          code: 'backend/mcp/' },
        { id: 'connectors', x: 790, y: 360, label: 'Native connectors', sub: '26 kinds', kind: 'Tools',
          summary: 'Built in integrations that need no MCP server at all.',
          points: ['GitHub, GitLab, Jira, ServiceNow, Kubernetes, Sentry, Argo CD, Terraform Cloud, and more. Twenty six kinds.', 'Credentials are encrypted at rest. Each service allowlists which connectors it may use.', 'Every capability carries an explicit tier policy and passes through the same gate as an MCP tool.', 'Two way ticket sync with Jira and ServiceNow.'],
          code: 'backend/integrations/registry.py · backend/integrations/tools.py' },
        { id: 'skills', x: 330, y: 510, label: 'Skills', sub: 'SKILL.md, your policy', kind: 'Safety',
          summary: 'A file you own that says what each tool may do at each tier.',
          points: ['Bind a skill to an MCP server or a native connector.', 'Every operation declares its behaviour at Tier 0, 1, and 2. Free form instructions per tier guide the model but cannot widen permissions.', 'Skill Studio discovers the tools a source offers, validates the file, and shows a policy diff before you save.', 'Skill policy can only make a connector stricter than its baseline.'],
          code: 'backend/skills/parser.py · examples/SKILL.md' },
        { id: 'people', x: 110, y: 510, label: 'People and access', sub: 'admin, operator, viewer', kind: 'Access',
          summary: 'Three roles that actually mean something.',
          points: ['Admins configure. Operators respond and run sessions. Viewers read and cannot write.', 'Email and password to start. OIDC, SAML, and TOTP when you need them.', 'Every approval, override, and session start is attributed to a person.'],
          code: 'backend/auth/' },
        { id: 'memory', x: 560, y: 510, label: 'Memory', sub: 'what past incidents taught', kind: 'Knowledge',
          summary: 'The agent remembers what worked last time.',
          points: ['Findings from earlier incidents are recalled into new sessions on the same service.', 'Memory is bounded and tagged by severity so recall stays relevant.', 'Operators can add, edit, or remove memories by hand.'],
          code: 'backend/memory/' },
        { id: 'postmortem', x: 790, y: 510, label: 'Postmortem', sub: 'drafted from the record', kind: 'Knowledge',
          summary: 'A structured draft, ready to edit, before anyone has to start from a blank page.',
          points: ['Built from the incident timeline and the session history.', 'Edit it in place, save it, and export it as Markdown.', 'Nothing in it is invented. Every section points back at what happened.'],
          code: 'backend/api/routes/incidents.py · backend/db/repos.py' },
        { id: 'audit', x: 1030, y: 400, label: 'Audit log', sub: 'every decision, every call', kind: 'Record',
          summary: 'If it happened, it is here.',
          points: ['Every tool call, gate decision, approval, and session event, with who or what caused it.', 'Credential-shaped strings in tool output are redacted before they are recorded.', 'Stored in Postgres. Retention policy with archival to S3 compatible storage.', 'Filter by session, tier, type, or time. Group by session to read an incident as a story.'],
          code: 'backend/audit/' },
      ];
      const edges: [string, string][] = [
        ['alerts','ingest'], ['ingest','incident'], ['incident','paging'], ['paging','notify'],
        ['incident','session'], ['models','session'], ['session','gate'], ['gate','mcp'], ['gate','connectors'],
        ['skills','gate'], ['people','session'], ['session','memory'], ['memory','postmortem'], ['gate','audit'], ['notify','audit'],
      ];
      const byId = Object.fromEntries(nodes.map(n => [n.id, n]));
      const NS = 'http://www.w3.org/2000/svg';
      const el = (t: string, a: Record<string, string> = {}) => { const e = document.createElementNS(NS, t); for (const k in a) e.setAttribute(k, a[k]); return e; };

      function anchor(a: Node, b: Node) {
        const dx = b.x - a.x, dy = b.y - a.y;
        if (Math.abs(dx) > Math.abs(dy)) return { x: a.x + Math.sign(dx) * W / 2, y: a.y };
        return { x: a.x, y: a.y + Math.sign(dy) * H / 2 };
      }
      function path(a: Node, b: Node) {
        const p = anchor(a, b), q = anchor(b, a);
        const horiz = Math.abs(b.x - a.x) > Math.abs(b.y - a.y);
        const c1 = horiz ? { x: (p.x + q.x) / 2, y: p.y } : { x: p.x, y: (p.y + q.y) / 2 };
        const c2 = horiz ? { x: (p.x + q.x) / 2, y: q.y } : { x: q.x, y: (p.y + q.y) / 2 };
        return `M${p.x},${p.y} C${c1.x},${c1.y} ${c2.x},${c2.y} ${q.x},${q.y}`;
      }

      const gE = el('g'), gF = el('g'), gN = el('g');
      const edgeEls: { a: string; b: string; base: SVGElement; flow: SVGElement }[] = [];
      for (const [a, b] of edges) {
        const d = path(byId[a], byId[b]);
        const baseEdge = el('path', { d, class: 'arch-edge' });
        const flow = el('path', { d, class: 'arch-flow', style: `stroke:${KIND[byId[a].kind]}` });
        gE.appendChild(baseEdge); gF.appendChild(flow);
        edgeEls.push({ a, b, base: baseEdge, flow });
      }
      const nodeEls: Record<string, SVGGElement> = {};
      for (const n of nodes) {
        const g = el('g', { class: 'arch-node', role: 'button', tabindex: '0', 'data-id': n.id, 'aria-label': `${n.label}: ${n.sub}`, style: `--c:${KIND[n.kind]}` }) as SVGGElement;
        g.appendChild(el('rect', { class: 'box', x: String(n.x - W / 2), y: String(n.y - H / 2), width: String(W), height: String(H), rx: '10' }));
        g.appendChild(el('rect', { class: 'bar', x: String(n.x - W / 2), y: String(n.y - H / 2 + 12), width: '3', height: String(H - 24), rx: '1.5' }));
        const t = el('text', { x: String(n.x - W / 2 + 14), y: String(n.y - 4) }); t.textContent = n.label;
        const s = el('text', { x: String(n.x - W / 2 + 14), y: String(n.y + 14), class: 'sub' }); s.textContent = n.sub;
        g.appendChild(t); g.appendChild(s);
        gN.appendChild(g); nodeEls[n.id] = g;
      }
      svg.append(gE, gF, gN);
      const legend = document.getElementById('legend');
      if (legend) for (const k in KIND) { const s = document.createElement('span'); s.className = 'inline-flex items-center gap-1.5'; s.style.setProperty('--c', KIND[k]); s.innerHTML = `<span class="dot"></span>${k}`; legend.appendChild(s); }

      // Phones get the same components as a stacked list; the map needs more width than a phone has.
      const list = document.getElementById('arch-list');
      const listEls: Record<string, HTMLButtonElement> = {};
      if (list) for (const n of nodes) {
        const b = document.createElement('button');
        b.type = 'button'; b.dataset.id = n.id; b.setAttribute('role', 'listitem');
        b.className = 'arch-item flex w-full items-center gap-3 rounded-xl border border-ops-border bg-ops-surface/80 px-4 py-3 text-left focus-ring';
        b.style.setProperty('--c', KIND[n.kind]);
        b.innerHTML = `<span class="dot shrink-0"></span><span class="min-w-0"><span class="block text-[15px] font-medium text-slate-50">${n.label}</span><span class="block truncate text-[12.5px] text-ops-muted">${n.sub}</span></span><span class="ml-auto font-mono text-[10px] uppercase tracking-[0.14em] text-ops-muted">${n.kind}</span>`;
        list.appendChild(b); listEls[n.id] = b;
      }

      const dossier = document.getElementById('dossier')!;
      const set = (id: string, v: string) => { document.getElementById(id)!.textContent = v; };
      let active: string | null = null;

      function open(id: string) {
        const n = byId[id]; active = id;
        set('d-kind', n.kind); set('d-title', n.label); set('d-summary', n.summary); set('d-code', n.code);
        const c = KIND[n.kind]; dossier.style.setProperty('--c', c); document.getElementById('d-kind')!.style.color = c;
        const ul = document.getElementById('d-points')!; ul.innerHTML = '';
        for (const p of n.points) { const li = document.createElement('li'); li.className = 'flex gap-2.5'; li.innerHTML = `<span class="dot mt-[7px] shrink-0"></span><span>${p}</span>`; ul.appendChild(li); }
        const links = document.getElementById('d-links')!; links.innerHTML = '';
        const nb = new Set<string>(); for (const e of edges) { if (e[0] === id) nb.add(e[1]); if (e[1] === id) nb.add(e[0]); }
        for (const m of nb) { const b = document.createElement('button'); b.className = 'rounded-full border border-ops-border px-2.5 py-1 text-xs text-slate-200 hover:border-ops-blue focus-ring'; b.textContent = byId[m].label; b.onclick = () => open(m); links.appendChild(b); }
        for (const k in nodeEls) nodeEls[k].classList.toggle('active', k === id), nodeEls[k].classList.toggle('dim', k !== id && !nb.has(k));
        for (const k in listEls) listEls[k].classList.toggle('active', k === id);
        for (const e of edgeEls) { const lit = e.a === id || e.b === id; e.base.style.stroke = lit ? KIND[byId[e.a].kind] : ''; e.base.classList.toggle('dim', !lit); e.flow.classList.toggle('lit', lit); e.flow.classList.toggle('dim', !lit); }
        dossier.hidden = false; requestAnimationFrame(() => dossier.classList.add('open'));
      }
      function close() {
        active = null; dossier.classList.remove('open');
        setTimeout(() => { if (!active) dossier.hidden = true; }, 350);
        for (const k in nodeEls) nodeEls[k].classList.remove('active', 'dim');
        for (const k in listEls) listEls[k].classList.remove('active');
        for (const e of edgeEls) { e.base.style.stroke = ''; e.base.classList.remove('dim'); e.flow.classList.remove('lit', 'dim'); }
      }
      list?.addEventListener('click', (ev) => { const b = (ev.target as Element).closest('.arch-item') as HTMLElement | null; if (b) open(b.dataset.id!); });
      gN.addEventListener('click', (ev) => { const g = (ev.target as Element).closest('.arch-node') as HTMLElement | null; if (g) open(g.dataset.id!); });
      gN.addEventListener('keydown', (ev) => {
        const g = (ev.target as Element).closest('.arch-node') as HTMLElement | null; if (!g) return;
        if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); open(g.dataset.id!); }
      });
      document.getElementById('d-close')!.addEventListener('click', close);
      document.addEventListener('keydown', (ev) => {
        if (ev.key === 'Escape' && active) { close(); nodeEls[active!]?.focus(); return; }
        if (!active || !['ArrowLeft', 'ArrowRight'].includes(ev.key)) return;
        ev.preventDefault();
        const i = nodes.findIndex(n => n.id === active);
        const j = (i + (ev.key === 'ArrowRight' ? 1 : nodes.length - 1)) % nodes.length;
        open(nodes[j].id); nodeEls[nodes[j].id].focus();
      });
      document.addEventListener('click', (ev) => { if (active && !dossier.contains(ev.target as Node) && !svg.contains(ev.target as Node) && !list?.contains(ev.target as Node)) close(); });
    })();

    // ---------- Screenshot viewer + lightbox ----------
    (() => {
      const root = document.getElementById('viewer'); if (!root) return;
      const base = root.dataset.base || '';
      const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role=tab]'));
      const img = document.getElementById('v-img') as HTMLImageElement;
      const lb = document.getElementById('lightbox')!, lbImg = document.getElementById('lb-img') as HTMLImageElement;
      let i = 0;
      function show(n: number) {
        i = (n + thumbs.length) % thumbs.length; const t = thumbs[i];
        img.src = `${base}/screenshots/${t.dataset.file}`; img.alt = t.dataset.title || '';
        document.getElementById('v-title')!.textContent = t.dataset.title || '';
        document.getElementById('v-cap')!.textContent = t.dataset.cap || '';
        document.getElementById('v-count')!.textContent = `${i + 1} / ${thumbs.length}`;
        thumbs.forEach((b, k) => { b.setAttribute('aria-selected', String(k === i)); b.classList.toggle('border-ops-blue', k === i); b.classList.toggle('border-ops-border', k !== i); });
        if (!lb.classList.contains('hidden')) { lbImg.src = img.src; lbImg.alt = img.alt; document.getElementById('lb-cap')!.textContent = `${t.dataset.title}. ${t.dataset.cap}`; }
      }
      thumbs.forEach((b, k) => b.addEventListener('click', () => show(k)));
      function openLb() { lb.classList.remove('hidden'); lb.classList.add('flex'); show(i); document.body.style.overflow = 'hidden'; (document.getElementById('lb-close') as HTMLElement).focus(); }
      function closeLb() { lb.classList.add('hidden'); lb.classList.remove('flex'); document.body.style.overflow = ''; (document.getElementById('v-open') as HTMLElement).focus(); }
      document.getElementById('v-open')!.addEventListener('click', openLb);
      document.getElementById('lb-close')!.addEventListener('click', closeLb);
      document.getElementById('lb-prev')!.addEventListener('click', () => show(i - 1));
      document.getElementById('lb-next')!.addEventListener('click', () => show(i + 1));
      lb.addEventListener('click', (e) => { if (e.target === lb) closeLb(); });
      document.addEventListener('keydown', (e) => {
        if (lb.classList.contains('hidden')) return;
        if (e.key === 'Escape') closeLb(); else if (e.key === 'ArrowLeft') show(i - 1); else if (e.key === 'ArrowRight') show(i + 1);
      });
    })();
  </script>
</Layout>
