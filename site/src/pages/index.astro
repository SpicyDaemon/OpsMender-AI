      <button id="lb-next" class="absolute right-3 top-1/2 -translate-y-1/2 rounded p-2 text-om-muted hover:text-om-cream focus-ring" aria-label="Next"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/></svg></button>
