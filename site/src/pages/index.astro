---
import Layout from '../layouts/Layout.astro';
import platforms from '../data/platforms.json';
import sources from '../data/sources.json';
import providers from '../data/providers.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const shot = (file: string) => `${base}/screenshots/${file}`;

const GITHUB_URL    = 'https://github.com/SpicyDaemon/OpsMender-AI';
const DOCS_URL      = `${GITHUB_URL}/blob/main/docs/wiki/README.md`;
const CHANGELOG_URL = `${GITHUB_URL}/blob/main/CHANGELOG.md`;
const RELEASES_URL  = `${GITHUB_URL}/releases`;

const stats = [
  { value: 3500, suffix: '+', label: 'automated tests' },
  { value: 26,   suffix: '',  label: 'integration kinds' },
  { value: 20,   suffix: '',  label: 'notification platforms' },
  { value: 16,   suffix: '',  label: 'alert sources parsed' },
];

// Each step shows the whole screen, then zooms to one spot (fx, fy as % of the image, w and h the ring size) and says what to look at.
const steps = [
  { title: 'Every alert lands in one place', file: 'incidents-admin.png', fx: 37.5, fy: 69.5, w: 34, h: 10, s: 2.8,
    look: 'This alert opened the incident by itself. The amber tag means an AI session is already on it.',
    desc: 'Sixteen sources have a parser. A re-firing alert updates the incident it already opened, similar alerts fold in, and maintenance windows keep matching alerts quiet.' },
  { title: 'The agent investigates', file: 'live-session-detail.png', fx: 48.5, fy: 38, w: 22, h: 8, s: 3.0,
    look: 'The agent observed, diagnosed and planned, then stopped at the gate to wait for a person.',
    desc: 'Observe, diagnose, plan, gate, act, report. Operators watch it live, chat with it, and stop it at any time. Reads happen right away; writes wait at the gate.' },
  { title: 'A person decides', file: 'approvals-pending.png', fx: 80, fy: 35, w: 38, h: 10, s: 2.5,
    look: 'One request, with its tier, the time left, and the Approve and Reject buttons.',
    desc: 'Proposals sit in the approval inbox with their reasoning and the exact command. Approve, redirect, or deny. Everything lands in the audit log either way.' },
];

// What the gate does with a request at each tier, in plain words.
const CHIP: Record<string, string> = { runs: 'Runs', undo: 'Runs, can undo', approval: 'Waits for approval', advise: 'Suggests only', never: 'Never' };
const policyRows: { ask: string; tiers: (keyof typeof CHIP)[] }[] = [
  { ask: 'Read the logs of a pod',          tiers: ['runs', 'runs', 'runs'] },
  { ask: 'Restart a deployment',            tiers: ['undo', 'approval', 'advise'] },
  { ask: 'Scale a service up',              tiers: ['undo', 'approval', 'advise'] },
  { ask: 'Delete a namespace',              tiers: ['never', 'never', 'never'] },
  { ask: 'Run an arbitrary shell command',  tiers: ['never', 'never', 'never'] },
];

const tiers = [
  { num: '0', name: 'Autonomous', tone: 'bg-red-400', file: 'tier-0.png',
    desc: 'Fixes things on its own: restarts, rollbacks, scaling. Only changes it can undo, inside your policy, with a hard time limit.', note: 'For staging and sandboxes.' },
  { num: '1', name: 'Approval required', tone: 'bg-amber-400', file: 'tier-1.png',
    desc: 'Investigates and proposes. Reads happen right away. Anything that writes waits for a person to approve it.', note: 'The right choice for production.' },
  { num: '2', name: 'Advisory', tone: 'bg-ops-blue', file: 'tier-2.png', isDefault: true,
    desc: 'Reads, explains, and recommends. Writes nothing. A person carries out every step.', note: 'The default for every new install.' },
];

const gatePoints = [
  { num: '01', title: 'Policy you own', desc: 'A Skill file says, for every tool, what may happen at each tier: run on its own, wait for approval, advise only, or never. Anything it does not name is denied.' },
  { num: '02', title: 'Enforced in code', desc: 'The check runs in the backend before any tool call, in order: the deny list, the generic command guard, the per tier policy, the Tier 0 reversibility floor. The model never gets a vote.' },
  { num: '03', title: 'Alert text is data', desc: 'Alert text and tool output reach the model as data, never as instructions. Keys and passwords in tool output are removed. An alert that tries to give the agent orders is flagged for the person who decides.' },
];

const whatsNew = [
  ['Alert text is data, never orders',  'Every prompt marks alert text, incident descriptions and tool output as data. Keys and passwords in tool output are removed before the model sees them. An alert that tries to give the AI instructions is flagged on the incident and never acted on.'],
  ['Keys stay where they belong',       'A model may only read its own provider\'s key, and a local MCP server only sees the environment you give it. Neither can reach the app\'s own secrets.'],
  ['Run more than one copy',            'Scheduled audits and uptime checks are claimed per row, so several instances behind a load balancer run each job once. A copy that dies hands its work to another after the interval.'],
  ['Current foundations',               'The MCP SDK is at 1.30 with its advisory closed, a redirect to another host is refused by name, and every build and release step runs on Node 24.'],
];

const shots = [
  { file: 'incident-detail.png',     title: 'Incident detail',   caption: 'An incident with its AI session, timeline, and alert evidence in one view.' },
  { file: 'incidents-admin.png',     title: 'Incident board',    caption: 'Priority, status, owner, and whether an AI session is running, at a glance.' },
  { file: 'live-session-detail.png', title: 'Live session',      caption: 'Watch the agent work: workflow state, approvals, tool activity, and chat.' },
  { file: 'ai-session.png',          title: 'Tier 0 session',    caption: 'The agent restarted a deployment, confirmed recovery, and recorded how to undo it.' },
  { file: 'tier-2.png',              title: 'Tier 2 session',    caption: 'Read only diagnosis and a change plan. Nothing was altered.' },
  { file: 'mcp-skills.png',          title: 'Skill Studio',      caption: 'The policies that decide what the agent may run, per tool and per tier.' },
  { file: 'people-rbac.png',         title: 'People and access', caption: 'Admins, operators, and viewers, with SSO and TOTP when you want them.' },
  { file: 'settings.png',            title: 'Settings',          caption: 'Session workflow, models, notifications, and workspace guardrails.' },
];

const marquee = [...platforms, ...sources];
---

<Layout>
  <style is:global>
    /* Intro: the wordmark arrives, breathes, then widens and dissolves. */
    .reveal { opacity: 0; transform: translateY(14px); animation: reveal 0.9s var(--ease-fluid) forwards; }
    .reveal-1 { animation-delay: .15s } .reveal-2 { animation-delay: .35s } .reveal-3 { animation-delay: .55s }
    .reveal-4 { animation-delay: .8s }  .reveal-5 { animation-delay: 1s }
    @keyframes reveal { to { opacity: 1; transform: none; } }
    .reveal { animation-play-state: paused; }
    html.ready .reveal { animation-play-state: running; }
    #intro { transition: opacity .9s ease; }
    #intro.gone { opacity: 0; pointer-events: none; }
    #intro-mark { opacity: 0; transform: scale(.94); filter: blur(6px);
      transition: opacity 1.5s ease, transform 1.5s var(--ease-fluid), filter 1.5s ease; }
    #intro.in #intro-mark { opacity: 1; transform: none; filter: none; animation: breathe 4.5s ease-in-out 1.5s infinite; }
    #intro.out #intro-mark { opacity: 0; transform: scale(1.08); filter: blur(10px); transition-duration: 1s; animation: none; }
    #intro-line { opacity: 0; letter-spacing: .5em; text-indent: .5em;
      transition: opacity 1.3s ease .7s, letter-spacing 1.3s ease .7s; }
    #intro.in #intro-line { opacity: 1; }
    #intro.out #intro-line { opacity: 0; letter-spacing: .95em; transition: opacity .9s ease, letter-spacing .9s ease; }
    @keyframes breathe { 0%,100% { opacity: .78 } 50% { opacity: 1 } }

    /* The nav: plain at the top, a floating pill once you scroll. */
    #nav { position: fixed; top: 0; left: 50%; transform: translateX(-50%); z-index: 50; width: 100%; max-width: 1280px; padding: 14px 24px; border-radius: 0; background: transparent; border: 1px solid transparent;
      transition: width .65s var(--ease-fluid), max-width .65s var(--ease-fluid), top .65s var(--ease-fluid), padding .65s var(--ease-fluid), border-radius .65s var(--ease-fluid), background-color .45s var(--ease-fade), border-color .45s var(--ease-fade), backdrop-filter .45s var(--ease-fade); }
    #nav.floating { top: 14px; width: calc(100% - 32px); max-width: 920px; padding: 8px 10px 8px 18px; border-radius: 9999px; background: rgba(13,18,33,0.82); border-color: #1a2540; backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); box-shadow: 0 20px 60px -30px rgba(0,0,0,0.8); }

    /* Zoom cards: the whole screen first, then a slow push in to one spot with a note. */
    .zoom { cursor: zoom-in; }
    .zoom.focus { cursor: zoom-out; }
    .zoom-stage { position: absolute; inset: 0; transform-origin: var(--fx) var(--fy); transition: transform 1.6s var(--ease-fluid); will-change: transform; }
    .zoom.focus .zoom-stage { transform: translate(var(--tx), var(--ty)) scale(var(--s)); }
    .zoom-ring { position: absolute; transform: translate(-50%, -50%); border: 1.5px solid #fbbf24; border-radius: 8px; opacity: 0;
      box-shadow: 0 0 0 9999px rgba(7,9,15,0); transition: opacity .7s var(--ease-fade) .8s, box-shadow .7s var(--ease-fade) .8s; }
    .zoom.focus .zoom-ring { opacity: 1; box-shadow: 0 0 0 9999px rgba(7,9,15,.5), 0 0 20px rgba(251,191,36,.35); }
    .zoom-toggle { position: absolute; inset: 0; z-index: 2; background: transparent; border: 0; border-radius: inherit; cursor: inherit; }
    .zoom-note { position: absolute; left: 12px; right: 12px; bottom: 12px; z-index: 3; pointer-events: none; display: flex; gap: .6rem; align-items: flex-start;
      padding: .7rem .9rem; border-radius: 14px; background: rgba(13,18,33,.94); border: 1px solid #1a2540; color: #e2e8f0; font-size: 13.5px; line-height: 1.45;
      opacity: 0; transform: translateY(8px); transition: opacity .6s var(--ease-fade) 1.1s, transform .6s var(--ease-fade) 1.1s; }
    .zoom.focus .zoom-note { opacity: 1; transform: none; }
    .zoom-dot { flex: none; width: 8px; height: 8px; margin-top: 6px; border-radius: 9999px; background: #fbbf24; box-shadow: 0 0 0 4px rgba(251,191,36,.18); }

    /* Policy chips in the gate table. */
    .chip { display: inline-flex; align-items: center; border-radius: 9999px; padding: .3rem .7rem; font-family: var(--font-mono); font-size: 11px; letter-spacing: .04em; white-space: nowrap; }
    .chip-runs, .chip-undo { background: rgba(52,211,153,.12); color: #34d399; }
    .chip-approval { background: rgba(251,191,36,.12); color: #fbbf24; }
    .chip-advise { background: rgba(96,165,250,.14); color: #60a5fa; }
    .chip-never { background: rgba(251,113,133,.12); color: #fb7185; }

    /* Architecture map. Each node carries its family colour in --c. */
    .arch-edge { fill: none; stroke: #263354; stroke-width: 1.4; transition: stroke .2s, opacity .2s; }
    .arch-flow { fill: none; stroke-width: 1.6; stroke-dasharray: 3 14; stroke-linecap: round; opacity: .5; animation: flow 1.6s linear infinite; transition: opacity .2s; }
    @keyframes flow { to { stroke-dashoffset: -17; } }
    .arch-node { cursor: pointer; outline: none; }
    .arch-node .box { fill: #0d1221; stroke: #1f2a47; stroke-width: 1; transition: stroke .2s, fill .2s, filter .2s; }
    .arch-node .bar { fill: var(--c); opacity: .9; }
    .arch-node text { fill: #e2e8f0; font: 500 13px var(--font-sans); pointer-events: none; }
    .arch-node .sub { fill: #64748b; font-size: 10.5px; font-weight: 400; }
    .arch-node:hover .box, .arch-node:focus-visible .box { stroke: var(--c); fill: #101a30; }
    .arch-node.active .box { stroke: var(--c); fill: #12203a; stroke-width: 1.5; filter: drop-shadow(0 0 10px var(--c)); }
    .arch-node.dim { opacity: .3; }
    .arch-edge.dim, .arch-flow.dim { opacity: .1; }
    .arch-flow.lit { opacity: 1; }
    .dot { display: inline-block; width: 7px; height: 7px; border-radius: 9999px; background: var(--c); }
    .dossier { transform: translateX(105%); transition: transform .35s var(--ease-fluid); }
    .dossier.open { transform: none; }
    @media (max-width: 1023px) { .dossier { transform: translateY(105%); } .dossier.open { transform: none; } }

    @media (prefers-reduced-motion: reduce) {
      .reveal { animation: none; opacity: 1; transform: none; }
      .arch-flow, .animate-marquee { animation: none; }
      .dossier, #nav, .zoom-stage, .zoom-ring, .zoom-note { transition: none; }
      .zoom-note { opacity: 1; transform: none; }
    }
  </style>

  <div id="intro" class="fixed inset-0 z-[100] flex flex-col items-center justify-center bg-ops-bg" aria-hidden="true">
    <img id="intro-mark" src={`${base}/wordmark.png`} alt="" width="577" height="117" class="w-[min(66vw,520px)]" decoding="async" />
    <p id="intro-line" class="mt-7 text-[clamp(10px,1.3vw,13px)] font-light uppercase text-slate-400">Detect. Mend. Prevail.</p>
  </div>

  <canvas id="field" class="pointer-events-none fixed inset-0 z-0 h-full w-full" aria-hidden="true"></canvas>

  <nav id="nav" aria-label="Main">
    <div class="flex items-center justify-between">
      <a href="#top" class="text-[15px] font-semibold tracking-tight text-slate-50 focus-ring">Ops<span class="text-ops-blue">Mender</span></a>
      <div class="hidden items-center gap-1 md:flex">
        <a href="#how"      class="nav-link">How it works</a>
        <a href="#tiers"    class="nav-link">Autonomy</a>
        <a href="#bring"    class="nav-link">Integrations</a>
        <a href="#gate"     class="nav-link">The gate</a>
        <a href="#screens"  class="nav-link">Screens</a>
      </div>
      <div class="flex items-center gap-3">
        <a href="#install" class="nav-link hidden sm:inline">Install</a>
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="pill pill-blue !py-1.5 !pl-4 !pr-1.5 text-[11.5px]">GitHub <span class="arrow"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M9 7h8v8"/></svg></span></a>
      </div>
    </div>
  </nav>

  <main class="relative z-10">
    <!-- HERO -->
    <header id="top" class="mx-auto max-w-7xl px-5 pb-10 pt-36 text-center sm:px-8 sm:pt-44">
      <p class="reveal reveal-1 mx-auto inline-flex items-center gap-2 rounded-full border border-ops-border bg-ops-surface/70 px-3.5 py-1.5 font-mono text-[11px] uppercase tracking-[0.18em] text-ops-subtle">Open source <span class="text-ops-muted">·</span> runs on your servers</p>
      <h1 class="display mx-auto mt-8 max-w-4xl text-[2.45rem] text-slate-50 sm:text-6xl lg:text-[4.6rem]">
        <span class="reveal reveal-1 block">Page the right people.</span>
        <span class="reveal reveal-2 block">Let AI investigate.</span>
        <span class="reveal reveal-3 block text-ops-subtle">You decide what runs.</span>
      </h1>
      <p class="reveal reveal-4 mx-auto mt-7 max-w-xl text-[17px] leading-relaxed text-ops-subtle sm:text-lg">
        OpsMender is an incident response platform you host yourself. It tracks incidents, pages the on call
        engineer, and can hand an AI agent the tools to investigate and fix things. A gate in the backend decides
        what the agent may actually do, and the model has no say in it.
      </p>
      <div class="reveal reveal-5 mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="pill pill-blue">View on GitHub <span class="arrow"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M9 7h8v8"/></svg></span></a>
        <a href="#how" class="pill pill-ghost">See how it works</a>
      </div>
      <div class="reveal reveal-5 mx-auto mt-6 flex max-w-md items-center justify-between gap-3 rounded-lg border border-ops-border bg-ops-surface/70 px-4 py-2.5 font-mono text-[12.5px] text-slate-200">
        <span><span class="text-ops-muted">&gt;</span> docker compose -f docker/docker-compose.yml up</span>
        <button id="copy-cmd" type="button" class="rounded p-1 text-ops-muted transition-colors hover:text-slate-100 focus-ring" aria-label="Copy the command">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
        </button>
      </div>
    </header>

    <section class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="panel reveal reveal-5 p-3 sm:p-6">
        <div class="wash wash-blue" aria-hidden="true"></div>
        <figure class="relative overflow-hidden rounded-2xl border border-ops-border/80 shadow-frame">
          <img src={shot('incidents-list.png')} alt="The incident command center: a list of incidents with priority, status, owner, and whether an AI session is running" width="3200" height="2000" class="block w-full" loading="eager" fetchpriority="high" />
        </figure>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section id="how" class="mx-auto max-w-7xl scroll-mt-28 px-5 pt-32 sm:px-8 sm:pt-44">
      <div class="text-center">
        <p class="label rise">How it works</p>
        <h2 class="headline rise mx-auto mt-5 max-w-3xl text-4xl text-slate-50 sm:text-5xl" style="--i:1">Alerts in. The right person paged. An agent that works inside the lines you draw.</h2>
      </div>
      <div class="mt-16 grid gap-5 md:grid-cols-3">
        {steps.map((s, i) => (
          <article class="rise" style={`--i:${i + 1}`}>
            <div class="panel zoom aspect-[16/10] p-0" style={`--fx:${s.fx}%; --fy:${s.fy}%; --s:${s.s}; --tx:${50 - s.fx}%; --ty:${50 - s.fy}%`}>
              <div class="zoom-stage">
                <img src={shot(s.file)} alt={s.title} width="3200" height="2000" class="block h-full w-full object-cover object-top" loading="lazy" />
                <span class="zoom-ring" style={`left:${s.fx}%; top:${s.fy}%; width:${s.w}%; height:${s.h}%`} aria-hidden="true"></span>
              </div>
              <button type="button" class="zoom-toggle focus-ring" aria-label={`Zoom in or out on ${s.title}`}></button>
              <p class="zoom-note"><span class="zoom-dot" aria-hidden="true"></span>{s.look}</p>
            </div>
            <h3 class="mt-6 text-[22px] font-medium tracking-tight text-slate-50">{s.title}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-ops-subtle">{s.desc}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- TIERS -->
    <section id="tiers" class="mx-auto max-w-7xl scroll-mt-28 px-5 pt-32 sm:px-8 sm:pt-44">
      <div class="text-center">
        <p class="label rise">Autonomy</p>
        <h2 class="headline rise mx-auto mt-5 max-w-2xl text-4xl text-slate-50 sm:text-5xl" style="--i:1">Three tiers. One is picked per session.</h2>
        <p class="rise mx-auto mt-5 max-w-xl text-ops-subtle" style="--i:2">The tier is enforced in the backend before any tool call runs, so the agent cannot talk its way past it.</p>
      </div>
      <div class="mt-14 grid gap-5 md:grid-cols-3">
        {tiers.map((t, i) => (
          <article class="panel rise p-5" style={`--i:${i + 1}`}>
            <img src={shot(t.file)} alt={`A Tier ${t.num} session`} width="3200" height="2000" class="block aspect-[16/10] w-full rounded-xl border border-ops-border object-cover object-top" loading="lazy" />
            <div class="mt-5 flex items-center justify-between">
              <span class="inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.16em] text-ops-subtle"><span class={`h-2 w-2 rounded-full ${t.tone}`}></span>Tier {t.num}</span>
              {t.isDefault && <span class="rounded-full border border-ops-border px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.12em] text-ops-subtle">Default</span>}
            </div>
            <h3 class="mt-2 text-[22px] font-medium tracking-tight text-slate-50">{t.name}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-ops-subtle">{t.desc}</p>
            <p class="mt-4 text-sm text-slate-200">{t.note}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- INTEGRATIONS -->
    <section id="bring" class="scroll-mt-28 pt-32 sm:pt-44">
      <div class="mx-auto max-w-7xl px-5 text-center sm:px-8">
        <p class="label rise">Integrations</p>
        <h2 class="headline rise mx-auto mt-5 max-w-2xl text-4xl text-slate-50 sm:text-5xl" style="--i:1">OpsMender fits the tools your team already uses.</h2>
        <p class="rise mx-auto mt-5 max-w-xl text-ops-subtle" style="--i:2">Alerts in from sixteen sources. Pages out to twenty platforms, with buttons in Slack, Teams, and Discord. Any of seven model providers, and your key never leaves your deployment.</p>
      </div>
      <div class="fade-x rise mt-14 overflow-hidden" style="--i:3" aria-label="Alert sources and notification platforms">
        <div class="flex w-max animate-marquee gap-4 pr-4">
          {[...marquee, ...marquee].map((item) => (
            <div class="flex h-[92px] w-[104px] shrink-0 flex-col items-center justify-center gap-2 rounded-2xl border border-ops-border bg-ops-surface/80 text-slate-200" title={item.name}>
              <span class="[&>svg]:h-7 [&>svg]:w-7" set:html={item.svg} />
              <span class="max-w-[88px] truncate font-mono text-[9.5px] uppercase tracking-[0.1em] text-ops-muted">{item.name}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="mx-auto mt-10 max-w-7xl px-5 sm:px-8">
        <div class="rise grid gap-3 sm:grid-cols-4 lg:grid-cols-7" style="--i:4" aria-label="Model providers">
          {providers.map((m) => (
            <div class="flex items-center gap-3 rounded-2xl border border-ops-border bg-ops-surface/80 p-3.5">
              <span class="shrink-0 text-slate-200 [&>svg]:h-6 [&>svg]:w-6" set:html={m.svg} />
              <span class="min-w-0"><span class="block truncate text-sm font-medium text-slate-50">{m.name}</span><span class="block truncate text-[11px] text-ops-muted">{m.note}</span></span>
            </div>
          ))}
        </div>
        <p class="rise mt-5 text-center text-sm text-ops-muted" style="--i:5">Twenty six built in connectors as well, including GitHub, GitLab, Jira, ServiceNow, Kubernetes, Sentry, Argo CD and Terraform Cloud, with two way ticket sync for Jira and ServiceNow. Any MCP server you care to run.</p>
      </div>
    </section>

    <!-- THE GATE -->
    <section id="gate" class="mx-auto max-w-7xl scroll-mt-28 px-5 pt-32 sm:px-8 sm:pt-44">
      <div class="panel rise px-6 py-14 sm:px-12 sm:py-20">
        <div class="wash wash-indigo" aria-hidden="true"></div>
        <div class="relative text-center">
          <p class="label">The gate</p>
          <h2 class="headline mx-auto mt-5 max-w-2xl text-4xl text-slate-50 sm:text-5xl">Built so the model never gets a vote.</h2>
        </div>
        <div class="relative mt-14 grid gap-10 lg:grid-cols-3">
          {gatePoints.map((g) => (
            <div>
              <h3 class="text-xl font-medium tracking-tight text-slate-50">{g.title}</h3>
