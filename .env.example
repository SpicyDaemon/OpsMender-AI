# ============================================================
# OpsMender AI — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Never commit .env to git.
#
# Variable sourcing order (later wins):
#   1. Defaults compiled into the code
#   2. Values read from this .env file at process start
#   3. Real shell environment variables exported in the running process
#
# Every variable below is consumed by the running app unless explicitly
# marked OPTIONAL. Anything OPTIONAL can stay commented out.
# ============================================================


# ============================================================
# 1. DEPLOYMENT TOPOLOGY + ENVIRONMENT
# ============================================================
# Topology: monolith (default) or distributed.
OPSMENDER_DEPLOYMENT_MODE=monolith
#
# Security environment:
#   development → defaults work as-is. The API accepts the placeholder
#                 OPSMENDER_JWT_SECRET below so `cp .env.example .env`
#                 followed by `docker compose up` Just Works.
#
#   production  → the API refuses to start unless:
#                   - OPSMENDER_JWT_SECRET is set to a strong value
#                     (generate with: openssl rand -hex 32)
#                   - OPSMENDER_BOOTSTRAP_ADMIN_EMAIL and
#                     OPSMENDER_BOOTSTRAP_ADMIN_PASSWORD are set so a
#                     first admin user exists without self-signup
#
# Legacy OPSMENDER_DEPLOYMENT_MODE=development|production values remain
# supported and select the monolith topology.
OPSMENDER_ENVIRONMENT=development
#
# Distributed mode only: api | worker | scheduler | dispatcher.
# The distributed Compose file sets this separately for each container.
# OPSMENDER_SERVICE_ROLE=api


# ============================================================
# 2. CORE RUNTIME CONFIG
# ============================================================

# Default AI Autonomy Tier: 0 | 1 | 2
#   2 → Advisory Only (default) — analysis/recommendations only; no
#       write/remediation actions execute (read-only observation still runs)
#   1 → Approval Required — safe/allow-listed actions run; destructive and
#       generic-command actions require operator approval; deny-listed denied
#   0 → Autonomous (sandbox/non-prod only — hard time limits) — may execute
#       remediation within MCP Skill policy, deny lists, and the Tier 0 floor
# A legacy stored value of 3 is automatically remapped to 2.
OPSMENDER_TIER=2

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Applied process-wide at startup (governs OpsMender's own logs AND uvicorn
# HTTP access logs). Editable live from the dashboard Config page — a saved
# value is persisted and re-applied on restart, overriding this default.
OPSMENDER_LOG_LEVEL=INFO

# Approval timeout in seconds for Tier 1 requests. After this elapses,
# the request is auto-rejected and the session is blocked.
OPSMENDER_APPROVAL_TIMEOUT_SECONDS=900

# Incident-session capacity queue and approval-slot lifecycle. The hold TTL
# falls back to OPSMENDER_APPROVAL_TIMEOUT_SECONDS when omitted.
OPSMENDER_SESSION_QUEUE_TTL_SECONDS=900
OPSMENDER_APPROVAL_HOLD_TTL_SECONDS=900
OPSMENDER_APPROVAL_EXTENSION_WARNING_SECONDS=60
OPSMENDER_SESSION_QUEUE_SWEEP_SECONDS=30

# Tier 0 sandbox hard time limits (only applied when OPSMENDER_TIER=0).
#   - Session-level wall clock around graph.ainvoke
#   - Per-node wall clock; on timeout the node returns status='timed_out'
OPSMENDER_TIER0_MAX_SESSION_SECONDS=600
OPSMENDER_TIER0_MAX_NODE_SECONDS=120

# Path to the default skill definition file. Looked up only when no skill
# is bound to the active MCP server in the DB AND no global (unassigned)
# skill exists in the skills table. Files in ./skills/ are auto-imported
# into the DB on backend startup — this fallback is mostly historical.
OPSMENDER_SKILL_DEFINITION=./examples/SKILL.md

# Path to the JSONL audit-log file written alongside the DB-backed audit.
# Operators commonly point this at a shared volume so the file survives
# container restarts.
OPSMENDER_AUDIT_LOG=./logs/audit.jsonl

# Path to the Next.js static export served by FastAPI's catch-all route.
# Leave at the default when using the Docker image or `opsmender` binary;
# unset or point to a non-existent dir during local `next dev` usage.
OPSMENDER_FRONTEND_STATIC_DIR=./frontend/out

# Optional: override the directory containing the node/npx/npm binaries.
# The Docker image bundles Node automatically — only needed for local or
# PyInstaller-binary installs where Node is in a non-standard location.
# OPSMENDER_NODE_PATH=/usr/local/bin

# Optional CLI-only fallback for MCP servers when the DB has none yet.
# Once a server is added via /dashboard/mcp-servers or POST /mcp-servers,
# this is ignored. Example:
#   OPSMENDER_MCP_SERVERS_JSON=[{"name":"k8s","transport":"stdio","command":"npx","args":["-y","@anthropic/mcp-server-k8s"]}]
OPSMENDER_MCP_SERVERS_JSON=[]


# ============================================================
# 3. DATABASE
# ============================================================

# Primary async SQLAlchemy DB URL.
#
# Default below targets the **bundled Postgres container** that
# docker/docker-compose.yml ships as the `db` service. This is the value
# the "cp .env.example .env && docker compose up" path expects.
#
# To use an external Postgres (RDS, Cloud SQL, on-prem) replace the host
# with the reachable address. Examples:
#   - external host on the same machine as Docker Desktop:
#     postgresql+asyncpg://user:pw@host.docker.internal:5432/opsmender
#   - AWS RDS:
#     postgresql+asyncpg://user:pw@xxx.abc123.us-east-1.rds.amazonaws.com:5432/opsmender
#
# Use the postgresql+asyncpg:// scheme — the +asyncpg matters; the plain
# postgresql:// scheme won't work with OpsMender's SQLAlchemy async API.
OPSMENDER_DATABASE_URL=postgresql+asyncpg://opsmender:opsmender@db:5432/opsmender

# Fallback chain used only when OPSMENDER_DATABASE_URL is unset entirely
# (which Docker Compose users normally don't hit because the line above
# is always set). Bare-metal `opsmender serve` and the PyInstaller
# binary may rely on these.
OPSMENDER_LOCAL_POSTGRES_URL=postgresql+asyncpg://opsmender:opsmender@localhost:5432/opsmender
OPSMENDER_SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./opsmender-local.db


# ============================================================
# 4. AUTH — JWT, secret-encryption key, bootstrap admin
# ============================================================

# Secret key for signing OpsMender JWTs.
#
# Development (OPSMENDER_ENVIRONMENT=development):
#   The placeholder below is accepted as-is — no rotation required.
#
# Production (OPSMENDER_ENVIRONMENT=production):
#   The placeholder is REJECTED at startup. Replace with a strong value:
#     OPSMENDER_JWT_SECRET=$(openssl rand -hex 32)
OPSMENDER_JWT_SECRET=change-me-in-production
OPSMENDER_JWT_ALGORITHM=HS256
# Browser session duration before re-login is required.
# Default 7 days = 10080 minutes = 604800 seconds (v1). MFA is deferred to v2.
OPSMENDER_JWT_EXPIRE_MINUTES=10080

# OPTIONAL — Fernet seed for encrypting per-tenant OIDC client secrets
# and other at-rest secret material (AES-128-CBC + HMAC-SHA256). When
# unset, OpsMender falls back to OPSMENDER_JWT_SECRET (works but couples
# JWT rotation to secret-store re-encryption). Strongly recommended to
# set explicitly in production:
#   OPSMENDER_SECRET_KEY=$(openssl rand -hex 32)
# OPSMENDER_SECRET_KEY=

# Self-signup is closed. On first startup, when the users table is empty
# AND both of the following are set, the API creates the first admin
# user automatically. After that, new accounts arrive via the
# Admin → People invite flow.
#
# In production mode these are REQUIRED — without them, no one can log
# into a fresh deployment (production never seeds a default admin).
# In development mode they are OPTIONAL: when unset, a fresh database is
# seeded with a default admin / admin123 (both the Docker Compose dev
# path and the `scripts/dev_server.py` launcher). Set these to use your
# own first admin instead of the default.
# OPSMENDER_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# OPSMENDER_BOOTSTRAP_ADMIN_PASSWORD=replace-me-on-first-login

# Multi-org is hidden by default (single-workspace mode keeps the UI
# simple). Set to true to expose the TopBar org switcher and per-invite
# org picker. The multi-tenant schema + per-tenant SSO/SAML work stays
# intact regardless of this flag.
OPSMENDER_MULTI_ORG_ENABLED=false

# Advanced-auth admin UI (SSO + SAML settings pages). Purely a
# visibility flag — runtime routes (/auth/sso/..., /auth/saml/...) keep
# working regardless. An org with an already-configured provider still
# surfaces its settings even when this is false. Set true to expose the
# admin surfaces in a fresh install that hasn't wired up a provider yet.
OPSMENDER_ADVANCED_AUTH_ENABLED=false

# Absolute URL the dashboard is reachable at. Used to build invite +
# password-reset links. When unset, links use the request's derived base
# URL — fine for localhost dev, but should be set explicitly in
# production so links arrive intact regardless of the proxy chain.
# OPSMENDER_PUBLIC_BASE_URL=https://opsmender.example.com


# ============================================================
# 5. ACTIVE MODEL PROVIDER  (also editable in the dashboard)
# ============================================================
# These two env vars give the agent a starting model when the DB has
# no saved model config yet. Once you add a model via /dashboard/models
# or `opsmender config model set`, the DB row wins.
#
# Supported providers:
#   anthropic | openai | azure_openai | bedrock | vertex_ai
#   | ollama | openai_compatible
OPSMENDER_MODEL_PROVIDER=ollama

# Model ID to use — must match the chosen provider.
#   anthropic         → claude-sonnet-4-20250514, claude-haiku-4-5-20251001
#   openai            → gpt-4o, gpt-4o-mini, gpt-4.1
#   azure_openai      → your Azure deployment name
#   bedrock           → e.g. anthropic.claude-sonnet-4-6, meta.llama3-1-70b-instruct
#   vertex_ai         → publisher/model — google/gemini-2.5-flash,
#                       anthropic/claude-sonnet-4@20250514
#   ollama            → llama3.2, mistral, codellama, phi3, gemma3
#   openai_compatible → whatever model ID your local runtime serves
#                       (LM Studio, llama.cpp, vLLM, …)
OPSMENDER_MODEL_ID=llama3.2

# Local/self-hosted AI safety valve. Incident sessions are queued behind this
# process-local worker limit so repeated alerts do not make a local Ollama box
# run many workflows at once. Valid range: 1-5. Keep 1 for laptops; raise only
# when your model runtime has the CPU/GPU headroom.
OPSMENDER_INCIDENT_SESSION_CONCURRENCY=1


# ============================================================
# 6. PROVIDER CREDENTIALS  (only fill the providers you use)
# ============================================================

# --- Anthropic ---
ANTHROPIC_API_KEY=your_anthropic_key_here

# --- OpenAI ---
OPENAI_API_KEY=your_openai_key_here

# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=your_azure_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT=your_deployment_name

# --- Ollama (local models) ---
# Use host.docker.internal when running inside Docker Desktop on Windows
# or macOS. Use localhost when running outside Docker.
# On Linux without Docker Desktop, use the docker0 bridge IP (typically
# 172.17.0.1) or add `extra_hosts: ["host.docker.internal:host-gateway"]`
# to the app service in docker-compose.yml.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- AWS Bedrock ---
# Uses the native AWS credential chain (env vars → ~/.aws → IAM role →
# ECS/EKS task role). Region + optional profile are stored per saved
# model config in the DB (see /dashboard/models — Provider: Bedrock).
# No Bedrock-specific env var is read here. Standard AWS vars apply:
#   AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN,
#   AWS_PROFILE, AWS_REGION

# --- GCP Vertex AI ---
# Uses Application Default Credentials (ADC). Project + location are
# stored per saved model config (see /dashboard/models — Provider:
# Vertex AI). Standard GCP vars apply:
#   GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- OpenAI-compatible endpoints (LM Studio, llama.cpp, vLLM, …) ---
# The dashboard / CLI is still the recommended path (one model config
# per provider/version in the DB). These env vars are the fallback for
# operators who want a working agent on a fresh DB without clicking
# through the UI first — set them and OPSMENDER_MODEL_PROVIDER=
# openai_compatible above and the agent boots with this model.
#
# From inside the Docker container, use host.docker.internal on Windows
# / macOS Docker Desktop; on Linux without Docker Desktop use the
# docker0 bridge IP (typically 172.17.0.1).
# OPSMENDER_OPENAI_COMPATIBLE_BASE_URL=http://host.docker.internal:1234/v1
# OPSMENDER_OPENAI_COMPATIBLE_API_KEY_ENV_VAR=


# ============================================================
# 7. PAGING NOTIFICATION CHANNELS  (OPTIONAL — set the ones you use)
# ============================================================
# Read by build_channel_factory() and used by the escalation engine to
# deliver pages. Channels with unset credentials are silently skipped
# (the dispatcher writes an incident_pages row with
# delivery_status='skipped' and reason='channel_unconfigured' so
# operators can see in the audit log which channel was unavailable).

# --- Slack DM (chat.postMessage) ---
# Also needs a bot_connectors row with signing_secret populated for
# Slack interactivity (Ack/Take/Resolve buttons + slash commands).
# OPSMENDER_SLACK_BOT_TOKEN=xoxb-...

# --- Microsoft Teams DM — legacy webhook (MessageCard) ---
# Easiest setup; per-channel webhook URL. Use the Graph option below
# for first-class user DM delivery and richer card interactivity.
# OPSMENDER_TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# --- Microsoft Teams DM — Graph API ---
# When all three are set, the Teams channel uses Microsoft Graph for
# direct-message delivery instead of the legacy webhook. Register an
# Azure AD app with `Chat.ReadWrite` + `User.Read.All` and supply:
# OPSMENDER_TEAMS_GRAPH_TENANT_ID=
# OPSMENDER_TEAMS_GRAPH_CLIENT_ID=
# OPSMENDER_TEAMS_GRAPH_CLIENT_SECRET=

# --- Email (SMTP) ---
# Same SMTP server is reused for invite + password-reset emails
# (see Section 8). Configure host + from address at minimum;
# user/password + TLS are optional.
# OPSMENDER_SMTP_HOST=smtp.example.com
# OPSMENDER_SMTP_PORT=587
# OPSMENDER_SMTP_USER=
# OPSMENDER_SMTP_PASSWORD=
# OPSMENDER_SMTP_FROM=opsmender@example.com
OPSMENDER_SMTP_USE_TLS=true

# --- SMS (Twilio Messages API) ---
# OPSMENDER_TWILIO_ACCOUNT_SID=AC...
# OPSMENDER_TWILIO_AUTH_TOKEN=...
# OPSMENDER_TWILIO_FROM_NUMBER=+15550000000

# --- Voice Call paging (Twilio Programmable Voice) ---
# Voice is a personal-routing delivery medium (channel key "voice"). It reuses
# the Twilio account above. Set a voice-capable from-number (falls back to
# OPSMENDER_TWILIO_FROM_NUMBER). The optional status-callback URL lets Twilio
# report the answered/ack signal back to OpsMender.
# OPSMENDER_TWILIO_VOICE_FROM_NUMBER=+15550000000
# OPSMENDER_TWILIO_VOICE_STATUS_CALLBACK_URL=https://opsmender.example.com/bot-webhooks/<id>

# Public URL for the OpsMender web UI — used to deep-link from Slack
# page cards back to /dashboard/incidents/detail. Omit to drop the
# "View in OpsMender" button from page cards. Note: this is distinct
# from OPSMENDER_PUBLIC_BASE_URL (which is for invite/reset email
# links) — both should be set to the same value in most deployments.
# OPSMENDER_PUBLIC_URL=https://opsmender.example.com


# ============================================================
# 8. SMTP (invite + password-reset email)
# ============================================================
# OpsMender reuses the same OPSMENDER_SMTP_* variables from Section 7
# for invite-link and password-reset email delivery. The copy-paste
# URL returned by the People API route is always the source of truth;
# SMTP is purely best-effort additional delivery.
# (No duplicate vars here — see Section 7 above.)


# ============================================================
# 9. SAML SSO  (OPTIONAL — per-tenant SAML 2.0 SP support)
# ============================================================
# Global SP signing keypair used to sign AuthnRequests and (eventually)
# decrypt encrypted assertions. Generate with:
#   opsmender saml gen-sp-keys
# This writes a self-signed cert + key to stdout in PEM. Copy them into
# your secret store and supply them here as PEM strings (newlines
# escaped as \n is OK; raw newlines also work in .env files when
# wrapped in quotes).
#
# OpsMender does NOT enable SAML for any tenant unless both vars are set.
OPSMENDER_SAML_SP_CERT=
OPSMENDER_SAML_SP_KEY=

# Optional override for the SP entityId. Defaults to
# "<scheme>://<host>/auth/saml/metadata" at request time, which is what
# most IdP setup wizards expect. Override only if you need a stable
# cross-host entityId (e.g. multi-host deployments where the IdP's SP
# metadata is pre-registered).
# OPSMENDER_SAML_SP_ENTITY_ID=https://opsmender.example.com/saml


# ============================================================
# 10. BOT CONNECTOR OAUTH  (OPTIONAL — Slack / Discord install flow)
# ============================================================
# When set, the Bot Connectors modal shows a "Connect to <Platform>"
# button that walks the operator through the provider's OAuth consent
# screen and writes the bot token into the connector automatically.
#
# Register this redirect URI in your Slack / Discord app config:
#   <public_url>/bot-connectors/oauth/<platform>/callback
#
# OAuth populates the bot token only. Signing secrets (Slack
# signing_secret, Discord public_key, etc.) are per-app constants that
# the provider does not return through OAuth — operators must still
# paste those manually in the typed form before webhook signature
# verification will succeed.
#
# Leaving these unset disables the button per platform; operators fall
# back to pasting the bot token directly into the connector form.
OPSMENDER_SLACK_OAUTH_CLIENT_ID=
OPSMENDER_SLACK_OAUTH_CLIENT_SECRET=
OPSMENDER_DISCORD_OAUTH_CLIENT_ID=
OPSMENDER_DISCORD_OAUTH_CLIENT_SECRET=


# ============================================================
# 11. EXTERNAL INCIDENT INGEST
# ============================================================
# Max webhook requests per window per ingest token (0 = disabled).
OPSMENDER_INGEST_RATE_LIMIT=60
OPSMENDER_INGEST_RATE_WINDOW=60

# AI session auto-start is TIER-DRIVEN — no flag needed. When the effective AI
# Autonomy Tier is Tier 0 (Autonomous), an AI session auto-starts the moment an
# incident is created (manual, fire-test, or ingested). Tier 1 / Tier 2 start
# after an Admin/Operator acknowledgment. Dedup-skipped incidents never spawn a
# second session. Set the default tier via the Config page or OPSMENDER_TIER.


# ============================================================
# 12. RELIABILITY / SLA POLLER  (OPTIONAL)
# ============================================================
# Enables the non-AI website/port checker behind Reliability & SLA.
# HTTP targets call the configured endpoint on this interval and
# compare the response code against the target's expected status:
#   expected_status: 200
#   expected_statuses: [200, 204, 404]
#   expected_statuses: "2xx" or "200-299"
# Enabled by default — HTTP/HTTPS targets are checked automatically on the
# interval below (seconds) once the backend starts. Set false to disable the
# background checker (manual "Test check" from the UI still works).
OPSMENDER_SLA_POLLER_ENABLED=true
OPSMENDER_SLA_POLL_INTERVAL_DEFAULT=300


# ============================================================
# 13. DATA RETENTION / GARBAGE COLLECTION
# ============================================================
# Audit entries have a dedicated 02:00 UTC archive/prune job. Retention defaults
# to 90 days. When archival is disabled, expired audit rows are pruned directly.
# When enabled, rows are written as gzip-compressed JSONL objects grouped by
# audit date and deleted only after the S3-compatible upload succeeds.
AUDIT_RETENTION_DAYS=90
AUDIT_ARCHIVE_ENABLED=false
# AUDIT_ARCHIVE_S3_BUCKET=opsmender-audit
# AUDIT_ARCHIVE_S3_PREFIX=audit/
# AUDIT_ARCHIVE_S3_ENDPOINT_URL=https://s3.example.com
# AUDIT_ARCHIVE_AWS_ACCESS_KEY_ID=
# AUDIT_ARCHIVE_AWS_ACCESS_KEY_SECRET=

# The nightly retention scheduler prunes high-volume log tables to
# bound storage growth on long-running deployments. Categories:
#   - audit_entries
#   - ingest_log
#   - incident_memory_recall_log
#   - bot_action_audit
#
# Defaults to ENABLED with a 90-day TTL per category. Operators can
# shorten / extend / disable per category from Config → "Storage &
# retention" in the dashboard. Set this flag false to disable the
# scheduler at process level (the REST API + Config UI still work —
# just no nightly pass runs).
#
# **Memories are NEVER auto-deleted.** They are operator- and agent-
# curated; manage them at /dashboard/memories.
OPSMENDER_RETENTION_ENABLED=true

# ============================================================
# 14. mcp.json TWO-WAY SYNC  (OPTIONAL — Claude Code-compatible mirror)
# ============================================================
# When enabled, OpsMender keeps an on-disk mcp.json file in sync with
# the mcp_servers DB table — UI mutations write to disk, and on
# startup the file is reconciled into the DB (file wins on conflict;
# DB-only servers are preserved).
#
# OAuth tokens and bearer token columns are NEVER serialized to disk.
#
# Default off. Enable with:
OPSMENDER_MCP_JSON_SYNC=false

# Override the file path. Defaults to ~/.opsmender/mcp.json.
# OPSMENDER_MCP_CONFIG_PATH=/path/to/mcp.json

# In multi-tenant deployments, pin sync to one org's servers (otherwise
# the sync target is ambiguous and OpsMender will refuse to sync).
# OPSMENDER_MCP_JSON_ORG_ID=00000000-0000-0000-0000-000000000000


# ============================================================
# 15. CORS
# ============================================================
# Comma-separated allowed origins. Use * for dev; pin to your real
# frontend origin(s) in production.
OPSMENDER_CORS_ORIGINS=*


# ============================================================
# 16. FRONTEND  (Next.js static export wiring)
# ============================================================
# Empty string = frontend calls the backend same-origin (default for
# the single-container Docker image and the PyInstaller binary). Only
# set this when the frontend is hosted on a different origin than the
# backend.
NEXT_PUBLIC_API_URL=


# ============================================================
# 17. DOCKER COMPOSE OVERRIDES
# ============================================================
# Read by docker/docker-compose.yml only — not by the OpsMender app
# itself. Defaults are "opsmender" / "opsmender" / "opsmender", which
# are fine for laptop dev. CHANGE THESE in production — the compose
# file builds OPSMENDER_DATABASE_URL from POSTGRES_PASSWORD, so a
# strong password here is the database password.
# POSTGRES_PASSWORD=change-me-in-production
