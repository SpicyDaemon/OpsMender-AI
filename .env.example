# ============================================================
# AI Incident Manager — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Never commit .env to git
# ============================================================


# ------------------------------------------------------------
# ACTIVE MODEL CONFIG
# ------------------------------------------------------------
# Which provider to use: anthropic | openai | azure_openai | ollama
AIM_MODEL_PROVIDER=ollama

# Model ID to use (must match the provider)
#   anthropic     → claude-sonnet-4-20250514, claude-haiku-4-5-20251001
#   openai        → gpt-4o, gpt-4o-mini
#   azure_openai  → your deployment name
#   ollama        → llama3.2, mistral, codellama, phi3, gemma3
AIM_MODEL_ID=llama3.2


# ------------------------------------------------------------
# OLLAMA (LOCAL MODELS)
# ------------------------------------------------------------
# Use host.docker.internal when running inside Docker Desktop on Windows
# Use localhost when running outside Docker
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Model must be pulled first on your Windows host:
#   ollama pull llama3.2
#   ollama pull mistral
#   ollama pull codellama
OLLAMA_MODEL=llama3.2


# ------------------------------------------------------------
# ANTHROPIC
# ------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_key_here


# ------------------------------------------------------------
# OPENAI
# ------------------------------------------------------------
OPENAI_API_KEY=your_openai_key_here


# ------------------------------------------------------------
# AZURE OPENAI
# ------------------------------------------------------------
AZURE_OPENAI_API_KEY=your_azure_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT=your_deployment_name


# ------------------------------------------------------------
# AIM GENERAL CONFIG
# ------------------------------------------------------------
# Active tier: 0 | 1 | 2 | 3
# Use 2 during development (safe ops only, nothing destructive)
AIM_TIER=2

# Log level: DEBUG | INFO | WARNING | ERROR
AIM_LOG_LEVEL=INFO

# Approval timeout in seconds for Tier 1 requests
AIM_APPROVAL_TIMEOUT_SECONDS=900

# Tier 0 sandbox hard time limits (Sprint 17). Only apply when tier==0.
# Session-level wall clock (asyncio.wait_for around graph.ainvoke).
AIM_TIER0_MAX_SESSION_SECONDS=600
# Per-node wall clock. On timeout the node returns status='timed_out'.
AIM_TIER0_MAX_NODE_SECONDS=120

# Path to skill definition file
AIM_SKILL_DEFINITION=./examples/SKILL.md

# Path to audit log output
AIM_AUDIT_LOG=./logs/audit.jsonl

# Path to the Next.js static export (served by the backend). Leave as the
# default when using the Docker image or `aim` binary; unset or point to a
# non-existent dir during local `next dev` usage.
AIM_FRONTEND_STATIC_DIR=./frontend/out

# Optional temporary CLI-only MCP server config until Sprint 12 UI/DB manager lands
# Example:
# AIM_MCP_SERVERS_JSON=[{"name":"k8s","transport":"stdio","command":"npx","args":["-y","@anthropic/mcp-server-k8s"]}]
AIM_MCP_SERVERS_JSON=[]

# Optional: override the directory containing the node/npx/npm binaries.
# Docker image bundles Node automatically — this is only needed for local or
# binary installs where Node is in a non-standard location.
# AIM_NODE_PATH=/usr/local/bin


# ------------------------------------------------------------
# DATABASE (Phase 2 — API server)
# ------------------------------------------------------------
# PostgreSQL connection string (async driver)
AIM_DATABASE_URL=postgresql+asyncpg://aim:aim@localhost:5432/aim

# Optional overrides for local fallback order when AIM_DATABASE_URL is unset
AIM_LOCAL_POSTGRES_URL=postgresql+asyncpg://aim:aim@localhost:5432/aim
AIM_SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./aim-local.db


# ------------------------------------------------------------
# SAML SSO (Sprint 30 — per-tenant SAML 2.0 SP)
# ------------------------------------------------------------
# Global SP signing keypair used to sign AuthnRequests and (eventually) decrypt
# encrypted assertions. Generate with:
#   aim saml gen-sp-keys
# This writes a self-signed cert + key to stdout in PEM. Copy them into your
# secret store and supply them here as PEM strings (newlines escaped as \n is
# OK; raw newlines also work in .env files when wrapped in quotes).
#
# AIM does NOT enable SAML for any tenant unless both vars are set.
AIM_SAML_SP_CERT=
AIM_SAML_SP_KEY=

# Optional override for the SP entityId. Defaults to "<scheme>://<host>/auth/saml/metadata"
# at request time, which is what most IdP setup wizards expect. Override only
# if you need a stable cross-host entityId (e.g. multi-host deployments where
# the IdP's SP metadata is pre-registered).
# AIM_SAML_SP_ENTITY_ID=https://aim.example.com/saml


# ------------------------------------------------------------
# JWT AUTH (Phase 2 — API server)
# ------------------------------------------------------------
# Secret key for signing JWTs (change this in production!)
AIM_JWT_SECRET=change-me-in-production
AIM_JWT_ALGORITHM=HS256
AIM_JWT_EXPIRE_MINUTES=60


# ------------------------------------------------------------
# CORS (Phase 2 — API server)
# ------------------------------------------------------------
# Comma-separated allowed origins (* for dev)
AIM_CORS_ORIGINS=*


# ------------------------------------------------------------
# FRONTEND (Phase 2 — Next.js static export)
# ------------------------------------------------------------
# Empty string = frontend calls the backend same-origin (default for the
# single-container image and the PyInstaller binary). Only set this when the
# frontend is hosted on a different origin than the backend.
NEXT_PUBLIC_API_URL=


# ------------------------------------------------------------
# INGEST RATE LIMITING (Sprint 14)
# ------------------------------------------------------------
# Max webhook requests per window per ingest token (0 = disabled)
AIM_INGEST_RATE_LIMIT=60
# Window size in seconds
AIM_INGEST_RATE_WINDOW=60
# Optional: auto-start a session for newly created ingested incidents
AIM_INGEST_AUTO_START_ENABLED=false
# Match incidents at or above this severity: critical | high | medium | low
AIM_INGEST_AUTO_START_MIN_SEVERITY=critical
# Optional exact source filter: cloudwatch | azure_monitor | legacy_alert_vendor | legacy_alert_relay | generic
# Leave blank to match any source
AIM_INGEST_AUTO_START_SOURCE=


# ------------------------------------------------------------
# DETECTOR (Sprint 14 — MCP-driven incident detector)
# ------------------------------------------------------------
# Enable the background detector scheduler
AIM_DETECTOR_ENABLED=false
# Max runs per hour for a single detector rule (0 = disabled)
AIM_DETECTOR_MAX_RUNS_PER_HOUR=12
# Global detector run budget per rolling hour across all rules (0 = disabled)
AIM_DETECTOR_BUDGET=500
