# ============================================================
# AI Incident Manager — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Never commit .env to git
# ============================================================


# ------------------------------------------------------------
# ACTIVE MODEL CONFIG
# ------------------------------------------------------------
# Which provider to use: anthropic | openai | azure_openai | ollama
AIM_MODEL_PROVIDER=ollama

# Model ID to use (must match the provider)
#   anthropic     → claude-sonnet-4-20250514, claude-haiku-4-5-20251001
#   openai        → gpt-4o, gpt-4o-mini
#   azure_openai  → your deployment name
#   ollama        → llama3.2, mistral, codellama, phi3, gemma3
AIM_MODEL_ID=llama3.2


# ------------------------------------------------------------
# OLLAMA (LOCAL MODELS)
# ------------------------------------------------------------
# Use host.docker.internal when running inside Docker Desktop on Windows
# Use localhost when running outside Docker
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Model must be pulled first on your Windows host:
#   ollama pull llama3.2
#   ollama pull mistral
#   ollama pull codellama
OLLAMA_MODEL=llama3.2


# ------------------------------------------------------------
# ANTHROPIC
# ------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_key_here


# ------------------------------------------------------------
# OPENAI
# ------------------------------------------------------------
OPENAI_API_KEY=your_openai_key_here


# ------------------------------------------------------------
# AZURE OPENAI
# ------------------------------------------------------------
AZURE_OPENAI_API_KEY=your_azure_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT=your_deployment_name


# ------------------------------------------------------------
# AIM GENERAL CONFIG
# ------------------------------------------------------------
# Active tier: 0 | 1 | 2 | 3
# Use 2 during development (safe ops only, nothing destructive)
AIM_TIER=2

# Log level: DEBUG | INFO | WARNING | ERROR
AIM_LOG_LEVEL=INFO

# Path to skill definition file
AIM_SKILL_DEFINITION=./examples/SKILL.md

# Path to audit log output
AIM_AUDIT_LOG=./logs/audit.jsonl


# ------------------------------------------------------------
# DATABASE (Phase 2 — API server)
# ------------------------------------------------------------
# PostgreSQL connection string (async driver)
AIM_DATABASE_URL=postgresql+asyncpg://aim:aim@localhost:5432/aim


# ------------------------------------------------------------
# JWT AUTH (Phase 2 — API server)
# ------------------------------------------------------------
# Secret key for signing JWTs (change this in production!)
AIM_JWT_SECRET=change-me-in-production
AIM_JWT_ALGORITHM=HS256
AIM_JWT_EXPIRE_MINUTES=60


# ------------------------------------------------------------
# CORS (Phase 2 — API server)
# ------------------------------------------------------------
# Comma-separated allowed origins (* for dev)
AIM_CORS_ORIGINS=*

