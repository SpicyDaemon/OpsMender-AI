---
import Layout from '../layouts/Layout.astro';
import platforms from '../data/platforms.json';
import sources from '../data/sources.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const GITHUB_URL    = 'https://github.com/SpicyDaemon/OpsMender-AI';
const DOCS_URL      = `${GITHUB_URL}#readme`;
const CHANGELOG_URL = `${GITHUB_URL}/blob/main/CHANGELOG.md`;
const RELEASES_URL  = `${GITHUB_URL}/releases`;

const stats = [
  ['v1.1.0', 'current release'],
  ['2,400+', 'automated tests'],
  ['26',     'integration kinds'],
  ['MIT',    'license'],
];

const tiers = [
  {
    num: 0, name: 'Autonomous', color: 'text-red-400', rule: 'bg-red-400',
    desc: 'The agent fixes things on its own: restarts, rollbacks, scaling. It stays inside your skill policy and only makes changes it can undo. Hard time limits apply.',
    note: 'For staging and sandboxes. Shown in red inside the product for a reason.',
  },
  {
    num: 1, name: 'Approval required', color: 'text-amber-400', rule: 'bg-amber-400',
    desc: 'The agent investigates and proposes. Reads happen right away. Anything that writes waits for a person to approve it. Denied tools never run.',
    note: 'The right choice for production.',
  },
  {
    num: 2, name: 'Advisory', color: 'text-ops-blue', rule: 'bg-ops-blue', isDefault: true,
    desc: 'The agent reads, explains, and recommends. It writes nothing. A person carries out every step.',
    note: 'The default for every new install.',
  },
];

const shots = [
  { file: 'incident-detail.png',     title: 'Incident detail',        caption: 'An incident with its AI session, timeline, and alert evidence in one view.' },
  { file: 'incidents-admin.png',     title: 'Incident board',         caption: 'Priority, status, owner, and whether an AI session is running, at a glance.' },
  { file: 'live-session-detail.png', title: 'Live session',           caption: 'Watch the agent work: workflow state, approvals, tool activity, and chat.' },
  { file: 'ai-session.png',          title: 'Tier 0 session',         caption: 'The agent restarted a deployment, confirmed recovery, and recorded how to undo it.' },
  { file: 'tier-0.png',              title: 'Tier 0 outcome',         caption: 'Executed on its own, inside policy, with the compensating action recorded.' },
  { file: 'tier-2.png',              title: 'Tier 2 session',         caption: 'Read only diagnosis and a change plan. Nothing was altered.' },
  { file: 'mcp-skills.png',          title: 'Skill Studio',           caption: 'The policies that decide what the agent may run, per tool and per tier.' },
  { file: 'people-rbac.png',         title: 'People and access',      caption: 'Admins, operators, and viewers, with SSO and TOTP when you want them.' },
  { file: 'settings.png',            title: 'Settings',               caption: 'Session workflow, models, notifications, and workspace guardrails.' },
];

const features = [
  ['Incidents',      'Priorities P0 to P3, deduplication, merging, and a full timeline of who did what and when.'],
  ['Paging',         'Rosters, escalation chains, an on call calendar, and maintenance windows that keep matching alerts quiet.'],
  ['Notifications',  'Slack, Teams, Discord, Telegram, Matrix, email, SMS, and voice calls. Slack, Teams, and Discord get buttons you can act on.'],
  ['AI sessions',    'Start one from any incident. The agent observes, diagnoses, plans, and acts inside the tier you chose.'],
  ['Skills',         'A policy file you own, bound to an MCP server or a native connector. Anything it does not name is denied.'],
  ['Integrations',   'Twenty six kinds, including GitHub, Jira, ServiceNow, Kubernetes, and Sentry. Two way ticket sync for Jira and ServiceNow.'],
  ['Models',         'Bring your own. Anthropic, OpenAI, Azure, Bedrock, Vertex AI, Ollama, or any OpenAI compatible endpoint.'],
  ['Reliability',    'HTTP uptime checks with SLA and SLO tracking and history.'],
  ['Postmortems',    'A structured draft built from the incident and the session. Edit it, save it, export it as Markdown.'],
  ['Analytics',      'Alert noise and response time trends by service and priority, with CSV export.'],
  ['Access',         'Admins, operators, and viewers. Email and password, OIDC, SAML, and TOTP.'],
  ['Runs anywhere',  'One compose file. A Helm chart. Recipes for AWS, Azure, GCP, and OCI. Linux and Windows binaries.'],
];

const whatsNew = [
  ['Sessions without MCP',          'A service covered by native connectors no longer needs an MCP server. Its tools pass through the same gate, approvals, and audit log. If nothing provides tools, the session says so and stays advisory.'],
  ['Skill Studio for both sources', 'Bind a skill to an MCP server or a native connector. Start from a template, pull in the available tools, validate before saving, and see exactly which permissions a change would widen.'],
  ['Discord incident actions',      'Acknowledge, resolve, escalate, or start a session from a Discord message. Every press is signature verified, matched to a linked account, checked for replays, and audited.'],
];
---

<Layout>
  <style is:global>
    .reveal { opacity: 0; transform: translateY(14px); animation: reveal 0.9s cubic-bezier(.2,.7,.2,1) forwards; }
    .reveal-1 { animation-delay: .15s } .reveal-2 { animation-delay: .35s } .reveal-3 { animation-delay: .55s }
    .reveal-4 { animation-delay: .8s }  .reveal-5 { animation-delay: 1s }
    @keyframes reveal { to { opacity: 1; transform: none; } }
    /* The page holds still until the intro hands over. */
    .reveal { animation-play-state: paused; }
    html.ready .reveal { animation-play-state: running; }

    /* Intro: the wordmark arrives, breathes, then widens and dissolves. */
    #intro { transition: opacity .9s ease; }
    #intro.gone { opacity: 0; pointer-events: none; }
    #intro-mark { opacity: 0; transform: scale(.94); filter: blur(6px);
      transition: opacity 1.5s ease, transform 1.5s cubic-bezier(.2,.7,.2,1), filter 1.5s ease; }
    #intro.in #intro-mark { opacity: 1; transform: none; filter: none; animation: breathe 4.5s ease-in-out 1.5s infinite; }
    #intro.out #intro-mark { opacity: 0; transform: scale(1.08); filter: blur(10px); transition-duration: 1s; animation: none; }
    #intro-line { opacity: 0; letter-spacing: .5em; text-indent: .5em;
      transition: opacity 1.3s ease .7s, letter-spacing 1.3s ease .7s; }
    #intro.in #intro-line { opacity: 1; }
    #intro.out #intro-line { opacity: 0; letter-spacing: .95em; transition: opacity .9s ease, letter-spacing .9s ease; }
    @keyframes breathe { 0%,100% { opacity: .78 } 50% { opacity: 1 } }
    .cue { animation: cue 2.2s ease-in-out infinite; }
    @keyframes cue { 0%,100% { transform: translateY(0); opacity:.5 } 50% { transform: translateY(6px); opacity:1 } }

    /* Architecture map. Each node carries its family colour in --c. */
    .arch-edge { fill: none; stroke: #263354; stroke-width: 1.4; transition: stroke .2s, opacity .2s; }
    .arch-flow { fill: none; stroke-width: 1.6; stroke-dasharray: 3 14; stroke-linecap: round; opacity: .5; animation: flow 1.6s linear infinite; transition: opacity .2s; }
    @keyframes flow { to { stroke-dashoffset: -17; } }
    .arch-node { cursor: pointer; outline: none; }
    .arch-node .box { fill: #0d1221; stroke: #1f2a47; stroke-width: 1; transition: stroke .2s, fill .2s, filter .2s; }
    .arch-node .bar { fill: var(--c); opacity: .9; }
    .arch-node text { fill: #e2e8f0; font: 500 13px 'Inter', system-ui, sans-serif; pointer-events: none; }
    .arch-node .sub { fill: #64748b; font-size: 10.5px; font-weight: 400; }
    .arch-node:hover .box, .arch-node:focus-visible .box { stroke: var(--c); fill: #101a30; }
    .arch-node.active .box { stroke: var(--c); fill: #12203a; stroke-width: 1.5; filter: drop-shadow(0 0 10px var(--c)); }
    .arch-node.dim { opacity: .3; }
    .arch-edge.dim, .arch-flow.dim { opacity: .1; }
    .arch-flow.lit { opacity: 1; }
    .dot { display: inline-block; width: 7px; height: 7px; border-radius: 9999px; background: var(--c); }

    /* Dossier */
    .dossier { transform: translateX(105%); transition: transform .35s cubic-bezier(.2,.7,.2,1); }
    .dossier.open { transform: none; }
    @media (max-width: 1023px) {
      .dossier { transform: translateY(105%); }
      .dossier.open { transform: none; }
    }

    @media (prefers-reduced-motion: reduce) {
      .reveal { animation: none; opacity: 1; transform: none; }
      .cue, .arch-flow { animation: none; }
      .dossier { transition: none; }
    }
  </style>

  <div id="intro" class="fixed inset-0 z-[100] flex flex-col items-center justify-center bg-ops-bg" aria-hidden="true">
    <img id="intro-mark" src={`${base}/wordmark.png`} alt="" width="577" height="117" class="w-[min(66vw,520px)]" decoding="async" />
    <p id="intro-line" class="mt-7 text-[clamp(10px,1.3vw,13px)] font-light uppercase text-slate-400">Detect. Mend. Prevail.</p>
  </div>

  <nav class="sticky top-0 z-50 border-b border-ops-border bg-ops-bg/85 backdrop-blur">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-3.5 sm:px-8">
      <a href="#top" class="text-[15px] font-semibold tracking-tight text-slate-50 focus-ring">Ops<span class="text-ops-blue">Mender</span></a>
      <div class="flex items-center gap-1">
        <a href="#map"      class="nav-link hidden sm:inline">How it works</a>
        <a href="#tiers"    class="nav-link hidden sm:inline">Autonomy</a>
        <a href="#screens"  class="nav-link hidden md:inline">Screens</a>
        <a href="#features" class="nav-link hidden md:inline">Features</a>
        <a href="#bring"    class="nav-link hidden lg:inline">Bring your own</a>
        <a href="#install"  class="nav-link hidden sm:inline">Install</a>
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="ml-2 rounded-md border border-ops-border px-3 py-1.5 text-sm text-slate-200 transition-colors hover:border-slate-500 hover:text-white focus-ring">GitHub</a>
      </div>
    </div>
  </nav>

  <!-- OPENING -->
  <header id="top" class="relative flex min-h-[92vh] items-center overflow-hidden">
    <canvas id="field" class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_60%_50%_at_50%_45%,rgba(59,130,246,0.14),transparent_70%)]" aria-hidden="true"></div>
    <div class="relative mx-auto w-full max-w-7xl px-5 py-24 sm:px-8">
      <p class="reveal reveal-1 font-mono text-xs uppercase tracking-[0.2em] text-ops-subtle">Open source · runs on your servers</p>
      <h1 class="mt-6 max-w-4xl text-[2.75rem] font-semibold leading-[1.05] tracking-tight text-slate-50 sm:text-6xl lg:text-7xl">
        <span class="reveal reveal-1 block">Page the right people.</span>
        <span class="reveal reveal-2 block">Let AI investigate.</span>
        <span class="reveal reveal-3 block text-ops-subtle">You decide what runs.</span>
      </h1>
      <p class="reveal reveal-4 mt-8 max-w-2xl text-lg leading-relaxed text-ops-subtle">
        OpsMender is an incident response platform you host yourself. It tracks incidents, pages the
        on call engineer, and can hand an AI agent the tools to investigate and fix things. A gate in
        the backend decides what the agent may actually do, and the model has no say in it.
      </p>
      <div class="reveal reveal-5 mt-9 flex flex-wrap items-center gap-3">
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="rounded-md bg-slate-50 px-5 py-2.5 text-sm font-medium text-ops-bg transition-colors hover:bg-white focus-ring">View on GitHub</a>
        <a href="#map" class="rounded-md border border-ops-border bg-ops-bg/40 px-5 py-2.5 text-sm font-medium text-slate-200 transition-colors hover:border-slate-500 focus-ring">See how it works</a>
      </div>
      <dl class="reveal reveal-5 mt-16 grid max-w-3xl grid-cols-2 gap-8 border-t border-ops-border/70 pt-8 sm:grid-cols-4">
        {stats.map(([value, label]) => (
          <div>
            <dt class="text-2xl font-semibold tracking-tight text-slate-50">{value}</dt>
            <dd class="mt-1 text-sm text-ops-muted">{label}</dd>
          </div>
        ))}
      </dl>
    </div>
    <a href="#map" class="cue absolute bottom-6 left-1/2 -translate-x-1/2 text-ops-muted focus-ring" aria-label="Scroll to how it works">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"/></svg>
    </a>
  </header>

  <!-- ARCHITECTURE MAP -->
  <section id="map" class="scroll-mt-20 border-t border-ops-border">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-24">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.18em] text-ops-muted">How it works</p>
          <h2 class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight text-slate-50 sm:text-4xl">The whole system on one map</h2>
          <p class="mt-4 max-w-2xl text-ops-subtle">Alerts come in on the top row. The agent and its tools sit in the middle. Everything it does is recorded at the bottom. Click any component to open its dossier.</p>
        </div>
        <p class="hidden font-mono text-[11px] text-ops-muted lg:block">click · explore &nbsp; ← → · move &nbsp; esc · close</p>
      </div>

      <div class="relative mt-10">
        <div class="overflow-x-auto rounded-lg border border-ops-border bg-ops-surface/60">
          <svg id="arch" viewBox="0 0 1200 600" class="block min-w-[880px] w-full" role="group" aria-label="OpsMender architecture map"></svg>
        </div>
        <div id="legend" class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-xs text-ops-subtle" aria-label="Component families"></div>

        <aside id="dossier" class="dossier fixed inset-x-0 bottom-0 z-40 max-h-[80vh] overflow-y-auto border-t border-ops-border bg-ops-surface shadow-2xl lg:bottom-0 lg:left-auto lg:right-0 lg:top-[53px] lg:max-h-none lg:w-[400px] lg:border-l lg:border-t-0" aria-live="polite" aria-label="Component details" hidden>
          <div class="sticky top-0 flex items-center justify-between border-b border-ops-border bg-ops-surface px-6 py-4">
            <span id="d-kind" class="font-mono text-[11px] uppercase tracking-[0.18em] text-ops-blue"></span>
            <button id="d-close" class="rounded p-1 text-ops-subtle hover:text-white focus-ring" aria-label="Close">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M6 18 18 6M6 6l12 12"/></svg>
            </button>
          </div>
          <div class="px-6 py-6">
            <h3 id="d-title" class="text-2xl font-semibold tracking-tight text-slate-50"></h3>
            <p id="d-summary" class="mt-3 leading-relaxed text-ops-subtle"></p>
            <h4 class="mt-7 text-[11px] font-semibold uppercase tracking-[0.16em] text-ops-muted">What it does</h4>
            <ul id="d-points" class="mt-3 space-y-2.5 text-sm leading-relaxed text-slate-300"></ul>
            <h4 class="mt-7 text-[11px] font-semibold uppercase tracking-[0.16em] text-ops-muted">In the code</h4>
            <p id="d-code" class="mt-2 font-mono text-xs leading-relaxed text-ops-subtle"></p>
            <h4 class="mt-7 text-[11px] font-semibold uppercase tracking-[0.16em] text-ops-muted">Connected to</h4>
            <div id="d-links" class="mt-3 flex flex-wrap gap-2"></div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- TIERS -->
  <section id="tiers" class="scroll-mt-20 border-t border-ops-border">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-24">
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-ops-muted">Autonomy</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight text-slate-50 sm:text-4xl">Three tiers. One is picked per session.</h2>
      <p class="mt-4 max-w-2xl text-ops-subtle">The tier is enforced in the backend before any tool call runs, so the agent cannot talk its way past it.</p>
      <div class="mt-12 grid gap-px overflow-hidden rounded-lg border border-ops-border bg-ops-border md:grid-cols-3">
        {tiers.map((t) => (
          <div class="relative bg-ops-bg p-7">
            <div class={`absolute inset-x-0 top-0 h-0.5 ${t.rule}`}></div>
            <div class="flex items-baseline justify-between">
              <span class={`font-mono text-sm font-semibold ${t.color}`}>Tier {t.num}</span>
              {t.isDefault && <span class="rounded border border-ops-border px-2 py-0.5 text-[11px] text-ops-subtle">Default</span>}
            </div>
            <h3 class="mt-2 text-xl font-semibold text-slate-50">{t.name}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ops-subtle">{t.desc}</p>
            <p class={`mt-5 text-sm ${t.color}`}>{t.note}</p>
          </div>
        ))}
      </div>

      <div class="mt-10 grid gap-10 lg:grid-cols-2 lg:items-start">
        <div>
          <h3 class="text-xl font-semibold text-slate-50">Skills describe the job. The gate enforces it.</h3>
          <div class="mt-4 space-y-4 text-ops-subtle">
            <p>Every operation in a skill file says what it may do at each tier. That policy is checked in code before a tool call runs. If a prompt injection tells the agent to drop a database, the gate refuses the call. The model never gets a vote.</p>
            <p>Anything the skill does not name is denied. Policy you write can make a connector stricter than its baseline but never looser. Malformed policy is rejected with the line that broke it.</p>
          </div>
        </div>
        <div class="overflow-hidden rounded-lg border border-ops-border bg-ops-surface">
          <div class="flex items-center justify-between border-b border-ops-border px-4 py-2.5">
            <span class="font-mono text-xs text-ops-subtle">SKILL.md</span>
            <span class="font-mono text-[11px] text-ops-muted">excerpt</span>
          </div>
          <pre class="overflow-x-auto p-5 text-[12.5px] leading-relaxed"><code class="text-slate-300">{`tier_policies:
  read: &read
    T0: {enabled: true,  mode: autonomous}
    T1: {enabled: true,  mode: autonomous}
    T2: {enabled: true,  mode: advisory}
  reversible_write: &reversible_write
    T0: {enabled: true,  mode: autonomous, require_reversible: true}
    T1: {enabled: true,  mode: approval}
    T2: {enabled: false, mode: blocked}

operations:
  - tool: get_pod_logs
    classification: safe
    tiers: *read
  - tool: scale_deployment
    classification: caution
    reversible: true
    tiers: *reversible_write
  - tool: exec_*
    deny: true`}</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- SCREENS -->
  <section id="screens" class="scroll-mt-20 border-t border-ops-border">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-24">
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-ops-muted">Product</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-50 sm:text-4xl">What it looks like</h2>
      <p class="mt-4 max-w-2xl text-ops-subtle">Real screens from a seeded workspace. Pick one below, or click the large image to see it at full size.</p>

      <div id="viewer" data-base={base} class="mt-10">
        <button id="v-open" class="block w-full overflow-hidden rounded-lg border border-ops-border bg-ops-surface text-left transition-colors hover:border-slate-500 focus-ring" aria-label="Open screenshot at full size">
          <img id="v-img" src={`${base}/screenshots/${shots[0].file}`} alt={shots[0].title} width="3200" height="2000" class="block w-full" loading="eager" />
        </button>
        <div class="mt-4 flex items-start justify-between gap-6">
          <div>
            <p id="v-title" class="text-base font-semibold text-slate-50">{shots[0].title}</p>
            <p id="v-cap" class="mt-1 text-sm text-ops-subtle">{shots[0].caption}</p>
          </div>
          <p id="v-count" class="shrink-0 font-mono text-xs text-ops-muted">1 / {shots.length}</p>
        </div>
        <div id="v-thumbs" class="mt-6 grid grid-cols-3 gap-3 sm:grid-cols-5 lg:grid-cols-9" role="tablist" aria-label="Screenshots">
          {shots.map((s, i) => (
            <button role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-i={i} data-file={s.file} data-title={s.title} data-cap={s.caption}
              class={`overflow-hidden rounded-md border transition-colors focus-ring ${i === 0 ? 'border-ops-blue' : 'border-ops-border hover:border-slate-500'}`} aria-label={s.title}>
              <img src={`${base}/screenshots/${s.file}`} alt="" width="640" height="400" class="block aspect-[16/10] w-full object-cover object-top" loading="lazy" />
            </button>
          ))}
        </div>
      </div>
    </div>

    <div id="lightbox" class="fixed inset-0 z-[60] hidden items-center justify-center bg-ops-bg/95 p-4 backdrop-blur-sm" role="dialog" aria-modal="true" aria-label="Screenshot">
      <button id="lb-close" class="absolute right-4 top-4 rounded p-2 text-ops-subtle hover:text-white focus-ring" aria-label="Close">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M6 18 18 6M6 6l12 12"/></svg>
      </button>
      <button id="lb-prev" class="absolute left-3 top-1/2 -translate-y-1/2 rounded p-2 text-ops-subtle hover:text-white focus-ring" aria-label="Previous"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m15 6-6 6 6 6"/></svg></button>
      <button id="lb-next" class="absolute right-3 top-1/2 -translate-y-1/2 rounded p-2 text-ops-subtle hover:text-white focus-ring" aria-label="Next"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/></svg></button>
      <figure class="max-h-full max-w-[1600px]">
        <img id="lb-img" src="" alt="" class="max-h-[85vh] w-auto rounded-md border border-ops-border" />
        <figcaption id="lb-cap" class="mt-3 text-center text-sm text-ops-subtle"></figcaption>
      </figure>
    </div>
  </section>

  <!-- FEATURES -->
  <section id="features" class="scroll-mt-20 border-t border-ops-border">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-24">
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-ops-muted">Features</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-50 sm:text-4xl">What comes in the box</h2>
      <p class="mt-4 max-w-2xl text-ops-subtle">Alert intake through to the postmortem. No subscription, and no part of it you cannot read.</p>
      <dl class="mt-12 grid gap-x-12 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
        {features.map(([title, desc]) => (
          <div class="border-t border-ops-border pt-4">
            <dt class="text-sm font-semibold text-slate-50">{title}</dt>
            <dd class="mt-1.5 text-sm leading-relaxed text-ops-subtle">{desc}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- BRING YOUR OWN -->
  <section id="bring" class="scroll-mt-20 border-t border-ops-border">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-24">
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-ops-muted">Bring your own</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight text-slate-50 sm:text-4xl">Your monitoring in. Your chat out.</h2>
      <p class="mt-4 max-w-2xl text-ops-subtle">
        OpsMender does not ask your team to change tools. Point whatever already watches your systems at it,
        and let it page you wherever you already read.
      </p>

      <h3 class="mt-14 text-xl font-semibold text-slate-50">Alerts in from anywhere</h3>
      <p class="mt-2 max-w-2xl text-sm text-ops-subtle">
        Sixteen sources have a parser that understands their payload, including the monitoring services of all four major clouds.
        Anything else can use the generic webhook, or the auto detect intake that works the shape out for you.
      </p>
      <ul class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4" aria-label="Alert sources">
        {sources.map((s) => (
          <li class="flex items-start gap-3.5 rounded-lg border border-ops-border bg-ops-surface/60 p-4 transition-colors hover:border-slate-500">
