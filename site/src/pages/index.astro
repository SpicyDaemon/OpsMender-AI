      <div class="relative mt-10">
        <div class="panel rise hidden overflow-x-auto p-2 sm:block" style="--i:1">
          <svg id="arch" viewBox="0 0 1200 600" class="block min-w-[880px] w-full" role="group" aria-label="OpsMender architecture map"></svg>
