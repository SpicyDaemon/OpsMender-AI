---
import Layout from '../layouts/Layout.astro';
import platforms from '../data/platforms.json';
import sources from '../data/sources.json';
import providers from '../data/providers.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const shot = (file: string) => `${base}/screenshots/${file}`;

const GITHUB_URL    = 'https://github.com/SpicyDaemon/OpsMender-AI';
const DOCS_URL      = `${GITHUB_URL}/blob/main/docs/wiki/README.md`;
const CHANGELOG_URL = `${GITHUB_URL}/blob/main/CHANGELOG.md`;
const RELEASES_URL  = `${GITHUB_URL}/releases`;

const stats = [
  ['1.2',    'current release'],
  ['3,400+', 'automated tests'],
  ['26',     'integration kinds'],
  ['MIT',    'license'],
];

const tiers = [
  {
    num: 0, name: 'Autonomous', tone: 'bg-rose-400', file: 'tier-0.png',
    desc: 'Fixes things on its own: restarts, rollbacks, scaling. Only changes it can undo, inside your policy, with a hard time limit.',
    note: 'For staging and sandboxes.',
  },
  {
    num: 1, name: 'Approval required', tone: 'bg-om-accent', file: 'tier-1.png',
    desc: 'Investigates and proposes. Reads happen right away. Anything that writes waits for a person to approve it.',
    note: 'The right choice for production.',
  },
  {
    num: 2, name: 'Advisory', tone: 'bg-sky-400', file: 'tier-2.png', isDefault: true,
    desc: 'Reads, explains, and recommends. Writes nothing. A person carries out every step.',
    note: 'The default for every new install.',
  },
];

const gallery = [
  { file: 'incident-detail.png',     title: 'Incident detail',   caption: 'An incident with its AI session, timeline, and alert evidence in one view.' },
  { file: 'incidents-admin.png',     title: 'Incident board',    caption: 'Priority, status, owner, and whether an AI session is running, at a glance.' },
  { file: 'live-session-detail.png', title: 'Live session',      caption: 'Workflow state, approvals, tool activity, and chat while the agent works.' },
  { file: 'approvals-pending.png',   title: 'Approvals',         caption: 'Tier 1 proposals wait here with their context until a person decides.' },
  { file: 'mcp-skills.png',          title: 'Skill Studio',      caption: 'The policies that decide what the agent may run, per tool and per tier.' },
  { file: 'people-rbac.png',         title: 'People and access', caption: 'Admins, operators, and viewers, with SSO and TOTP when you want them.' },
  { file: 'settings.png',            title: 'Settings',          caption: 'Session workflow, models, notifications, and workspace guardrails.' },
];

const whatsNew = [
  ['Alert text is data, never orders',
   'Every prompt marks alert text, incident descriptions and tool output as data. Anything that looks like a key or password in tool output is removed before the model sees it. An alert that tries to give the AI instructions is flagged on the incident and never acted on.'],
  ['Keys stay where they belong',
   'A model may only read its own provider\'s key variable, and a local MCP server only sees the environment you give it. Neither can reach the app\'s own secrets.'],
  ['Run more than one copy',
   'Scheduled audits and uptime checks are claimed per row, so several instances behind a load balancer run each job once. A copy that dies hands its work to another.'],
  ['Current foundations',
   'The MCP SDK is at 1.30 with its advisory closed, redirects to another host are refused by name, and every build and release step runs on Node 24.'],
];
---

<Layout>
  <style is:global>
    /* Architecture map. Each node carries its family colour in --c. */
    .arch-edge { fill: none; stroke: #1F3640; stroke-width: 1.4; transition: stroke .2s, opacity .2s; }
    .arch-flow { fill: none; stroke-width: 1.6; stroke-dasharray: 3 14; stroke-linecap: round; opacity: .5; animation: flow 1.6s linear infinite; transition: opacity .2s; }
    @keyframes flow { to { stroke-dashoffset: -17; } }
    .arch-node { cursor: pointer; outline: none; }
    .arch-node .box { fill: #0F2C36; stroke: #1F3640; stroke-width: 1; transition: stroke .2s, fill .2s, filter .2s; }
    .arch-node .bar { fill: var(--c); opacity: .9; }
    .arch-node text { fill: #F5EDD8; font: 500 13px 'Inter', system-ui, sans-serif; pointer-events: none; }
    .arch-node .sub { fill: #9AAEB5; font-size: 10.5px; font-weight: 400; }
    .arch-node:hover .box, .arch-node:focus-visible .box { stroke: var(--c); fill: #142730; }
    .arch-node.active .box { stroke: var(--c); fill: #142730; stroke-width: 1.5; filter: drop-shadow(0 0 10px var(--c)); }
    .arch-node.dim { opacity: .3; }
    .arch-edge.dim, .arch-flow.dim { opacity: .1; }
    .arch-flow.lit { opacity: 1; }
    .dot { display: inline-block; width: 7px; height: 7px; border-radius: 9999px; background: var(--c); }
    .dossier { transform: translateX(105%); transition: transform .35s cubic-bezier(.2,.7,.2,1); }
    .dossier.open { transform: none; }
    @media (max-width: 1023px) {
      .dossier { transform: translateY(105%); }
      .dossier.open { transform: none; }
    }
    @media (prefers-reduced-motion: reduce) {
      .arch-flow { animation: none; }
      .dossier { transition: none; }
    }
  </style>

  <nav class="fixed inset-x-0 top-0 z-50 border-b border-om-border/60 bg-om-bg/70 backdrop-blur-md">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3 sm:px-8">
      <a href="#top" class="text-[15px] font-semibold tracking-tight text-om-cream focus-ring">Ops<span class="text-om-accent">Mender</span></a>
      <div class="flex items-center gap-1">
        <a href="#detect"   class="nav-link hidden sm:inline">Product</a>
        <a href="#tiers"    class="nav-link hidden sm:inline">Autonomy</a>
        <a href="#bring"    class="nav-link hidden md:inline">Integrations</a>
        <a href="#new"      class="nav-link hidden md:inline">What's new</a>
        <a href="#install"  class="nav-link hidden sm:inline">Install</a>
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="btn btn-ghost ml-2 !px-4 !py-1.5 text-sm">GitHub</a>
      </div>
    </div>
  </nav>

  <!-- HERO -->
  <header id="top" class="relative overflow-hidden pt-32 sm:pt-40">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_70%_45%_at_50%_0%,rgba(15,44,54,0.9),transparent_70%)]" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-5 text-center sm:px-8">
      <p class="eyebrow rise">Open source · self hosted · your model</p>
      <h1 class="display rise mx-auto mt-6 max-w-5xl text-[3.25rem] text-om-cream sm:text-7xl lg:text-[6.5rem]">
        Detect. Mend. <span class="text-om-accent">Prevail.</span>
      </h1>
      <p class="rise rise-late mx-auto mt-8 max-w-2xl text-lg leading-relaxed text-om-muted sm:text-xl">
        Incident response you run on your own servers. OpsMender tracks incidents, pages the right people,
        and lets an AI agent investigate and fix things within limits you set in code.
      </p>
      <div class="rise rise-late mt-10 flex flex-wrap items-center justify-center gap-3">
        <a href="#install" class="btn btn-primary">Get started</a>
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">View on GitHub</a>
      </div>
    </div>
    <div class="relative mx-auto mt-16 max-w-6xl px-5 sm:px-8">
      <figure class="rise rise-late overflow-hidden rounded-2xl bg-om-elevated shadow-frame">
        <img src={shot('incidents-list.png')} alt="The incident command center: a list of incidents with priority, status, owner, and whether an AI session is running" width="3200" height="2000" class="block w-full" loading="eager" fetchpriority="high" />
      </figure>
    </div>
    <dl class="relative mx-auto mt-14 grid max-w-4xl grid-cols-2 gap-8 px-5 text-center sm:grid-cols-4 sm:px-8">
      {stats.map(([value, label]) => (
        <div class="rise">
          <dt class="headline text-3xl text-om-cream">{value}</dt>
          <dd class="mt-1 text-sm text-om-muted">{label}</dd>
        </div>
      ))}
    </dl>
  </header>

  <!-- DETECT -->
  <section id="detect" class="scroll-mt-24 py-28 sm:py-40">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 sm:px-8 lg:grid-cols-12 lg:gap-16">
      <div class="rise lg:col-span-5">
        <p class="eyebrow">Detect</p>
        <h2 class="headline mt-4 text-4xl text-om-cream sm:text-5xl">Every alert lands in one place.</h2>
        <p class="mt-6 text-lg leading-relaxed text-om-muted">
          Sixteen monitoring sources have a parser that understands their payload, and a generic webhook takes
          the rest. A re-firing alert updates the incident it already opened. Similar alerts on a service fold into
          the open incident instead of paging again. Maintenance windows keep matching alerts quiet.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-om-muted">
          Priorities P0 to P3, deduplication, combining duplicates, and a timeline of who did what and when.
        </p>
      </div>
      <figure class="rise rise-late overflow-hidden rounded-2xl bg-om-elevated shadow-lift lg:col-span-7">
        <img src={shot('incidents-admin.png')} alt="The incident board with priority, status, owner, and AI session columns" width="3200" height="2000" class="block w-full" loading="lazy" />
      </figure>
    </div>
  </section>

  <!-- PAGE -->
  <section class="py-28 sm:py-40">
    <div class="mx-auto max-w-6xl px-5 text-center sm:px-8">
      <p class="eyebrow rise">Page</p>
      <h2 class="headline rise mx-auto mt-4 max-w-3xl text-4xl text-om-cream sm:text-5xl">The right person, wherever they already are.</h2>
      <p class="rise rise-late mx-auto mt-6 max-w-measure text-lg leading-relaxed text-om-muted">
        Rosters with rotations and one click coverage overrides. Escalation chains that keep going until someone
        acknowledges. A time zone aware on call calendar. Twenty ways to reach people, and in Slack, Teams, and
        Discord the message carries buttons: acknowledge, resolve, escalate, or start a session without leaving the chat.
      </p>
      <ul class="rise rise-late mx-auto mt-12 flex max-w-4xl flex-wrap justify-center gap-2" aria-label="Notification platforms">
        {platforms.map((p) => (
          <li class="flex items-center gap-2.5 rounded-full border border-om-border bg-om-brand/40 py-2 pl-2.5 pr-4 text-sm text-om-cream">
            <span class="shrink-0 [&>svg]:h-5 [&>svg]:w-5" set:html={p.svg} />
            <span>{p.name}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- MEND -->
  <section id="mend" class="scroll-mt-24 py-28 sm:py-40">
    <div class="mx-auto max-w-6xl px-5 text-center sm:px-8">
      <p class="eyebrow rise">Mend</p>
      <h2 class="headline rise mx-auto mt-4 max-w-3xl text-4xl text-om-cream sm:text-5xl">Start a session. Watch it work.</h2>
      <p class="rise rise-late mx-auto mt-6 max-w-measure text-lg leading-relaxed text-om-muted">
        An AI session is a structured workflow, not a free running chat: observe, diagnose, plan, gate, act, report.
        Operators watch it live, talk to it, approve or reject what it proposes, and stop it at any time. It reaches
        your systems through MCP servers you run or through built in connectors, and remembers what past incidents taught.
      </p>
    </div>
    <div class="mx-auto mt-14 max-w-6xl px-5 sm:px-8">
      <figure class="rise rise-late overflow-hidden rounded-2xl bg-om-elevated shadow-frame">
        <img src={shot('live-session-detail.png')} alt="A live AI session with its workflow state, approvals, tool activity, and chat" width="3200" height="2000" class="block w-full" loading="lazy" />
      </figure>
    </div>
  </section>

  <!-- TIERS -->
  <section id="tiers" class="scroll-mt-24 py-28 sm:py-40">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="text-center">
        <p class="eyebrow rise">Autonomy</p>
        <h2 class="headline rise mx-auto mt-4 max-w-3xl text-4xl text-om-cream sm:text-5xl">Three tiers. You pick one per session.</h2>
        <p class="rise rise-late mx-auto mt-6 max-w-measure text-lg leading-relaxed text-om-muted">
          The tier is checked in the backend before any tool call runs. The model cannot talk its way past it.
        </p>
      </div>
      <div class="mt-16 grid gap-6 md:grid-cols-3">
        {tiers.map((t) => (
          <article class="rise overflow-hidden rounded-2xl border border-om-border bg-om-brand/30">
            <img src={shot(t.file)} alt={`A Tier ${t.num} session`} width="3200" height="2000" class="block aspect-[16/10] w-full object-cover object-top" loading="lazy" />
            <div class="p-6">
              <div class="flex items-center gap-2.5">
                <span class={`h-2.5 w-2.5 rounded-full ${t.tone}`}></span>
                <span class="font-mono text-xs uppercase tracking-[0.16em] text-om-muted">Tier {t.num}</span>
                {t.isDefault && <span class="ml-auto rounded-full border border-om-border px-2 py-0.5 text-[11px] text-om-muted">Default</span>}
              </div>
              <h3 class="mt-3 text-xl font-semibold text-om-cream">{t.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-om-muted">{t.desc}</p>
              <p class="mt-4 text-sm text-om-cream">{t.note}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- GATE -->
  <section id="gate" class="scroll-mt-24 py-28 sm:py-40">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 sm:px-8 lg:grid-cols-2 lg:gap-16">
      <div class="rise">
        <p class="eyebrow">The gate</p>
        <h2 class="headline mt-4 text-4xl text-om-cream sm:text-5xl">The model never gets a vote.</h2>
        <p class="mt-6 text-lg leading-relaxed text-om-muted">
          A Skill is a file you own. It says, for every tool, what may happen at each tier: run on its own, wait for
          approval, advise only, or never. Anything the file does not name is denied. A deny list wins everywhere.
          General purpose command tools are held back unless you opt them in.
        </p>
        <ul class="mt-8 space-y-4 text-om-muted">
          <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-om-accent"></span><span>Alert text and tool output reach the model as data, never as instructions.</span></li>
          <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-om-accent"></span><span>Keys, tokens, and passwords in tool output are removed before anything sees them.</span></li>
          <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-om-accent"></span><span>An alert that tries to give the AI orders is flagged on the incident. A person decides, with that warning in front of them.</span></li>
        </ul>
      </div>
      <div class="rise rise-late overflow-hidden rounded-2xl border border-om-border bg-om-brand/40 shadow-lift">
        <div class="flex items-center justify-between border-b border-om-border px-5 py-3">
          <span class="font-mono text-xs text-om-muted">SKILL.md</span>
          <span class="font-mono text-[11px] text-om-muted">excerpt</span>
        </div>
        <pre class="overflow-x-auto p-6 text-[12.5px] leading-relaxed"><code class="text-om-cream">{`tier_policies:
  read: &read
    T0: {enabled: true,  mode: autonomous}
    T1: {enabled: true,  mode: autonomous}
    T2: {enabled: true,  mode: advisory}
  reversible_write: &reversible_write
    T0:
      enabled: true
      mode: autonomous
      require_reversible: true
    T1: {enabled: true,  mode: approval}
    T2: {enabled: false, mode: blocked}

operations:
  - tool: get_pod_logs
    classification: safe
    tiers: *read
  - tool: scale_deployment
    classification: caution
    reversible: true
    tiers: *reversible_write
  - tool: exec_*
    deny: true`}</code></pre>
      </div>
    </div>
  </section>

  <!-- PREVAIL -->
  <section id="prevail" class="scroll-mt-24 py-28 sm:py-40">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 sm:px-8 lg:grid-cols-12 lg:gap-16">
      <figure class="rise overflow-hidden rounded-2xl bg-om-elevated shadow-lift lg:col-span-7">
        <img src={shot('incident-detail.png')} alt="An incident with its timeline, AI session, and alert evidence" width="3200" height="2000" class="block w-full" loading="lazy" />
      </figure>
      <div class="rise rise-late lg:col-span-5">
        <p class="eyebrow">Prevail</p>
        <h2 class="headline mt-4 text-4xl text-om-cream sm:text-5xl">The record writes itself.</h2>
        <p class="mt-6 text-lg leading-relaxed text-om-muted">
          Every tool call, gate decision, approval, and session event is in the audit log with who or what caused it.
          A postmortem draft is built from the incident and the session, ready to edit and export. Findings from
          earlier incidents come back into new sessions on the same service.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-om-muted">
          Uptime checks with SLA and SLO tracking, and alert noise and response time trends by service and priority.
        </p>
      </div>
    </div>
  </section>

  <!-- BRING YOUR OWN -->
  <section id="bring" class="scroll-mt-24 py-28 sm:py-40">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="text-center">
        <p class="eyebrow rise">Bring your own</p>
        <h2 class="headline rise mx-auto mt-4 max-w-3xl text-4xl text-om-cream sm:text-5xl">Your monitoring. Your model. Your servers.</h2>
        <p class="rise rise-late mx-auto mt-6 max-w-measure text-lg leading-relaxed text-om-muted">
          There is no OpsMender model and no inference bill from us. Connect an account you already have; the key
          stays in your deployment and prompts go straight from your server to the provider you chose. Run Ollama
          and nothing leaves the machine.
        </p>
      </div>

      <div class="mt-16 grid gap-12 lg:grid-cols-2">
        <div class="rise">
          <h3 class="text-xl font-semibold text-om-cream">Alerts in from</h3>
          <ul class="mt-5 grid gap-3 sm:grid-cols-2" aria-label="Alert sources">
            {sources.map((s) => (
              <li class="flex items-center gap-3 rounded-xl border border-om-border bg-om-brand/30 p-3.5">
                <span class="shrink-0 text-om-cream [&>svg]:h-6 [&>svg]:w-6" set:html={s.svg} />
                <span class="min-w-0">
                  <span class="block text-sm font-medium text-om-cream">{s.name}</span>
                  <span class="block text-xs leading-snug text-om-muted">{s.note}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rise rise-late">
          <h3 class="text-xl font-semibold text-om-cream">Models from</h3>
          <ul class="mt-5 grid gap-3 sm:grid-cols-2" aria-label="Model providers">
            {providers.map((m) => (
              <li class="flex items-center gap-3 rounded-xl border border-om-border bg-om-brand/30 p-3.5">
                <span class="shrink-0 text-om-cream [&>svg]:h-6 [&>svg]:w-6" set:html={m.svg} />
                <span class="min-w-0">
                  <span class="block text-sm font-medium text-om-cream">{m.name}</span>
                  <span class="block text-xs leading-snug text-om-muted">{m.note}</span>
                </span>
              </li>
            ))}
          </ul>
          <p class="mt-6 text-sm leading-relaxed text-om-muted">
            Twenty six built in connectors as well, including GitHub, GitLab, Jira, ServiceNow, Kubernetes, Sentry,
            Argo CD and Terraform Cloud, with two way ticket sync for Jira and ServiceNow. Any MCP server you care to run.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT'S NEW -->
  <section id="new" class="scroll-mt-24 py-28 sm:py-40">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="text-center">
        <p class="eyebrow rise">Version 1.2</p>
        <h2 class="headline rise mx-auto mt-4 max-w-3xl text-4xl text-om-cream sm:text-5xl">What's new</h2>
        <p class="rise rise-late mx-auto mt-6 max-w-measure text-lg leading-relaxed text-om-muted">
          Four things worth knowing about. The <a href={CHANGELOG_URL} target="_blank" rel="noopener noreferrer" class="text-om-cream underline decoration-om-border underline-offset-4 hover:decoration-om-accent focus-ring">changelog</a> has the rest.
        </p>
      </div>
      <ol class="mt-14 grid gap-6 md:grid-cols-2">
        {whatsNew.map(([title, desc], i) => (
          <li class="rise rounded-2xl border border-om-border bg-om-brand/30 p-7">
            <span class="font-mono text-sm text-om-accent">0{i + 1}</span>
            <h3 class="mt-3 text-xl font-semibold text-om-cream">{title}</h3>
            <p class="mt-3 leading-relaxed text-om-muted">{desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- SCREENS -->
  <section id="screens" class="scroll-mt-24 py-28 sm:py-40">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="text-center">
        <p class="eyebrow rise">Product</p>
        <h2 class="headline rise mx-auto mt-4 max-w-3xl text-4xl text-om-cream sm:text-5xl">Every screen, as it ships.</h2>
        <p class="rise rise-late mx-auto mt-6 max-w-measure text-lg leading-relaxed text-om-muted">Real screens from a seeded workspace. Pick one, or open it at full size.</p>
      </div>
      <div id="viewer" data-base={base} class="rise rise-late mt-14">
        <button id="v-open" class="block w-full overflow-hidden rounded-2xl bg-om-elevated text-left shadow-frame focus-ring" aria-label="Open screenshot at full size">
          <img id="v-img" src={shot(gallery[0].file)} alt={gallery[0].title} width="3200" height="2000" class="block w-full" loading="lazy" />
        </button>
        <div class="mt-5 flex items-start justify-between gap-6">
          <div>
            <p id="v-title" class="text-base font-semibold text-om-cream">{gallery[0].title}</p>
            <p id="v-cap" class="mt-1 text-sm text-om-muted">{gallery[0].caption}</p>
          </div>
          <p id="v-count" class="shrink-0 font-mono text-xs text-om-muted">1 / {gallery.length}</p>
        </div>
        <div id="v-thumbs" class="mt-6 grid grid-cols-4 gap-3 sm:grid-cols-7" role="tablist" aria-label="Screenshots">
          {gallery.map((s, i) => (
            <button role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-i={i} data-file={s.file} data-title={s.title} data-cap={s.caption}
              class={`overflow-hidden rounded-lg border transition-colors focus-ring ${i === 0 ? 'border-om-accent' : 'border-om-border hover:border-om-muted'}`} aria-label={s.title}>
              <img src={shot(s.file)} alt="" width="640" height="400" class="block aspect-[16/10] w-full object-cover object-top" loading="lazy" />
            </button>
          ))}
        </div>
      </div>
    </div>

    <div id="lightbox" class="fixed inset-0 z-[60] hidden items-center justify-center bg-om-bg/95 p-4 backdrop-blur-sm" role="dialog" aria-modal="true" aria-label="Screenshot">
      <button id="lb-close" class="absolute right-4 top-4 rounded p-2 text-om-muted hover:text-om-cream focus-ring" aria-label="Close">
