                <!-- Scene 1: the incident card in the channel, with its buttons -->
                <div class="sc sc-alert">
                  <div class="chat-head"><span class="chat-hash">#</span>payments-incidents</div>
                  <div class="chat-old"><span class="chat-line w-3/4"></span><span class="chat-line w-1/2"></span></div>
                  <div class="msg">
                    <div class="msg-head"><span class="msg-avatar">O</span><span class="msg-name">OpsMender</span><span class="msg-app">APP</span><span class="msg-time">7:48 PM</span></div>
