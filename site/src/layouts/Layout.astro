---
export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'OpsMender: incident response on your own servers',
  description = 'Open source incident response you run yourself. It tracks incidents, pages the right people, and lets an AI agent investigate and fix things within limits enforced in code.',
  ogImage,
} = Astro.props;
---
<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A1418" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <style is:global>
      :root {
        --font-sans: 'Inter', system-ui, sans-serif;
        --font-mono: 'JetBrains Mono', 'Fira Code', monospace;
      }
      * { box-sizing: border-box; }
      html { background-color: #0A1418; }
      body {
        font-family: var(--font-sans);
        background-color: #0A1418;
        color: #F5EDD8;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
      }
      code, pre, kbd, .font-mono { font-family: var(--font-mono); }
      ::selection { background: rgba(232,181,71,0.35); color: #fff; }
      ::-webkit-scrollbar { width: 6px; height: 6px; }
      ::-webkit-scrollbar-track { background: #0A1418; }
      ::-webkit-scrollbar-thumb { background: #1F3640; border-radius: 3px; }
      ::-webkit-scrollbar-thumb:hover { background: #2A4652; }

      /* Headlines: tight, large, the way a product page should read. */
      .display { letter-spacing: -0.03em; line-height: 0.98; font-weight: 600; }
      .headline { letter-spacing: -0.025em; line-height: 1.05; font-weight: 600; }
      .eyebrow { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.18em; text-transform: uppercase; color: #E8B547; }

      .nav-link {
        border-radius: 9999px;
        padding: 0.375rem 0.75rem;
        font-size: 0.875rem;
        line-height: 1.25rem;
        color: #9AAEB5;
        transition: color 150ms ease, background-color 150ms ease;
      }
      .nav-link:hover { color: #F5EDD8; background-color: rgba(245,237,216,0.06); }

      .btn { display: inline-flex; align-items: center; gap: .5rem; border-radius: 9999px; padding: .75rem 1.375rem; font-size: .9375rem; font-weight: 500; transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease, transform 150ms ease; }
      .btn:active { transform: translateY(1px); }
      .btn-primary { background: #E8B547; color: #0A1418; }
      .btn-primary:hover { background: #F5C861; }
      .btn-ghost { border: 1px solid #1F3640; color: #F5EDD8; }
      .btn-ghost:hover { border-color: #9AAEB5; }

      .focus-ring:focus-visible, .btn:focus-visible, .nav-link:focus-visible {
        outline: 2px solid #E8B547;
        outline-offset: 3px;
      }

      /* Scroll reveal: content rises into place once, as it enters the viewport. */
      .rise { opacity: 0; transform: translateY(22px); transition: opacity .8s cubic-bezier(.2,.7,.2,1), transform .8s cubic-bezier(.2,.7,.2,1); }
      .rise.in { opacity: 1; transform: none; }
      .rise-late { transition-delay: .15s; }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .rise { opacity: 1; transform: none; transition: none; }
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <slot />
    <script>
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
      document.querySelectorAll('.rise').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
