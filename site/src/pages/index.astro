---
import Layout from '../layouts/Layout.astro';
import platforms from '../data/platforms.json';
import sources from '../data/sources.json';
import providers from '../data/providers.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const shot = (file: string) => `${base}/screenshots/${file}`;

const GITHUB_URL    = 'https://github.com/SpicyDaemon/OpsMender-AI';
const DOCS_URL      = `${GITHUB_URL}/blob/main/docs/wiki/README.md`;
const CHANGELOG_URL = `${GITHUB_URL}/blob/main/CHANGELOG.md`;
const RELEASES_URL  = `${GITHUB_URL}/releases`;

const stats = [
  { value: 3500, suffix: '+', label: 'automated tests' },
  { value: 26,   suffix: '',  label: 'integration kinds' },
  { value: 20,   suffix: '',  label: 'notification platforms' },
  { value: 16,   suffix: '',  label: 'alert sources parsed' },
];

// Each step shows the whole screen, then zooms to one spot (fx, fy as % of the image, w and h the ring size) and says what to look at.
const steps = [
  { title: 'Every alert lands in one place', file: 'incidents-admin.png', fx: 37.5, fy: 69.5, w: 34, h: 10, s: 2.8,
    look: 'This alert opened the incident by itself. The amber tag means an AI session is already on it.',
    desc: 'Sixteen sources have a parser. A re-firing alert updates the incident it already opened, similar alerts fold in, and maintenance windows keep matching alerts quiet.' },
  { title: 'The agent investigates', file: 'live-session-detail.png', fx: 48.5, fy: 38, w: 22, h: 8, s: 3.0,
    look: 'The agent observed, diagnosed and planned, then stopped at the gate to wait for a person.',
    desc: 'Observe, diagnose, plan, gate, act, report. Operators watch it live, chat with it, and stop it at any time. Reads happen right away; writes wait at the gate.' },
  { title: 'A person decides', file: 'approvals-pending.png', fx: 80, fy: 35, w: 38, h: 10, s: 2.5,
    look: 'One request, with its tier, the time left, and the Approve and Reject buttons.',
    desc: 'Proposals sit in the approval inbox with their reasoning and the exact command. Approve, redirect, or deny. Everything lands in the audit log either way.' },
];

// What the gate does with a request at each tier, in plain words.
const CHIP: Record<string, string> = { runs: 'Runs', undo: 'Runs, can undo', approval: 'Waits for approval', advise: 'Suggests only', never: 'Never' };
const policyRows: { ask: string; tiers: (keyof typeof CHIP)[] }[] = [
  { ask: 'Read the logs of a pod',          tiers: ['runs', 'runs', 'runs'] },
  { ask: 'Restart a deployment',            tiers: ['undo', 'approval', 'advise'] },
  { ask: 'Scale a service up',              tiers: ['undo', 'approval', 'advise'] },
  { ask: 'Delete a namespace',              tiers: ['never', 'never', 'never'] },
  { ask: 'Run an arbitrary shell command',  tiers: ['never', 'never', 'never'] },
];

const tiers = [
  { num: '0', name: 'Autonomous', tone: 'bg-red-400', file: 'tier-0.png',
    desc: 'Fixes things on its own: restarts, rollbacks, scaling. Only changes it can undo, inside your policy, with a hard time limit.', note: 'For staging and sandboxes.',
    caption: 'A Tier 0 session restarted the deployment, confirmed recovery, and recorded how to undo it.' },
  { num: '1', name: 'Approval required', tone: 'bg-amber-400', file: 'tier-1.png',
    desc: 'Investigates and proposes. Reads happen right away. Anything that writes waits for a person to approve it.', note: 'The right choice for production.',
    caption: 'A Tier 1 session stopped at the gate. Its request is waiting in the approval inbox.' },
  { num: '2', name: 'Advisory', tone: 'bg-ops-blue', file: 'tier-2.png', isDefault: true,
    desc: 'Reads, explains, and recommends. Writes nothing. A person carries out every step.', note: 'The default for every new install.',
    caption: 'A Tier 2 session read, explained, and recommended a plan. Nothing was changed.' },
];

const gatePoints = [
  { num: '01', title: 'Policy you own', desc: 'A Skill file says, for every tool, what may happen at each tier: run on its own, wait for approval, advise only, or never. Anything it does not name is denied.' },
  { num: '02', title: 'Enforced in code', desc: 'The check runs in the backend before any tool call, in order: the deny list, the generic command guard, the per tier policy, the Tier 0 reversibility floor. The model never gets a vote.' },
  { num: '03', title: 'Alert text is data', desc: 'Alert text and tool output reach the model as data, never as instructions. Keys and passwords in tool output are removed. An alert that tries to give the agent orders is flagged for the person who decides.' },
];

const whatsNew = [
  ['Qwen, DeepSeek and Kimi by name',   'Pick them on the Models page and put the key in .env. There is no base URL to type, and each one connects only to its vendor\'s hosts.'],
  ['LM Studio as a local provider',     'Pick LM Studio by name. It needs no key and connects to its default local address unless you name another. The new model form shows the default URL for LM Studio, Qwen, DeepSeek and Kimi, so you type one only when yours differs.'],
  ['Cards that say who holds it',       'Slack, Teams and Discord cards name the responder and who acknowledged. After an acknowledge or resolve from chat, Slack and Discord edit the card in place and drop Acknowledge, and Teams, which cannot edit a posted card, posts a fresh one without it.'],
  ['Slack answers who pressed',         'Press a Slack button and the result comes back in a message only you can see, once the action is saved. Slack never showed the old reply.'],
];

const shots = [
  { file: 'incident-detail.png',     title: 'Incident detail',   caption: 'An incident with its AI session, timeline, and alert evidence in one view.' },
  { file: 'incidents-admin.png',     title: 'Incident board',    caption: 'Priority, status, owner, and whether an AI session is running, at a glance.' },
  { file: 'live-session-detail.png', title: 'Live session',      caption: 'Watch the agent work: workflow state, approvals, tool activity, and chat.' },
  { file: 'ai-session.png',          title: 'Tier 0 session',    caption: 'The agent restarted a deployment, confirmed recovery, and recorded how to undo it.' },
  { file: 'tier-2.png',              title: 'Tier 2 session',    caption: 'Read only diagnosis and a change plan. Nothing was altered.' },
  { file: 'mcp-skills.png',          title: 'Skill Studio',      caption: 'The policies that decide what the agent may run, per tool and per tier.' },
  { file: 'people-rbac.png',         title: 'People and access', caption: 'Admins, operators, and viewers, with SSO and TOTP when you want them.' },
  { file: 'settings.png',            title: 'Settings',          caption: 'Session workflow, models, notifications, and workspace guardrails.' },
];

const marquee = [...platforms, ...sources];
---

<Layout>
  <style is:global>
    /* Intro: the wordmark arrives, breathes, then widens and dissolves. */
    .reveal { opacity: 0; transform: translateY(14px); animation: reveal 0.9s var(--ease-fluid) forwards; }
    .reveal-1 { animation-delay: .15s } .reveal-2 { animation-delay: .35s } .reveal-3 { animation-delay: .55s }
    .reveal-4 { animation-delay: .8s }  .reveal-5 { animation-delay: 1s }
    @keyframes reveal { to { opacity: 1; transform: none; } }
    .reveal { animation-play-state: paused; }
    html.ready .reveal { animation-play-state: running; }
    #intro { transition: opacity .9s ease; }
    #intro.gone { opacity: 0; pointer-events: none; }
    #intro-mark { opacity: 0; transform: scale(.94); filter: blur(6px);
      transition: opacity 1.5s ease, transform 1.5s var(--ease-fluid), filter 1.5s ease; }
    #intro.in #intro-mark { opacity: 1; transform: none; filter: none; animation: breathe 4.5s ease-in-out 1.5s infinite; }
    #intro.out #intro-mark { opacity: 0; transform: scale(1.08); filter: blur(10px); transition-duration: 1s; animation: none; }
    #intro-line { opacity: 0; letter-spacing: .5em; text-indent: .5em;
      transition: opacity 1.3s ease .7s, letter-spacing 1.3s ease .7s; }
    #intro.in #intro-line { opacity: 1; }
    #intro.out #intro-line { opacity: 0; letter-spacing: .95em; transition: opacity .9s ease, letter-spacing .9s ease; }
    @keyframes breathe { 0%,100% { opacity: .78 } 50% { opacity: 1 } }

    /* The nav: plain at the top, a floating pill once you scroll. */
    #nav { position: fixed; top: 0; left: 50%; transform: translateX(-50%); z-index: 50; width: 100%; max-width: 1280px; padding: 14px 24px; border-radius: 0; background: transparent; border: 1px solid transparent;
      transition: width .65s var(--ease-fluid), max-width .65s var(--ease-fluid), top .65s var(--ease-fluid), padding .65s var(--ease-fluid), border-radius .65s var(--ease-fluid), background-color .45s var(--ease-fade), border-color .45s var(--ease-fade), backdrop-filter .45s var(--ease-fade); }
    #nav.floating { top: 14px; width: calc(100% - 32px); max-width: 920px; padding: 8px 10px 8px 18px; border-radius: 9999px; background: rgba(13,18,33,0.82); border-color: #1a2540; backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); box-shadow: 0 20px 60px -30px rgba(0,0,0,0.8); }

    /* Zoom cards: the whole screen first, then a slow push in to one spot with a note. */
    .zoom { cursor: zoom-in; }
    .zoom.focus { cursor: zoom-out; }
    .zoom-stage { position: absolute; inset: 0; transform-origin: var(--fx) var(--fy); transition: transform 1.6s var(--ease-fluid); }
    .zoom.focus .zoom-stage { transform: translate(var(--tx), var(--ty)) scale(var(--s)); }
    .zoom-ring { position: absolute; transform: translate(-50%, -50%); border: 1.5px solid #fbbf24; border-radius: 8px; opacity: 0;
      box-shadow: 0 0 0 9999px rgba(7,9,15,0); transition: opacity .7s var(--ease-fade) .8s, box-shadow .7s var(--ease-fade) .8s; }
    .zoom.focus .zoom-ring { opacity: 1; box-shadow: 0 0 0 9999px rgba(7,9,15,.5), 0 0 20px rgba(251,191,36,.35); }
    .zoom-toggle { position: absolute; inset: 0; z-index: 2; background: transparent; border: 0; border-radius: inherit; cursor: inherit; }
    .zoom-note { position: absolute; left: 12px; right: 12px; bottom: 12px; z-index: 3; pointer-events: none; display: flex; gap: .6rem; align-items: flex-start;
      padding: .7rem .9rem; border-radius: 14px; background: rgba(13,18,33,.94); border: 1px solid #1a2540; color: #e2e8f0; font-size: 13.5px; line-height: 1.45;
      opacity: 0; transform: translateY(8px); transition: opacity .6s var(--ease-fade) 1.1s, transform .6s var(--ease-fade) 1.1s; }
    .zoom.focus .zoom-note { opacity: 1; transform: none; }
    .zoom-dot { flex: none; width: 8px; height: 8px; margin-top: 6px; border-radius: 9999px; background: #fbbf24; box-shadow: 0 0 0 4px rgba(251,191,36,.18); }

    /* Phone frames: a bezel, a screen, and a browser bar drawn in CSS. */
    .phone { margin: 0; border-radius: 44px; padding: 10px; background: #0b0f1a; border: 1px solid #2a3a5e; box-shadow: 0 40px 80px -30px rgba(0,0,0,.9), inset 0 0 0 1px rgba(255,255,255,.04); }
    .phone-screen { position: relative; display: flex; flex-direction: column; overflow: hidden; border-radius: 34px; background: #07090f; aspect-ratio: 393 / 852; }
    .phone-screen img { display: block; width: 100%; flex: 1; min-height: 0; object-fit: cover; object-position: top; }
    .phone-screen::before { content: ''; display: block; height: 46px; flex: none; background: #07090f; }
    .story::before { display: none; }
    .island { position: absolute; top: 12px; left: 50%; width: 36%; height: 24px; transform: translateX(-50%); border-radius: 9999px; background: #000; z-index: 6; }
    .urlbar { flex: none; display: flex; align-items: center; justify-content: center; background: #0d1221; border-top: 1px solid #1a2540; }
    .urlbar-top { height: 52px; border-top: 0; border-bottom: 1px solid #1a2540; }
    .urlpill { display: inline-flex; align-items: center; gap: .4rem; width: 84%; justify-content: center; padding: .45rem 0; border-radius: 9999px; background: #161e33; color: #cbd5e1; font-size: 12px; }
    .urlpill::before { content: ''; width: 8px; height: 10px; border: 1.5px solid #94a3b8; border-radius: 2px; border-top-left-radius: 4px; border-top-right-radius: 4px; }

    /* The phone story: scenes stack inside the screen and classes on #story advance them. */
    .story { display: block; }
    .sc { position: absolute; inset: 0; display: flex; flex-direction: column; opacity: 0; transition: opacity .6s var(--ease-fade); }
    .sc .urlbar-top { height: 78px; padding-top: 34px; }
    .sc-page { display: block; width: 100%; flex: 1; min-height: 0; object-fit: cover; object-position: top center; }
    /* A browser's bottom bar: with it, the area left for the page has the same shape as the phone capture, so nothing is cropped. */
    .bottombar { flex: none; height: 58px; display: flex; align-items: flex-end; justify-content: center; padding-bottom: 8px; background: #0d1221; border-top: 1px solid #1a2540; }
    .bottombar::before { content: ''; width: 36%; height: 4px; border-radius: 9999px; background: #334155; }
    /* Scene 0 is the lock screen: the chat app's own notification, no buttons, because that is what a phone shows. */
    .sc-lock { background: radial-gradient(ellipse 80% 50% at 50% 0%, rgba(59,130,246,.35), transparent 70%), linear-gradient(180deg, #0b1020, #07090f); align-items: center; }
    .s0 .sc-lock { opacity: 1; }
    .s1 .sc-lock { opacity: 0; }
    .lock-time { margin-top: 54px; font-size: 54px; font-weight: 300; letter-spacing: -0.03em; color: #f1f5f9; line-height: 1; }
    .lock-date { margin-top: 6px; font-size: 12.5px; color: #94a3b8; }
    .notif { position: absolute; left: 10px; right: 10px; top: 150px; padding: 11px 13px 12px; border-radius: 18px; background: rgba(30,41,59,.78); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border: 1px solid rgba(148,163,184,.18); color: #f1f5f9; transform: translateY(-140px); opacity: 0; transition: transform .8s var(--ease-fluid), opacity .6s var(--ease-fade); }
    .s0 .notif { transform: none; opacity: 1; }
    .notif-head { display: flex; align-items: center; gap: 6px; font-size: 10.5px; color: #cbd5e1; }
    .notif-icon { display: inline-flex; width: 18px; height: 18px; align-items: center; justify-content: center; border-radius: 4px; background: #ffffff; }
    .notif-icon svg { width: 12px; height: 12px; }
    .notif-title { margin-top: 6px; font-size: 12.5px; font-weight: 600; }
    .notif-body { margin-top: 2px; font-size: 11.5px; color: #cbd5e1; line-height: 1.35; }
    .tap-notif { left: 46%; top: 200px; }
    .s0-tap .tap-notif { opacity: 1; transform: scale(1); }
    .s1 .tap-notif { opacity: 0; transform: scale(1.4); }

    /* Scene 1 is the chat app: a channel, and the incident card the connector posts, with its buttons. */
    .sc-alert { background: #0f1420; }
    .chat-head { display: flex; align-items: center; gap: 5px; flex: none; height: 78px; padding: 40px 14px 0; font-size: 13px; font-weight: 600; color: #f1f5f9; border-bottom: 1px solid #1a2540; }
    .chat-hash { color: #64748b; font-weight: 500; }
    .chat-old { padding: 14px 14px 0; display: flex; flex-direction: column; gap: 8px; }
    .chat-line { display: block; height: 8px; border-radius: 4px; background: #1a2540; }
    .msg { margin: 16px 10px 0; transform: translateY(16px); opacity: 0; transition: transform .7s var(--ease-fluid), opacity .5s var(--ease-fade); }
    .s1 .msg { transform: none; opacity: 1; }
    .msg-head { display: flex; align-items: center; gap: 6px; font-size: 11px; color: #94a3b8; }
    .msg-avatar { display: inline-flex; width: 20px; height: 20px; align-items: center; justify-content: center; border-radius: 5px; background: #3b82f6; color: #fff; font-size: 11px; font-weight: 700; }
    .msg-name { font-weight: 600; color: #f1f5f9; }
    .msg-app { padding: 1px 4px; border-radius: 3px; background: #1a2540; font-size: 8.5px; font-weight: 600; letter-spacing: .04em; }
    .card { margin-top: 6px; padding: 9px 10px 10px 11px; border-left: 3px solid #fb7185; border-radius: 6px; background: #141b2d; }
    .card-headline { display: flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 600; color: #fda4af; }
    .card-dot { width: 7px; height: 7px; border-radius: 9999px; background: #fb7185; }
    .card-title { margin-top: 4px; font-size: 12px; font-weight: 600; color: #f1f5f9; line-height: 1.35; }
    .card-line { margin-top: 4px; font-size: 10.5px; color: #cbd5e1; line-height: 1.35; }
    .card-acked { display: none; color: #6ee7b7; }
    .ack-check { display: inline-block; margin-right: 4px; font-weight: 700; }
    .s1-acked .card-responder { display: none; }
    .s1-acked .card-acked { display: block; }
    .card-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 5px; margin-top: 9px; transition: opacity .4s var(--ease-fade); }
    .card-btn { display: inline-flex; justify-content: center; padding: 6px 0; border-radius: 6px; border: 1px solid #2a3a5e; font-size: 10.5px; font-weight: 600; color: #f1f5f9; white-space: nowrap; }
    .btn-ack { background: rgba(52,211,153,.14); border-color: rgba(52,211,153,.4); color: #6ee7b7; transition: all .3s var(--ease-fade); }
    .s1-acked .btn-ack { background: transparent; border-color: #2a3a5e; color: #64748b; }
    .card-link { margin-top: 8px; font-size: 10.5px; color: #94a3b8; }
    .card-url { color: #60a5fa; text-decoration: underline; text-underline-offset: 2px; }
    .tap { position: absolute; width: 26px; height: 26px; border-radius: 9999px; background: rgba(255,255,255,.55); box-shadow: 0 0 0 6px rgba(255,255,255,.18); opacity: 0; transform: scale(.6); transition: opacity .25s, transform .25s; pointer-events: none; z-index: 5; }
    .tap-ack { left: 28%; top: 282px; }
    .s1-tap .tap-ack { opacity: 1; transform: scale(1); }
    .s1-acked .tap-ack { opacity: 0; transform: scale(1.4); }
    .tap-open { left: 58%; top: 352px; }
    .s1-open .tap-open { opacity: 1; transform: scale(1); }
    .s2 .tap-open { opacity: 0; transform: scale(1.4); }
    .s1 .sc-alert { opacity: 1; }
    .s2 .sc-alert { opacity: 0; }
    .s2 .sc-browser { opacity: 1; }
    .url-text { display: inline-block; overflow: hidden; white-space: nowrap; width: 0; transition: width 1s steps(15); }
    .s2 .url-text, .s3 .url-text { width: 15ch; }
    .sc-browser .sc-page { transform: translateY(40px); opacity: 0; transition: transform .8s var(--ease-fluid), opacity .6s var(--ease-fade); }
    .s2-page .sc-browser .sc-page { transform: none; opacity: 1; }
    .s3 .sc-browser { opacity: 0; }
    .s3 .sc-session { opacity: 1; }
    .sheet { position: absolute; left: 0; right: 0; bottom: 58px; padding: 14px 12px 16px; border-radius: 22px 22px 0 0; background: rgba(13,18,33,.97); border-top: 1px solid #1a2540; box-shadow: 0 -20px 50px rgba(0,0,0,.6); transform: translateY(105%); transition: transform .7s var(--ease-fluid); }
    .s3-ask .sheet { transform: none; }
    .sheet-title { font-family: var(--font-mono); font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: #64748b; }
    .bubble { max-width: 88%; margin-top: 9px; padding: 8px 11px; border-radius: 14px; font-size: 12.5px; line-height: 1.4; opacity: 0; transform: translateY(8px); transition: opacity .4s var(--ease-fade), transform .4s var(--ease-fade); }
    .bubble-you { margin-left: auto; background: #2563eb; color: #fff; border-bottom-right-radius: 4px; }
    .bubble-agent { background: #1a2540; color: #e2e8f0; border-bottom-left-radius: 4px; }
    .s3-ask .bubble-you, .s3-typing .bubble-agent { opacity: 1; transform: none; }
    .reply { display: none; }
    .dots { display: inline-flex; gap: 4px; padding: 3px 2px; }
    .dots i { width: 6px; height: 6px; border-radius: 9999px; background: #94a3b8; animation: dot 1s infinite ease-in-out; }
    .dots i:nth-child(2) { animation-delay: .15s; } .dots i:nth-child(3) { animation-delay: .3s; }
    @keyframes dot { 0%, 80%, 100% { opacity: .3; transform: translateY(0); } 40% { opacity: 1; transform: translateY(-3px); } }
    .s3-reply .dots { display: none; } .s3-reply .reply { display: inline; }
    .sheet-actions { display: flex; gap: 8px; margin-top: 12px; opacity: 0; transition: opacity .4s var(--ease-fade); }
    .s3-reply .sheet-actions { opacity: 1; }
    .approve, .reject { display: inline-flex; justify-content: center; align-items: center; padding: 8px 0; border-radius: 10px; font-size: 12px; font-weight: 600; }
    .approve { flex: 1.6; background: #10b981; color: #052e16; transition: background-color .3s var(--ease-fade), color .3s var(--ease-fade); }
    .reject { flex: 1; border: 1px solid #1a2540; color: #fb7185; }
    .approve-on, .s3-approved .approve-off { display: none; }
    .s3-approved .approve-on { display: inline; }
    .s3-approved .approve { background: rgba(52,211,153,.22); color: #6ee7b7; }
    .tap-approve { left: 30%; bottom: 78px; }
    .s3-tap .tap-approve { opacity: 1; transform: scale(1); }
    .s3-approved .tap-approve { opacity: 0; transform: scale(1.4); }
    .story-step { border: 1px solid transparent; }
    .story-step.active { background: rgba(255,255,255,.04); border-color: #1a2540; }
    .story-step.active .step-num { border-color: #3b82f6; color: #f1f5f9; background: rgba(59,130,246,.2); }
    @media (prefers-reduced-motion: reduce) {
      .sc, .msg, .sc-page, .sheet, .bubble, .sheet-actions, .url-text, .tap { transition: none; }
      .dots i { animation: none; }
    }

    /* Policy chips in the gate table. */
    .chip { display: inline-flex; align-items: center; border-radius: 9999px; padding: .3rem .7rem; font-family: var(--font-mono); font-size: 11px; letter-spacing: .04em; white-space: nowrap; }
    .chip-runs, .chip-undo { background: rgba(52,211,153,.12); color: #34d399; }
    .chip-approval { background: rgba(251,191,36,.12); color: #fbbf24; }
    .chip-advise { background: rgba(96,165,250,.14); color: #60a5fa; }
    .chip-never { background: rgba(251,113,133,.12); color: #fb7185; }

    /* Architecture map. Each node carries its family colour in --c. */
    .arch-edge { fill: none; stroke: #263354; stroke-width: 1.4; transition: stroke .2s, opacity .2s; }
    .arch-flow { fill: none; stroke-width: 1.6; stroke-dasharray: 3 14; stroke-linecap: round; opacity: .5; animation: flow 1.6s linear infinite; transition: opacity .2s; }
    @keyframes flow { to { stroke-dashoffset: -17; } }
    .arch-node { cursor: pointer; outline: none; }
    .arch-node .box { fill: #0d1221; stroke: #1f2a47; stroke-width: 1; transition: stroke .2s, fill .2s, filter .2s; }
    .arch-node .bar { fill: var(--c); opacity: .9; }
    .arch-node text { fill: #e2e8f0; font: 500 13px var(--font-sans); pointer-events: none; }
    .arch-node .sub { fill: #64748b; font-size: 10.5px; font-weight: 400; }
    .arch-node:hover .box, .arch-node:focus-visible .box { stroke: var(--c); fill: #101a30; }
    .arch-node.active .box { stroke: var(--c); fill: #12203a; stroke-width: 1.5; filter: drop-shadow(0 0 10px var(--c)); }
    .arch-node.dim { opacity: .3; }
    .arch-edge.dim, .arch-flow.dim { opacity: .1; }
    .arch-flow.lit { opacity: 1; }
    .dot { display: inline-block; width: 7px; height: 7px; border-radius: 9999px; background: var(--c); }
    .arch-item.active { border-color: var(--c); background: #12203a; }
    .dossier { transform: translateX(105%); transition: transform .35s var(--ease-fluid); }
    .dossier.open { transform: none; }
    @media (max-width: 1023px) { .dossier { transform: translateY(105%); } .dossier.open { transform: none; } }

    @media (prefers-reduced-motion: reduce) {
      .reveal { animation: none; opacity: 1; transform: none; }
      .arch-flow, .animate-marquee { animation: none; }
      .dossier, #nav, .zoom-stage, .zoom-ring, .zoom-note { transition: none; }
      .zoom-note { opacity: 1; transform: none; }
    }
  </style>

  <div id="intro" class="fixed inset-0 z-[100] flex flex-col items-center justify-center bg-ops-bg" aria-hidden="true">
    <img id="intro-mark" src={`${base}/wordmark.png`} alt="" width="577" height="117" class="w-[min(66vw,520px)]" decoding="async" />
    <p id="intro-line" class="mt-7 text-[clamp(10px,1.3vw,13px)] font-light uppercase text-slate-400">Detect. Mend. Prevail.</p>
  </div>

  <canvas id="field" class="pointer-events-none fixed inset-0 z-0 h-full w-full" aria-hidden="true"></canvas>

  <nav id="nav" aria-label="Main">
    <div class="flex items-center justify-between">
      <a href="#top" class="text-[15px] font-semibold tracking-tight text-slate-50 focus-ring">Ops<span class="text-ops-blue">Mender</span></a>
      <div class="hidden items-center gap-1 md:flex">
        <a href="#how"      class="nav-link">How it works</a>
        <a href="#tiers"    class="nav-link">Autonomy</a>
        <a href="#bring"    class="nav-link">Integrations</a>
        <a href="#gate"     class="nav-link">The gate</a>
        <a href="#screens"  class="nav-link">Product tour</a>
      </div>
      <div class="flex items-center gap-3">
        <a href="#install" class="nav-link hidden sm:inline">Install</a>
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="pill pill-blue !py-1.5 !pl-4 !pr-1.5 text-[11.5px]">GitHub <span class="arrow"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M9 7h8v8"/></svg></span></a>
      </div>
    </div>
  </nav>

  <main class="relative z-10">
    <!-- HERO -->
    <header id="top" class="mx-auto max-w-7xl px-5 pb-10 pt-36 text-center sm:px-8 sm:pt-44">
      <p class="reveal reveal-1 mx-auto inline-flex items-center gap-2 rounded-full border border-ops-border bg-ops-surface/70 px-3.5 py-1.5 font-mono text-[11px] uppercase tracking-[0.18em] text-ops-subtle">Open source <span class="text-ops-muted">·</span> runs on your servers</p>
      <h1 class="display mx-auto mt-8 max-w-4xl text-[2.45rem] text-slate-50 sm:text-6xl lg:text-[4.6rem]">
        <span class="reveal reveal-1 block">Page the right people.</span>
        <span class="reveal reveal-2 block">Let AI investigate.</span>
        <span class="reveal reveal-3 block text-ops-subtle">You decide what runs.</span>
      </h1>
      <p class="reveal reveal-4 mx-auto mt-7 max-w-xl text-[17px] leading-relaxed text-ops-subtle sm:text-lg">
        OpsMender is an incident response platform you host yourself. It tracks incidents, pages the on call
        engineer, and can hand an AI agent the tools to investigate and fix things. A gate in the backend decides
        what the agent may actually do, and the model has no say in it.
      </p>
      <div class="reveal reveal-5 mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="pill pill-blue">View on GitHub <span class="arrow"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M9 7h8v8"/></svg></span></a>
        <a href="#how" class="pill pill-ghost">See how it works</a>
      </div>
      <div class="reveal reveal-5 mx-auto mt-6 flex max-w-md items-center justify-between gap-3 rounded-lg border border-ops-border bg-ops-surface/70 px-4 py-2.5 font-mono text-[12.5px] text-slate-200">
        <span><span class="text-ops-muted">&gt;</span> docker compose -f docker/docker-compose.yml up</span>
        <button id="copy-cmd" type="button" class="rounded p-1 text-ops-muted transition-colors hover:text-slate-100 focus-ring" aria-label="Copy the command">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
        </button>
      </div>
    </header>

    <section class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="panel reveal reveal-5 p-3 sm:p-6">
        <div class="wash wash-blue" aria-hidden="true"></div>
        <figure class="relative overflow-hidden rounded-2xl border border-ops-border/80 shadow-frame">
          <img src={shot('incidents-list.png')} alt="The incident command center: a list of incidents with priority, status, owner, and whether an AI session is running" width="3200" height="2000" class="block w-full" loading="eager" fetchpriority="high" />
        </figure>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section id="how" class="mx-auto max-w-7xl scroll-mt-28 px-5 pt-32 sm:px-8 sm:pt-44">
      <div class="text-center">
        <p class="label rise">How it works</p>
        <h2 class="headline rise mx-auto mt-5 max-w-3xl text-4xl text-slate-50 sm:text-5xl" style="--i:1">Alerts in. The right person paged. An agent that works inside the lines you draw.</h2>
      </div>
      <div class="mt-16 grid gap-5 md:grid-cols-3">
        {steps.map((s, i) => (
          <article class="rise" style={`--i:${i + 1}`}>
            <div class="panel zoom aspect-[16/10] p-0" style={`--fx:${s.fx}%; --fy:${s.fy}%; --s:${s.s}; --tx:${50 - s.fx}%; --ty:${50 - s.fy}%`}>
              <div class="zoom-stage">
                <img src={shot(s.file)} alt={s.title} width="3200" height="2000" class="block h-full w-full object-cover object-top" loading="lazy" />
                <span class="zoom-ring" style={`left:${s.fx}%; top:${s.fy}%; width:${s.w}%; height:${s.h}%`} aria-hidden="true"></span>
              </div>
              <button type="button" class="zoom-toggle focus-ring" aria-label={`Zoom in or out on ${s.title}`}></button>
              <p class="zoom-note"><span class="zoom-dot" aria-hidden="true"></span>{s.look}</p>
            </div>
            <h3 class="mt-6 text-[22px] font-medium tracking-tight text-slate-50">{s.title}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-ops-subtle">{s.desc}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- TIERS -->
    <section id="tiers" class="mx-auto max-w-7xl scroll-mt-28 px-5 pt-32 sm:px-8 sm:pt-44">
      <div class="text-center">
        <p class="label rise">Autonomy</p>
        <h2 class="headline rise mx-auto mt-5 max-w-2xl text-4xl text-slate-50 sm:text-5xl" style="--i:1">Three tiers. One is picked per session.</h2>
        <p class="rise mx-auto mt-5 max-w-xl text-ops-subtle" style="--i:2">The tier is enforced in the backend before any tool call runs, so the agent cannot talk its way past it.</p>
      </div>
      <div id="tier-switch" class="mt-14 grid gap-5 lg:grid-cols-12 lg:items-stretch">
        <div class="rise flex flex-col gap-3 lg:col-span-4" role="tablist" aria-label="Autonomy tiers" style="--i:1">
          {tiers.map((t, i) => (
            <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-i={i}
              class={`tier-tab flex-1 rounded-2xl border p-5 text-left transition-colors focus-ring ${i === 0 ? 'border-ops-blue bg-ops-surface' : 'border-ops-border bg-ops-surface/50 hover:border-slate-600'}`}>
              <span class="flex items-center justify-between">
                <span class="inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.16em] text-ops-subtle"><span class={`h-2 w-2 rounded-full ${t.tone}`}></span>Tier {t.num}</span>
                {t.isDefault && <span class="rounded-full border border-ops-border px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.12em] text-ops-subtle">Default</span>}
              </span>
              <span class="mt-2 block text-[21px] font-medium tracking-tight text-slate-50">{t.name}</span>
              <span class="mt-1.5 block text-[14.5px] leading-relaxed text-ops-subtle">{t.desc}</span>
              <span class="mt-3 block text-sm text-slate-200">{t.note}</span>
            </button>
          ))}
        </div>
        <div class="panel rise p-3 sm:p-5 lg:col-span-8" style="--i:2">
          <div class="wash wash-blue" aria-hidden="true"></div>
          <div class="relative aspect-[16/10] overflow-hidden rounded-2xl border border-ops-border/80 bg-ops-surface shadow-frame">
            {tiers.map((t, i) => (
              <img src={shot(t.file)} alt={`A Tier ${t.num} session`} width="2880" height="1800" data-i={i} loading="lazy"
                class={`tier-shot absolute inset-0 block h-full w-full object-cover object-top transition-opacity duration-700 ${i === 0 ? 'opacity-100' : 'opacity-0'}`} />
            ))}
          </div>
          <div class="relative mt-4 flex items-center justify-between gap-4 px-1">
            <p id="tier-caption" class="text-sm text-ops-subtle">{tiers[0].caption}</p>
            <div class="flex shrink-0 gap-1.5" aria-hidden="true">{tiers.map((_, i) => <span class={`tier-dot h-1.5 w-1.5 rounded-full ${i === 0 ? 'bg-ops-blue' : 'bg-ops-border'}`}></span>)}</div>
          </div>
        </div>
      </div>
    </section>

    <!-- INTEGRATIONS -->
    <section id="bring" class="scroll-mt-28 pt-32 sm:pt-44">
      <div class="mx-auto max-w-7xl px-5 text-center sm:px-8">
        <p class="label rise">Integrations</p>
        <h2 class="headline rise mx-auto mt-5 max-w-2xl text-4xl text-slate-50 sm:text-5xl" style="--i:1">OpsMender fits the tools your team already uses.</h2>
        <p class="rise mx-auto mt-5 max-w-xl text-ops-subtle" style="--i:2">Alerts in from sixteen sources. Pages out to twenty platforms, with buttons in Slack, Teams, and Discord. Any of eleven model providers. Your key stays in your server's environment and is sent only to that provider's API.</p>
      </div>
      <div class="fade-x rise mt-14 overflow-hidden" style="--i:3" aria-label="Alert sources and notification platforms">
        <div class="flex w-max animate-marquee gap-4 pr-4">
          {[...marquee, ...marquee].map((item) => (
            <div class="flex h-[96px] min-w-[112px] shrink-0 flex-col items-center justify-center gap-2.5 rounded-2xl border border-ops-border bg-ops-surface/80 px-4 text-slate-200" title={item.name}>
              <span class="[&>svg]:h-7 [&>svg]:w-7" set:html={item.svg} />
              <span class="whitespace-nowrap font-mono text-[10px] uppercase tracking-[0.1em] text-ops-muted">{item.name}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="mx-auto mt-8 max-w-7xl px-5 sm:px-8">
        <p class="rise mx-auto max-w-3xl text-center text-sm leading-relaxed text-ops-muted" style="--i:4">Twenty six built in connectors as well, including GitHub, GitLab, Jira, ServiceNow, Kubernetes, Sentry, Argo CD and Terraform Cloud, with two way ticket sync for Jira and ServiceNow. Any MCP server you care to run.</p>
      </div>
    </section>

    <!-- MODELS -->
    <section id="models" class="mx-auto max-w-7xl scroll-mt-28 px-5 pt-24 sm:px-8 sm:pt-32">
      <div class="text-center">
        <p class="label rise">Supported AI models</p>
        <h2 class="headline rise mx-auto mt-5 max-w-2xl text-4xl text-slate-50 sm:text-5xl" style="--i:1">Bring the model you already use.</h2>
        <p class="rise mx-auto mt-5 max-w-xl text-ops-subtle" style="--i:2">Hosted or local, picked per workspace or per service. Your API key stays in your server's environment and is sent only to that provider's API. A model can only ever read its own key.</p>
      </div>
      <div class="rise mt-12 grid gap-4 [grid-auto-rows:1fr] sm:grid-cols-2 lg:grid-cols-4" style="--i:3" aria-label="Model providers">
        {providers.map((m) => (
          <div class="flex h-full min-h-[108px] items-center gap-4 rounded-2xl border border-ops-border bg-ops-surface/80 p-5">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-ops-border bg-ops-bg/60 text-slate-200 [&>svg]:h-7 [&>svg]:w-7" set:html={m.svg} />
            <span class="min-w-0"><span class="block text-base font-medium text-slate-50">{m.name}</span><span class="mt-0.5 block text-[13px] leading-snug text-ops-muted">{m.note}</span></span>
          </div>
        ))}
      </div>
    </section>

    <!-- THE GATE -->
    <section id="gate" class="mx-auto max-w-7xl scroll-mt-28 px-5 pt-32 sm:px-8 sm:pt-44">
      <div class="panel rise px-6 py-14 sm:px-12 sm:py-20">
        <div class="wash wash-indigo" aria-hidden="true"></div>
        <div class="relative text-center">
          <p class="label">The gate</p>
          <h2 class="headline mx-auto mt-5 max-w-2xl text-4xl text-slate-50 sm:text-5xl">Built so the model never gets a vote.</h2>
        </div>
        <div class="relative mt-14 grid gap-10 lg:grid-cols-3">
          {gatePoints.map((g) => (
            <div>
              <h3 class="text-xl font-medium tracking-tight text-slate-50">{g.title}</h3>
              <p class="mt-3 text-[15px] leading-relaxed text-ops-subtle">{g.desc}</p>
            </div>
          ))}
        </div>
        <div class="relative mt-12 overflow-hidden rounded-2xl border border-ops-border bg-ops-bg/70">
          <div class="hidden border-b border-ops-border px-5 py-3 font-mono text-[10.5px] uppercase tracking-[0.16em] text-ops-muted sm:grid sm:grid-cols-[1.6fr_1fr_1fr_1fr] sm:gap-3">
            <span>The agent asks to</span><span>Tier 0</span><span>Tier 1</span><span>Tier 2</span>
          </div>
          {policyRows.map((r) => (
            <div class="border-b border-ops-border/60 px-5 py-4 last:border-0 sm:grid sm:grid-cols-[1.6fr_1fr_1fr_1fr] sm:items-center sm:gap-3">
              <span class="block text-[15px] text-slate-50">{r.ask}</span>
              <div class="mt-2 flex flex-wrap gap-2 sm:contents">
                {r.tiers.map((c, k) => (
                  <span class={`chip chip-${c}`}><span class="mr-1 text-ops-muted sm:hidden">T{k}</span>{CHIP[c]}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
        <p class="relative mx-auto mt-6 max-w-2xl text-center text-sm text-ops-muted">These rules live in a plain text file you keep next to your code, one per tool source. Change the file and the rules change. There is no switch the agent can flip, and anything the file does not mention is denied.</p>
      </div>
    </section>

    <!-- STATS -->
    <section class="mx-auto max-w-7xl px-5 pt-24 sm:px-8 sm:pt-32">
      <div class="rise grid gap-x-8 gap-y-10 border-y border-ops-border py-12 sm:grid-cols-4">
        {stats.map((s, i) => (
          <div style={`--i:${i}`}>
            <p class="label">{s.label}</p>
            <p class="headline mt-3 text-5xl text-slate-50 sm:text-6xl"><span class="count" data-to={s.value}>0</span>{s.suffix}</p>
          </div>
        ))}
      </div>
      <p class="rise mt-4 font-mono text-[11px] uppercase tracking-[0.16em] text-ops-muted">v1.2.1 <span class="mx-2">·</span> MIT license <span class="mx-2">·</span> <a href={CHANGELOG_URL} target="_blank" rel="noopener noreferrer" class="underline decoration-ops-border underline-offset-4 hover:text-slate-200 focus-ring">changelog</a></p>
    </section>

    <!-- WHAT'S NEW -->
    <section id="new" class="mx-auto max-w-7xl scroll-mt-28 px-5 pt-32 sm:px-8 sm:pt-44">
      <div class="text-center">
        <p class="label rise">Version 1.2.1</p>
        <h2 class="headline rise mx-auto mt-5 max-w-2xl text-4xl text-slate-50 sm:text-5xl" style="--i:1">What's new</h2>
      </div>
      <ol class="mt-14 grid gap-5 md:grid-cols-2">
        {whatsNew.map(([title, desc], i) => (
          <li class="panel rise p-7" style={`--i:${i + 1}`}>
            <h3 class="text-xl font-medium tracking-tight text-slate-50">{title}</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-ops-subtle">{desc}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- SCREENS -->
    <section id="screens" class="mx-auto max-w-7xl scroll-mt-28 px-5 pt-32 sm:px-8 sm:pt-44">
      <div class="text-center">
        <p class="label rise">Product</p>
        <h2 class="headline rise mx-auto mt-5 max-w-2xl text-4xl text-slate-50 sm:text-5xl" style="--i:1">What it looks like</h2>
        <p class="rise mx-auto mt-5 max-w-xl text-ops-subtle" style="--i:2">Real screens from a seeded workspace. Pick one below, or click the large image to see it at full size.</p>
      </div>
      <div id="viewer" data-base={base} class="panel rise mt-14 p-3 sm:p-6" style="--i:3">
        <div class="wash wash-grey" aria-hidden="true"></div>
        <button id="v-open" class="relative block w-full overflow-hidden rounded-2xl border border-ops-border bg-ops-surface text-left shadow-frame focus-ring" aria-label="Open screenshot at full size">
          <img id="v-img" src={shot(shots[0].file)} alt={shots[0].title} width="3200" height="2000" class="block w-full" loading="lazy" />
        </button>
        <div class="relative mt-4 flex items-start justify-between gap-6 px-1">
          <div>
            <p id="v-title" class="text-base font-medium text-slate-50">{shots[0].title}</p>
            <p id="v-cap" class="mt-1 text-sm text-ops-subtle">{shots[0].caption}</p>
          </div>
          <p id="v-count" class="shrink-0 font-mono text-xs text-ops-muted">1 / {shots.length}</p>
        </div>
        <div id="v-thumbs" class="relative mt-5 grid grid-cols-4 gap-3 px-1 pb-1 sm:grid-cols-8" role="tablist" aria-label="Screenshots">
          {shots.map((s, i) => (
            <button role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-i={i} data-file={s.file} data-title={s.title} data-cap={s.caption}
              class={`overflow-hidden rounded-lg border transition-colors focus-ring ${i === 0 ? 'border-ops-blue' : 'border-ops-border hover:border-slate-500'}`} aria-label={s.title}>
              <img src={shot(s.file)} alt="" width="640" height="400" class="block aspect-[16/10] w-full object-cover object-top" loading="lazy" />
            </button>
          ))}
        </div>
      </div>

      <div id="lightbox" class="fixed inset-0 z-[60] hidden items-center justify-center bg-ops-bg/95 p-4 backdrop-blur-sm" role="dialog" aria-modal="true" aria-label="Screenshot">
        <button id="lb-close" class="absolute right-4 top-4 rounded p-2 text-ops-subtle hover:text-white focus-ring" aria-label="Close">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M6 18 18 6M6 6l12 12"/></svg>
        </button>
        <button id="lb-prev" class="absolute left-3 top-1/2 -translate-y-1/2 rounded p-2 text-ops-subtle hover:text-white focus-ring" aria-label="Previous"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m15 6-6 6 6 6"/></svg></button>
        <button id="lb-next" class="absolute right-3 top-1/2 -translate-y-1/2 rounded p-2 text-ops-subtle hover:text-white focus-ring" aria-label="Next"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/></svg></button>
        <figure class="max-h-full max-w-[1600px]">
          <img id="lb-img" src="" alt="" class="max-h-[85vh] w-auto rounded-md border border-ops-border" />
          <figcaption id="lb-cap" class="mt-3 text-center text-sm text-ops-subtle"></figcaption>
        </figure>
      </div>
    </section>

    <!-- ON YOUR PHONE -->
    <section id="mobile" class="mx-auto max-w-7xl scroll-mt-28 px-5 pt-32 sm:px-8 sm:pt-44">
      <div class="panel rise px-6 py-14 sm:px-12 sm:py-20">
        <div class="wash wash-blue" aria-hidden="true"></div>
        <div class="relative grid gap-12 lg:grid-cols-2 lg:items-center">
          <div>
            <p class="label">On your phone</p>
            <h2 class="headline mt-5 text-4xl text-slate-50 sm:text-5xl">Acknowledge from wherever you are.</h2>
            <p class="mt-5 text-ops-subtle">There is no app to install. The page reaches you through the chat app you already use, one tap acknowledges it, the link opens the incident in your phone's browser, and you can talk to the agent before you let it act.</p>
            <ol id="story-steps" class="mt-7 space-y-1.5">
              {[
                ['The page arrives in chat', 'A notification from the chat app you already have, then the incident card with its buttons.'],
                ['One tap to acknowledge', 'The chain stops escalating. The card says the incident is yours.'],
                ['The link opens the incident', 'Same app, signed in, straight to the page.'],
                ['Ask the agent, then approve', 'It explains its plan in plain words. Nothing runs until you say so.'],
              ].map(([title, sub], i) => (
                <li>
                  <button type="button" class="story-step flex w-full items-start gap-3 rounded-xl px-3 py-2.5 text-left transition-colors focus-ring" data-step={i + 1}>
                    <span class="step-num mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-ops-border font-mono text-[11px] text-ops-subtle">{i + 1}</span>
                    <span><span class="block text-[15px] font-medium text-slate-50">{title}</span><span class="block text-[13.5px] text-ops-subtle">{sub}</span></span>
                  </button>
                </li>
              ))}
            </ol>
          </div>
          <div class="flex justify-center">
            <figure class="phone phone-a w-[78%] max-w-[290px]">
              <div id="story" class="phone-screen story" data-base={base}>
                <span class="island" aria-hidden="true"></span>

                <!-- Scene 0: the chat app's notification on the lock screen -->
                <div class="sc sc-lock">
                  <p class="lock-time">7:48</p>
                  <p class="lock-date">Tuesday, October 20</p>
                  <div class="notif">
                    <div class="notif-head"><span class="notif-icon" set:html={platforms.find((p) => p.name === 'Slack')?.svg ?? ''} /><span>Slack · #payments-incidents</span><span class="ml-auto">now</span></div>
