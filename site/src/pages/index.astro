---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const GITHUB_URL    = 'https://github.com/SpicyDaemon/OpsMender-AI';
const DOCS_URL      = `${GITHUB_URL}#readme`;
const CHANGELOG_URL = `${GITHUB_URL}/blob/main/CHANGELOG.md`;
const RELEASES_URL  = `${GITHUB_URL}/releases`;

const stats = [
  ['v1.1.0', 'current release'],
  ['2,400+', 'automated tests'],
  ['26',     'integration kinds'],
  ['MIT',    'license'],
];

const tiers = [
  {
    num: 0,
    name: 'Autonomous',
    color: 'text-red-400',
    rule: 'bg-red-400',
    desc: 'The agent fixes things on its own: restarts, rollbacks, scaling. It stays inside your skill policy and only makes changes it can undo. Hard time limits apply.',
    note: 'For staging and sandboxes. Shown in red inside the product for a reason.',
  },
  {
    num: 1,
    name: 'Approval required',
    color: 'text-amber-400',
    rule: 'bg-amber-400',
    desc: 'The agent investigates and proposes. Reads happen right away. Anything that writes waits for a person to approve it. Denied tools never run.',
    note: 'The right choice for production.',
  },
  {
    num: 2,
    name: 'Advisory',
    color: 'text-ops-blue',
    rule: 'bg-ops-blue',
    desc: 'The agent reads, explains, and recommends. It writes nothing. A person carries out every step.',
    note: 'The default for every new install.',
    isDefault: true,
  },
];

const features = [
  ['Incidents',      'Priorities P0 to P3, deduplication, merging, and a full timeline of who did what and when.'],
  ['Paging',         'Rosters, escalation chains, an on call calendar, and maintenance windows that keep matching alerts quiet.'],
  ['Notifications',  'Slack, Teams, Discord, Telegram, Matrix, email, SMS, and voice calls. Slack, Teams, and Discord get buttons you can act on.'],
  ['AI sessions',    'Start one from any incident. The agent observes, diagnoses, plans, and acts inside the tier you chose.'],
  ['Skills',         'A policy file you own, bound to an MCP server or a native connector. Anything it does not name is denied.'],
  ['Integrations',   'Twenty six kinds, including GitHub, Jira, ServiceNow, Kubernetes, and Sentry. Two way ticket sync for Jira and ServiceNow.'],
  ['Models',         'Bring your own. Anthropic, OpenAI, Azure, Bedrock, Vertex AI, Ollama, or any OpenAI compatible endpoint.'],
  ['Reliability',    'HTTP uptime checks with SLA and SLO tracking and history.'],
  ['Postmortems',    'A structured draft built from the incident and the session. Edit it, save it, export it as Markdown.'],
  ['Analytics',      'Alert noise and response time trends by service and priority, with CSV export.'],
  ['Access',         'Admins, operators, and viewers. Email and password, OIDC, SAML, and TOTP.'],
  ['Runs anywhere',  'One compose file. A Helm chart. Recipes for AWS, Azure, GCP, and OCI. Linux and Windows binaries.'],
];

const whatsNew = [
  ['Sessions without MCP',        'A service covered by native connectors no longer needs an MCP server. Its tools pass through the same gate, approvals, and audit log. If nothing provides tools, the session says so and stays advisory.'],
  ['Skill Studio for both sources', 'Bind a skill to an MCP server or a native connector. Start from a template, pull in the available tools, validate before saving, and see exactly which permissions a change would widen.'],
  ['Discord incident actions',    'Acknowledge, resolve, escalate, or start a session from a Discord message. Every press is signature verified, matched to a linked account, checked for replays, and audited.'],
];

const shots = [
  { file: 'ai-session.png', caption: 'A session at Tier 0. The agent restarted a deployment, confirmed recovery, and recorded how to undo it.', alt: 'AI session view showing a completed autonomous restart with a rollback path' },
  { file: 'mcp-skills.png', caption: 'Skill Studio. The policies that decide what the agent may run.',                                        alt: 'Skill list with per tier policies' },
  { file: 'people-rbac.png', caption: 'People and access. Admins, operators, and viewers.',                                                  alt: 'User management with three roles' },
];
---

<Layout>
  <nav class="sticky top-0 z-50 border-b border-ops-border bg-ops-bg/90 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3.5 sm:px-8">
      <a href="#top" class="text-[15px] font-semibold tracking-tight text-slate-50 focus-ring">
        Ops<span class="text-ops-blue">Mender</span>
      </a>
      <div class="flex items-center gap-1">
        <a href="#tiers"    class="nav-link hidden sm:inline">Autonomy</a>
        <a href="#features" class="nav-link hidden sm:inline">Features</a>
        <a href="#new"      class="nav-link hidden md:inline">What's new</a>
        <a href="#install"  class="nav-link hidden sm:inline">Install</a>
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer"
           class="ml-2 rounded-md border border-ops-border px-3 py-1.5 text-sm text-slate-200 transition-colors hover:border-slate-500 hover:text-white focus-ring">
          GitHub
        </a>
      </div>
    </div>
  </nav>

  <!-- HERO -->
  <header id="top" class="mx-auto max-w-6xl px-5 pb-16 pt-20 sm:px-8 sm:pt-28">
    <p class="mb-5 font-mono text-xs uppercase tracking-[0.18em] text-ops-muted">Open source · runs on your servers</p>
    <h1 class="max-w-4xl text-[2.5rem] font-semibold leading-[1.08] tracking-tight text-slate-50 sm:text-6xl">
      Page the right people.<br />
      Let AI investigate.<br />
      <span class="text-ops-subtle">You decide what runs.</span>
    </h1>
    <p class="mt-7 max-w-2xl text-lg leading-relaxed text-ops-subtle">
      OpsMender is an incident response platform you host yourself. It tracks incidents,
      pages the on call engineer, and can hand an AI agent the tools to investigate and fix
      things. A gate in the backend decides what the agent may actually do, and the model
      has no say in it.
    </p>
    <div class="mt-9 flex flex-wrap items-center gap-3">
      <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer"
         class="rounded-md bg-slate-50 px-5 py-2.5 text-sm font-medium text-ops-bg transition-colors hover:bg-white focus-ring">
        View on GitHub
      </a>
      <a href="#install"
         class="rounded-md border border-ops-border px-5 py-2.5 text-sm font-medium text-slate-200 transition-colors hover:border-slate-500 focus-ring">
        Install in a few minutes
      </a>
    </div>

    <figure class="mt-16">
      <div class="overflow-hidden rounded-lg border border-ops-border bg-ops-surface">
        <img
          src={`${base}/screenshots/incident-detail.png`}
          alt="Incident detail showing the AI session, timeline, and alert evidence"
          width="3200" height="2000"
          class="block w-full"
          loading="eager"
        />
      </div>
      <figcaption class="mt-3 text-sm text-ops-muted">
        An incident with its AI session, timeline, and alert evidence. Real screens, not mockups.
      </figcaption>
    </figure>

    <dl class="mt-14 grid grid-cols-2 gap-8 border-t border-ops-border pt-8 sm:grid-cols-4">
      {stats.map(([value, label]) => (
        <div>
          <dt class="text-2xl font-semibold tracking-tight text-slate-50">{value}</dt>
          <dd class="mt-1 text-sm text-ops-muted">{label}</dd>
        </div>
      ))}
    </dl>
  </header>

  <!-- TIERS -->
  <section id="tiers" class="scroll-mt-20 border-t border-ops-border">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-24">
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-ops-muted">Autonomy</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight text-slate-50 sm:text-4xl">
        Three tiers. One is picked per session.
      </h2>
      <p class="mt-4 max-w-2xl text-ops-subtle">
        The tier is enforced in the backend before any tool call runs, so the agent cannot talk its way past it.
      </p>

      <div class="mt-12 grid gap-px overflow-hidden rounded-lg border border-ops-border bg-ops-border md:grid-cols-3">
        {tiers.map((t) => (
          <div class="relative bg-ops-bg p-7">
            <div class={`absolute inset-x-0 top-0 h-0.5 ${t.rule}`}></div>
            <div class="flex items-baseline justify-between">
              <span class={`font-mono text-sm font-semibold ${t.color}`}>Tier {t.num}</span>
              {t.isDefault && <span class="rounded border border-ops-border px-2 py-0.5 text-[11px] text-ops-subtle">Default</span>}
            </div>
            <h3 class="mt-2 text-xl font-semibold text-slate-50">{t.name}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ops-subtle">{t.desc}</p>
            <p class={`mt-5 text-sm ${t.color}`}>{t.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- GATE -->
  <section id="gate" class="scroll-mt-20 border-t border-ops-border">
    <div class="mx-auto grid max-w-6xl gap-12 px-5 py-20 sm:px-8 sm:py-24 lg:grid-cols-2 lg:items-start">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-ops-muted">How it stays safe</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-50 sm:text-4xl">
          Skills describe the job.<br />The gate enforces it.
        </h2>
        <div class="mt-6 space-y-4 text-ops-subtle">
          <p>
            Every operation in a skill file says what it may do at each tier. That policy is checked in code
            before a tool call runs. If a prompt injection tells the agent to drop a database, the gate refuses
            the call. The model never gets a vote.
          </p>
          <p>
            Anything the skill does not name is denied. Policy you write can make a connector stricter than
            its baseline but never looser. Malformed policy is rejected with the line that broke it.
          </p>
          <p>
            Tools can come from MCP servers you run, from native connectors, or both. Either way they go
            through the same gate, the same approvals, and the same audit log.
          </p>
        </div>
      </div>

      <div class="overflow-hidden rounded-lg border border-ops-border bg-ops-surface lg:sticky lg:top-20">
        <div class="flex items-center justify-between border-b border-ops-border px-4 py-2.5">
          <span class="font-mono text-xs text-ops-subtle">SKILL.md</span>
          <span class="font-mono text-[11px] text-ops-muted">excerpt</span>
        </div>
        <pre class="overflow-x-auto p-5 text-[12.5px] leading-relaxed"><code class="text-slate-300">{`tier_policies:
  read: &read
    T0: {enabled: true,  mode: autonomous}
    T1: {enabled: true,  mode: autonomous}
    T2: {enabled: true,  mode: advisory}
  reversible_write: &reversible_write
    T0: {enabled: true,  mode: autonomous, require_reversible: true}
    T1: {enabled: true,  mode: approval}
    T2: {enabled: false, mode: blocked}

operations:
  - tool: get_pod_logs
    classification: safe
    tiers: *read

  - tool: scale_deployment
    classification: caution
    reversible: true
    tiers: *reversible_write

  - tool: exec_*
    deny: true`}</code></pre>
      </div>
    </div>
  </section>

  <!-- SCREENSHOTS -->
  <section id="screens" class="scroll-mt-20 border-t border-ops-border">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-24">
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-ops-muted">Product</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-50 sm:text-4xl">What it looks like</h2>
      <div class="mt-10 grid gap-8 md:grid-cols-3">
        {shots.map((s) => (
          <figure>
            <a href={`${base}/screenshots/${s.file}`} target="_blank" rel="noopener" class="block overflow-hidden rounded-lg border border-ops-border bg-ops-surface transition-colors hover:border-slate-500 focus-ring">
              <img src={`${base}/screenshots/${s.file}`} alt={s.alt} width="3200" height="2000" class="block aspect-[16/10] w-full object-cover object-top" loading="lazy" />
            </a>
            <figcaption class="mt-3 text-sm leading-relaxed text-ops-subtle">{s.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section id="features" class="scroll-mt-20 border-t border-ops-border">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-24">
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-ops-muted">Features</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-50 sm:text-4xl">What comes in the box</h2>
      <p class="mt-4 max-w-2xl text-ops-subtle">Alert intake through to the postmortem. No subscription, and no part of it you cannot read.</p>
      <dl class="mt-12 grid gap-x-12 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
        {features.map(([title, desc]) => (
          <div class="border-t border-ops-border pt-4">
            <dt class="text-sm font-semibold text-slate-50">{title}</dt>
            <dd class="mt-1.5 text-sm leading-relaxed text-ops-subtle">{desc}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- WHAT'S NEW -->
  <section id="new" class="scroll-mt-20 border-t border-ops-border">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-24">
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-ops-muted">Version 1.1.0</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-50 sm:text-4xl">What's new</h2>
      <p class="mt-4 max-w-2xl text-ops-subtle">
        Three things worth knowing about. The <a href={CHANGELOG_URL} target="_blank" rel="noopener noreferrer" class="text-slate-200 underline underline-offset-4 decoration-ops-border hover:decoration-slate-400 focus-ring">changelog</a> has the rest.
      </p>
      <ol class="mt-12 grid gap-10 md:grid-cols-3">
        {whatsNew.map(([title, desc], i) => (
          <li>
            <span class="font-mono text-sm text-ops-muted">0{i + 1}</span>
            <h3 class="mt-2 text-lg font-semibold text-slate-50">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ops-subtle">{desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- INSTALL -->
  <section id="install" class="scroll-mt-20 border-t border-ops-border">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-24">
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-ops-muted">Install</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-50 sm:text-4xl">Running in a few minutes</h2>
      <p class="mt-4 max-w-2xl text-ops-subtle">One compose file. Backend and frontend in a single container, with Postgres alongside it.</p>

      <div class="mt-10 overflow-hidden rounded-lg border border-ops-border bg-ops-surface">
        <pre class="overflow-x-auto p-6 font-mono text-[13px] leading-7"><code><span class="text-ops-muted"># Clone it</span>
<span class="text-slate-200">git clone https://github.com/SpicyDaemon/OpsMender-AI</span>
<span class="text-slate-200">cd OpsMender-AI</span>

<span class="text-ops-muted"># Copy the example config, then set your model provider and API key</span>
<span class="text-slate-200">cp .env.example .env</span>

<span class="text-ops-muted"># Start it</span>
<span class="text-slate-200">docker compose -f docker/docker-compose.yml up</span>

<span class="text-ops-muted"># Open http://localhost:8000 and sign in with the admin from your .env</span></code></pre>
      </div>

      <p class="mt-6 text-sm text-ops-muted">
        Production mode requires a real JWT secret and real bootstrap credentials. Weak defaults are refused at startup.
        Prefer a binary? Linux and Windows builds are on the
        <a href={RELEASES_URL} target="_blank" rel="noopener noreferrer" class="text-slate-300 underline underline-offset-4 decoration-ops-border hover:decoration-slate-400 focus-ring">releases page</a>.
      </p>
    </div>
  </section>

  <footer class="border-t border-ops-border">
    <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-6 px-5 py-10 sm:flex-row sm:items-center sm:px-8">
      <div>
        <span class="text-[15px] font-semibold tracking-tight text-slate-200">Ops<span class="text-ops-blue">Mender</span></span>
        <p class="mt-1 text-sm text-ops-muted">Incident response you run yourself.</p>
      </div>
      <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-ops-subtle">
        <a href={GITHUB_URL}    target="_blank" rel="noopener noreferrer" class="hover:text-slate-200 focus-ring">GitHub</a>
        <a href={DOCS_URL}      target="_blank" rel="noopener noreferrer" class="hover:text-slate-200 focus-ring">Docs</a>
        <a href={CHANGELOG_URL} target="_blank" rel="noopener noreferrer" class="hover:text-slate-200 focus-ring">Changelog</a>
        <a href={RELEASES_URL}  target="_blank" rel="noopener noreferrer" class="hover:text-slate-200 focus-ring">Releases</a>
        <a href={`${GITHUB_URL}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer" class="hover:text-slate-200 focus-ring">License</a>
      </nav>
    </div>
  </footer>
</Layout>
