        <div id="arch-list" class="rise grid gap-2 sm:hidden" style="--i:1" role="list" aria-label="OpsMender components"></div>
        <div id="legend" class="mt-4 hidden flex-wrap gap-x-5 gap-y-2 text-xs text-ops-subtle sm:flex" aria-label="Component families"></div>
        <aside id="dossier" class="dossier fixed inset-x-0 bottom-0 z-40 max-h-[80vh] overflow-y-auto border-t border-ops-border bg-ops-surface shadow-2xl lg:bottom-0 lg:left-auto lg:right-0 lg:top-0 lg:max-h-none lg:w-[400px] lg:border-l lg:border-t-0" aria-live="polite" aria-label="Component details" hidden>
          <div class="sticky top-0 flex items-center justify-between border-b border-ops-border bg-ops-surface px-6 py-4">
            <span id="d-kind" class="font-mono text-[11px] uppercase tracking-[0.18em] text-ops-blue"></span>
            <button id="d-close" class="rounded p-1 text-ops-subtle hover:text-white focus-ring" aria-label="Close">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M6 18 18 6M6 6l12 12"/></svg>
            </button>
